<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows10.0.19041.0;net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('windows'))">net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>musicmate</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Display name -->
    <ApplicationTitle>Music Mate</ApplicationTitle>

    <!-- App Identifier -->
    <ApplicationId>com.bkdaniels.musicmate</ApplicationId>

    <!-- Versions -->
    <ApplicationDisplayVersion>1.13</ApplicationDisplayVersion>
    <ApplicationVersion>13</ApplicationVersion>
    <PackageVersion>1.13</PackageVersion>

    <WindowsPackageType>None</WindowsPackageType>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- Import signing passwords from signing.props (excluded from source control) -->
  <Import Project="signing.props" Condition="Exists('signing.props')" />

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-android' and '$(Configuration)' == 'Release'">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>musicmate.keystore</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>musicmatekey</AndroidSigningKeyAlias>
    <AndroidPackageFormat>aab</AndroidPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <AndroidEnable16kBpages>true</AndroidEnable16kBpages>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug' and '$(TargetFramework)' == 'net10.0-android'">
    <AndroidIncludeDebugSymbols>true</AndroidIncludeDebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidLinkMode>SdkOnly</AndroidLinkMode>
  </PropertyGroup>

  <PropertyGroup>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <LinkDescription Include="Platforms\Android\Linker.xml" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.png" />
    <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#8CFA64" BaseSize="128,128" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources\Fonts\Bravura.otf" LogicalName="musicmate.Bravura.otf" />
  </ItemGroup>

  <ItemGroup>
    <MauiAsset Remove="Resources\Raw\about001.html" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\Raw\about001.html" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anjoxam.BillingClient.Droid" Version="7.1.1" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" />
    <PackageReference Include="CommunityToolkit.Maui" Version="14.1.0" />
    <PackageReference Include="CommunityToolkit.Maui.Core" Version="14.1.0" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.51" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.5" />
    <PackageReference Include="Microsoft.Maui.Essentials" Version="10.0.51" />
    <PackageReference Include="Microsoft.Maui.Graphics.Skia" Version="10.0.51" />
    <PackageReference Include="Microsoft.Maui.Resizetizer" Version="10.0.51" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="nor0x.Maui.ColorPicker" Version="2.0.4" />
    <PackageReference Include="Plugin.Maui.Audio" Version="4.0.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="SkiaSharp.Views" Version="3.119.2" />
    <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="3.119.2" />
    <PackageReference Include="sqlite-net-base" Version="1.10.196-beta" />
    <PackageReference Include="SQLitePCLRaw.config.e_sqlite3" Version="3.0.3" />
    <PackageReference Include="SourceGear.sqlite3" Version="3.50.4.5" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Data\" />
    <Folder Include="Resources\raw\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="musicmate.Tests\**" />
    <Content Remove="musicmate.Tests\**" />
    <EmbeddedResource Remove="musicmate.Tests\**" />
    <MauiXaml Remove="musicmate.Tests\**" />
    <None Remove="musicmate.Tests\**" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="Pages\DebugItemsPage.xaml.cs" />
    <Compile Remove="ViewModels\DebugItemsPageViewModel.cs" />
    <MauiXaml Remove="Pages\DebugItemsPage.xaml" />
  </ItemGroup>

  <ItemGroup>
    <MauiImage Include="Resources\Images\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".github\copilot-instructions.md" />
  </ItemGroup>

    <ItemGroup>
    <MauiXaml Update="Pages\AboutPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Pages\HomePage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Pages\MusicPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Pages\SettingsPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Pages\WhatToPlayPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
  </ItemGroup>

</Project>