<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">net10.0-windows10.0.19041.0;net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('windows'))">net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>musicmate</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Compile bindings that set Source (x:Reference / x:Static) for better runtime perf. -->
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
    <!-- SDK only excludes the project-root obj/bin; ignore nested leftovers (e.g. Views/obj). -->
    <!--<DefaultItemExcludes>$(DefaultItemExcludes);**\bin\**;**\obj\**</DefaultItemExcludes> ChatGPT told me to take this out-->

    <!-- Display name / id: Release = Play Closed Testing; Debug / LocalRelease are side-by-side. -->
    <ApplicationTitle>Music Mate</ApplicationTitle>
    <ApplicationId>com.bkdaniels.musicmate</ApplicationId>
    <Configurations>Debug;Release;LocalRelease</Configurations>

    <!-- Versions -->
    <ApplicationDisplayVersion>1.27</ApplicationDisplayVersion>
    <ApplicationVersion>27</ApplicationVersion>
    <PackageVersion>1.27</PackageVersion>

    <WindowsPackageType>None</WindowsPackageType>
    <AllowUnsafeBlocks Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">true</AllowUnsafeBlocks>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">android-arm;android-arm64;android-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- Import signing passwords from signing.props (excluded from source control) -->
  <Import Project="signing.props" Condition="Exists('signing.props')" />

  <!-- Optimized Android packaging shared by Play Release and local LocalRelease. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-android' and ('$(Configuration)' == 'Release' or '$(Configuration)' == 'LocalRelease')">
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>musicmate.keystore</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>musicmatekey</AndroidSigningKeyAlias>
    <!-- Required for Archive / device install: disable Fast Deployment & shared runtime. -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
    <AndroidLinkMode>SdkOnly</AndroidLinkMode>
    <AndroidLinkTool>r8</AndroidLinkTool>
    <DebugSymbols>false</DebugSymbols>
    <AndroidIncludeDebugSymbols>false</AndroidIncludeDebugSymbols>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- Play / Closed Testing Release: build an AAB for Play Console (Archive / publish).
       Visual Studio device deploy of an AAB (split APKs) often fails with
       XAAADB0000 DELETE_FAILED_INTERNAL_ERROR — use LocalRelease (APK, .local id) for
       on-device testing, or one-off: -p:AndroidPackageFormat=apk
       Store publish: Archive in VS, or .\scripts\publish-play-aab.ps1 -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-android' and '$(Configuration)' == 'Release'">
    <AndroidPackageFormat>aab</AndroidPackageFormat>
  </PropertyGroup>

  <!-- LocalRelease: Release-like build that installs beside Closed Testing (separate app data). -->
  <PropertyGroup Condition="'$(Configuration)' == 'LocalRelease'">
    <ApplicationTitle>Music Mate Local</ApplicationTitle>
    <ApplicationId>com.bkdaniels.musicmate.local</ApplicationId>
    <DebugType>none</DebugType>
    <!-- Local stub billing (not Play); see MauiProgram IStoreService registration. -->
    <DefineConstants>$(DefineConstants);LOCAL_RELEASE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-android' and '$(Configuration)' == 'LocalRelease'">
    <AndroidPackageFormat>apk</AndroidPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <AndroidEnable16kBpages>true</AndroidEnable16kBpages>
  </PropertyGroup>

  <!-- Debug: distinct app id/title so DEV can install beside Release; keep symbols. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <ApplicationTitle>Music Mate DEV</ApplicationTitle>
    <ApplicationId>com.bkdaniels.musicmate.dev</ApplicationId>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug' and '$(TargetFramework)' == 'net10.0-android'">
    <AndroidIncludeDebugSymbols>true</AndroidIncludeDebugSymbols>
    <!-- Embed assemblies so MonoVsDbg can attach reliably (Fast Deployment sync often fails). -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
    <!--<AndroidWaitForDebugger>true</AndroidWaitForDebugger>-->
  </PropertyGroup>
  <!--After the app works remove <AndroidWaitForDebugger>true</AndroidWaitForDebugger>-->
  

  <PropertyGroup>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <LinkDescription Include="Platforms\Android\Linker.xml" />
    <ProguardConfiguration Include="Platforms\Android\proguard.cfg" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.png" />
    <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#8CFA64" BaseSize="128,128" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources\Fonts\Bravura.otf" LogicalName="musicmate.Bravura.otf" />
  </ItemGroup>

  <ItemGroup>
    <MauiAsset Remove="Resources\Raw\about001.html" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\Raw\about001.html" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Xamarin.Android.Google.BillingClient" Version="8.0.0" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'" />
    <PackageReference Include="CommunityToolkit.Maui" Version="14.1.0" />
    <PackageReference Include="CommunityToolkit.Maui.Core" Version="14.1.0" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.51" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.5" />
    <PackageReference Include="Microsoft.Maui.Essentials" Version="10.0.51" />
    <PackageReference Include="Microsoft.Maui.Graphics.Skia" Version="10.0.51" />
    <PackageReference Include="Microsoft.Maui.Resizetizer" Version="10.0.51" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="nor0x.Maui.ColorPicker" Version="2.0.4" />
    <PackageReference Include="Plugin.Maui.Audio" Version="4.0.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.2" />
    <PackageReference Include="SkiaSharp.Views" Version="3.119.2" />
    <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="3.119.2" />
    <PackageReference Include="sqlite-net-base" Version="1.10.196-beta" />
    <PackageReference Include="SQLitePCLRaw.config.e_sqlite3" Version="3.0.3" />
    <PackageReference Include="SourceGear.sqlite3" Version="3.50.4.5" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Data\" />
    <Folder Include="Resources\Raw\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="musicmate.Tests\**" />
    <Content Remove="musicmate.Tests\**" />
    <EmbeddedResource Remove="musicmate.Tests\**" />
    <MauiXaml Remove="musicmate.Tests\**" />
    <None Remove="musicmate.Tests\**" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="Pages\DebugItemsPage.xaml.cs" />
    <Compile Remove="ViewModels\DebugItemsPageViewModel.cs" />
    <MauiXaml Remove="Pages\DebugItemsPage.xaml" />
  </ItemGroup>

  <ItemGroup>
    <MauiImage Include="Resources\Images\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <None Include=".github\copilot-instructions.md" />
  </ItemGroup>

    <ItemGroup>
    <MauiXaml Update="Pages\AboutPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Pages\HomePage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Pages\MusicPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Pages\SettingsPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Pages\WhatToPlayPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
  </ItemGroup>

  <!-- Inject git commit + UTC build timestamp into BuildIdentificationMetadata.g.cs -->
  <Target Name="GenerateBuildIdentification" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_BuildMetaPath>$(MSBuildProjectDirectory)\Diagnostics\BuildIdentificationMetadata.g.cs</_BuildMetaPath>
    </PropertyGroup>
    <Exec Command="git -C &quot;$(MSBuildProjectDirectory)&quot; rev-parse --short HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitCommitRaw" />
    </Exec>
    <PropertyGroup>
      <_GitCommit>$([System.String]::Copy('$(_GitCommitRaw)').Trim())</_GitCommit>
      <_GitCommit Condition="'$(_GitCommit)' == ''">unknown</_GitCommit>
      <_BuildUtc>$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd HH:mm:ss')) UTC</_BuildUtc>
    </PropertyGroup>
    <ItemGroup>
      <_BuildMetaLine Include="// Auto-generated at build — do not edit manually." />
      <_BuildMetaLine Include="namespace musicmate.Diagnostics%3B" />
      <_BuildMetaLine Include="internal static class BuildIdentificationMetadata" />
      <_BuildMetaLine Include="{" />
      <_BuildMetaLine Include="    internal const string GitCommit = &quot;$(_GitCommit)&quot;%3B" />
      <_BuildMetaLine Include="    internal const string BuildTimestampUtc = &quot;$(_BuildUtc)&quot;%3B" />
      <_BuildMetaLine Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(_BuildMetaPath)" Lines="@(_BuildMetaLine)" Overwrite="true" />
  </Target>

</Project>