<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:musicmate.Services"
             xmlns:controls="clr-namespace:musicmate.Controls"
             xmlns:pages="clr-namespace:musicmate.Pages"
             x:Class="musicmate.Pages.MusicPage"
             x:DataType="services:NoteSessionService"
             x:Name="musicPage"
             Shell.NavBarIsVisible="True"
             Padding="0"
             BackgroundColor="#F7F7F7">

  <Shell.TitleView>
    <Grid x:Name="TitleMarqueeGrid"
          ColumnDefinitions="Auto,Auto,Auto,*,Auto" HeightRequest="52" VerticalOptions="Fill"
          BackgroundColor="Transparent">
      <Button Grid.Column="0"
              Text="←"
              Clicked="OnNavigateWhatToPlayClicked"
              BackgroundColor="{DynamicResource ThemeButtonBackground}"
              TextColor="{DynamicResource ThemeContrastingText}"
              FontSize="18"
              Padding="12,0"
              WidthRequest="56"
              HeightRequest="40"
              MinimumHeightRequest="40"
              MinimumWidthRequest="56"
              CornerRadius="8"
              BorderWidth="0"
              BorderColor="Transparent"
              VerticalOptions="Center"
              Margin="0,0,10,0" />
      <Grid Grid.Column="1"
            x:Name="TitleStartStopSlot"
            WidthRequest="64"
            HeightRequest="52"
            VerticalOptions="Center">
        <Grid.GestureRecognizers>
          <TapGestureRecognizer Tapped="OnStartStopToggleClicked" />
        </Grid.GestureRecognizers>
        <Border x:Name="TitleStartStopButton"
                StrokeThickness="0"
                BackgroundColor="#008000"
                HorizontalOptions="Center"
                VerticalOptions="Center">
          <Border.StrokeShape>
            <RoundRectangle CornerRadius="16" />
          </Border.StrokeShape>
        </Border>
      </Grid>
      <Label x:Name="TitlePageModeLabel"
             Text="  Music "
             TextColor="{DynamicResource ThemeContrastingText}"
             FontAttributes="Bold"
             FontSize="18"
             VerticalOptions="Center"
             HorizontalOptions="Start"
             Grid.Column="2" />
      <Label x:Name="StatusLabelShell"
             Text="{Binding Source={x:Static services:StatusService.Instance}, Path=StatusMessage, x:DataType=services:StatusService}"
             TextColor="Black"
             FontAttributes="Bold"
             FontSize="10"
             VerticalOptions="Center"
             HorizontalOptions="Start"
             Grid.Column="3"/>
      <Border Style="{StaticResource TitleLogoBorder}"
              VerticalOptions="Center"
              HorizontalOptions="End"
              Grid.Column="4">
        <Image Source="logo.png" Aspect="AspectFill" />
      </Border>
    </Grid>
  </Shell.TitleView>

  <ContentPage.Resources>
    <Style x:Key="CompactBrownBox" TargetType="Border">
      <Setter Property="Background" Value="#8B4513" />
      <Setter Property="Stroke" Value="Black" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="StrokeShape">
        <Setter.Value>
          <RoundRectangle CornerRadius="8" />
        </Setter.Value>
      </Setter>
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="HeightRequest" Value="28" />
      <Setter Property="VerticalOptions" Value="Center" />
      <Setter Property="HorizontalOptions" Value="Center" />
    </Style>
    <Style x:Key="CompactBrownBoxFill" TargetType="Border" BasedOn="{StaticResource CompactBrownBox}">
      <Setter Property="HorizontalOptions" Value="Fill" />
      <Setter Property="Padding" Value="4,2" />
    </Style>
    <Style x:Key="PracticeBottomPicker" TargetType="Picker">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="TextColor" Value="#000000" />
      <Setter Property="BackgroundColor" Value="Transparent" />
      <Setter Property="VerticalOptions" Value="Fill" />
      <Setter Property="HorizontalOptions" Value="Fill" />
      <Setter Property="HeightRequest" Value="28" />
    </Style>
    <Style x:Key="CompactBrownButton" TargetType="Button">
      <Setter Property="BackgroundColor" Value="{DynamicResource ThemeButtonBackground}" />
      <Setter Property="TextColor" Value="{DynamicResource ThemeButtonText}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HeightRequest" Value="44" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="BorderColor" Value="Black" />
      <Setter Property="BorderWidth" Value="2" />
      <Setter Property="VerticalOptions" Value="Center" />
      <Setter Property="HorizontalOptions" Value="Center" />
    </Style>
    <!-- Tuner chrome: shared radius/height/padding; no borders. Fonts set per control. -->
    <x:Double x:Key="TunerControlHeight">36</x:Double>
    <x:Double x:Key="TunerActionRowHeight">40</x:Double>
    <x:Double x:Key="TunerControlCornerRadius">8</x:Double>
    <x:Double x:Key="TunerControlSpacing">6</x:Double>
    <x:Double x:Key="TunerVerticalSpacing">2</x:Double>
    <Style x:Key="TunerControlButton" TargetType="Button">
      <Setter Property="BackgroundColor" Value="{DynamicResource ThemeButtonBackground}" />
      <Setter Property="TextColor" Value="{DynamicResource ThemeContrastingText}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderWidth" Value="0" />
      <Setter Property="BorderColor" Value="Transparent" />
      <Setter Property="HeightRequest" Value="36" />
      <Setter Property="MinimumHeightRequest" Value="36" />
      <Setter Property="MinimumWidthRequest" Value="36" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="VerticalOptions" Value="Center" />
      <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>
    <Style x:Key="TunerPickerChrome" TargetType="Border">
      <Setter Property="BackgroundColor" Value="{DynamicResource ThemeButtonBackground}" />
      <Setter Property="Stroke" Value="Transparent" />
      <Setter Property="StrokeThickness" Value="0" />
      <Setter Property="StrokeShape">
        <Setter.Value>
          <RoundRectangle CornerRadius="8" />
        </Setter.Value>
      </Setter>
      <Setter Property="HeightRequest" Value="36" />
      <Setter Property="MinimumHeightRequest" Value="36" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="VerticalOptions" Value="Center" />
      <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>
  </ContentPage.Resources>

  <Grid x:Name="MainPageRootGrid">
    <ScrollView x:Name="MainScrollView" HorizontalScrollBarVisibility="Never"
                Padding="0,0,0,0" Margin="0" HorizontalOptions="Fill">
      <VerticalStackLayout x:Name="MainPageMainLayout" Spacing="16" Padding="0,0,0,0" Margin="0,0,0,0" HorizontalOptions="Fill">

        <!-- Pickers row: Instrument | Key | (Concert E) | Scale+Tune picker -->
        <VerticalStackLayout x:Name="PickersContainer" Padding="0">
          <VerticalStackLayout.Margin>
            <OnPlatform x:TypeArguments="Thickness">
              <On Platform="WinUI"   Value="0,20,0,0" />
              <On Platform="Android" Value="0,0,0,0" />
            </OnPlatform>
          </VerticalStackLayout.Margin>
          <Grid ColumnDefinitions="Auto,190,Auto,40,Auto,*"
                ColumnSpacing="6"
                VerticalOptions="Center"
                Margin="0,4,0,4"
                HorizontalOptions="Fill">

            <!-- Instrument -->
            <Label Grid.Column="0"
                   Text="Instrument"
                   FontSize="11"
                   TextColor="#333333"
                   Margin="8,0,0,0"
                   VerticalOptions="Center" />
            <Border Grid.Column="1" Style="{StaticResource CompactBrownBox}">
              <Grid WidthRequest="160">
                <Picker x:Name="InstrumentPicker"
                        SelectedIndexChanged="InstrumentPicker_SelectedIndexChanged"
                        Unfocused="InstrumentPicker_Unfocused"
                        HeightRequest="28"
                        FontSize="11"
                        TextColor="White"
                        BackgroundColor="#2C2C2C"
                        VerticalOptions="Fill"
                        HorizontalOptions="Fill"
                        IsEnabled="True"
                        InputTransparent="False"
                        IsVisible="{Binding Source={x:Reference musicPage}, Path=IsInstrumentPickerVisible, x:DataType=pages:MusicPage}" />
                <Border BackgroundColor="White" Stroke="#8B4513" StrokeThickness="2"
                        StrokeShape="RoundRectangle 8"
                        Padding="8,2" HeightRequest="28"
                        VerticalOptions="Center" HorizontalOptions="Fill"
                        IsVisible="{Binding Source={x:Reference musicPage}, Path=IsInstrumentLabelVisible, x:DataType=pages:MusicPage}">
                  <Label x:Name="InstrumentPickerOverlay"
                         Text="{Binding SelectedInstrumentShort, Source={x:Reference musicPage}, x:DataType=pages:MusicPage}"
                         VerticalOptions="Center"
                         HorizontalOptions="Fill"
                         Padding="10,0"
                         FontSize="11"
                         TextColor="Black">
                    <Label.GestureRecognizers>
                      <TapGestureRecognizer Tapped="OnInstrumentLabelTapped" />
                    </Label.GestureRecognizers>
                  </Label>
                </Border>
              </Grid>
            </Border>

            <!-- Key (hidden in Tuner mode) -->
            <Label x:Name="KeyLabel"
                   Grid.Column="2"
                   Text="Key"
                   FontSize="11"
                   TextColor="#333333"
                   VerticalOptions="Center" />
            <Border x:Name="KeyBorder" Grid.Column="3" Style="{StaticResource CompactBrownBox}">
              <Picker x:Name="KeyPicker"
                      HeightRequest="28"
                      FontSize="11"
                      TextColor="#000000"
                      BackgroundColor="White"
                      VerticalOptions="Fill"
                      HorizontalOptions="Fill" />
            </Border>

            <!-- Concert key e.g. "(Concert E)" (hidden in Tuner mode) -->
            <Label x:Name="ConcertKeyLabel"
                   Grid.Column="4"
                   FontSize="11"
                   TextColor="#333333"
                   VerticalOptions="Center" />

            <!-- Combined Scale / Tune picker -->
            <Border Grid.Column="5"
                    Style="{StaticResource CompactBrownBox}"
                    HorizontalOptions="Fill"
                    Margin="0,0,8,0">
              <Picker x:Name="ScaleTunePicker"
                      HeightRequest="28"
                      FontSize="11"
                      TextColor="#000000"
                      BackgroundColor="White"
                      VerticalOptions="Fill"
                      HorizontalOptions="Fill" />
            </Border>

          </Grid>

          <Label x:Name="EffectiveScaleLabel"
                 Text="{Binding Source={x:Reference musicPage}, Path=EffectiveScaleLabelText, x:DataType=pages:MusicPage}"
                 IsVisible="{Binding Source={x:Reference musicPage}, Path=IsEffectiveScaleLabelVisible, x:DataType=pages:MusicPage}"
                 FontSize="13"
                 FontAttributes="Bold"
                 TextColor="#8B4513"
                 Margin="8,2,8,0"
                 HorizontalOptions="Start" />

          <Grid x:Name="NoteEmphasisBanner"
                IsVisible="False"
                ColumnDefinitions="*,Auto"
                Margin="8,2,8,0"
                ColumnSpacing="8">
            <Label Grid.Column="0"
                   x:Name="NoteEmphasisLabel"
                   FontSize="13"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource ThemeHeadingText}"
                   VerticalOptions="Center"
                   LineBreakMode="WordWrap" />
            <Button Grid.Column="1"
                    Text="Clear emphasis"
                    Clicked="OnClearNoteEmphasisClicked"
                    FontSize="11"
                    Padding="10,4"
                    VerticalOptions="Center" />
          </Grid>

          </VerticalStackLayout>

          <!-- Session result banner: shown after a session completes, hidden while playing -->
          <Border x:Name="SessionResultBanner"
                  IsVisible="False"
                  BackgroundColor="#1A5C1A"
                  Stroke="#2E8B2E"
                  StrokeShape="RoundRectangle 8"
                  StrokeThickness="1"
                  Padding="10,6"
                  Margin="8,0,8,4">
            <Label x:Name="SessionResultLabel"
                   Text=""
                   FontSize="15"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />
          </Border>

          <!-- Staff area: practice staff or Tuner panels -->
        <VerticalStackLayout x:Name="StaffAreaStack" Spacing="0" HorizontalOptions="Fill" VerticalOptions="Fill">
          <Grid HorizontalOptions="Fill"
                VerticalOptions="Fill">
              <Border x:Name="StaffBorder"
                      Stroke="MediumPurple"
                      StrokeThickness="2"
                      StrokeShape="RoundRectangle 8"
                      BackgroundColor="{Binding PanelBackgroundColor}"
                      Padding="0"
                      IsVisible="True"
                      HorizontalOptions="Fill"
                      VerticalOptions="Start">
                <GraphicsView x:Name="StaffGraphicsView"
                              HeightRequest="240"
                              BackgroundColor="{Binding PanelBackgroundColor}"
                              HorizontalOptions="Fill"
                              Margin="0" />
              </Border>

              <!-- Tuner mode: equal-width staff | controls; sized short enough that both borders stay on-screen -->
              <Grid x:Name="TunerGrid"
                    ColumnDefinitions="*,*"
                    ColumnSpacing="8"
                    IsVisible="False"
                    Margin="0"
                    Padding="0"
                    VerticalOptions="Start"
                    HorizontalOptions="Fill">
                <Border x:Name="TunerBorder"
                        Grid.Column="0"
                        Stroke="Green"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="{Binding PanelBackgroundColor}"
                        Padding="2"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill">
                  <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTunerStaffTapped" />
                  </Border.GestureRecognizers>
                  <GraphicsView x:Name="TunerGraphicsView"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill"
                                InputTransparent="True"
                                SemanticProperties.Description="Selected reference note staff. Tap to play the tone." />
                </Border>
                <Border x:Name="TunerInfoBorder"
                        Grid.Column="1"
                        Stroke="Green"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 8"
                        Padding="4,2"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill">
                  <VerticalStackLayout x:Name="TunerReferenceControls"
                                       Spacing="{StaticResource TunerVerticalSpacing}"
                                       HorizontalOptions="Fill"
                                       VerticalOptions="Start"
                                       Padding="0,0,0,6">
                    <Label x:Name="TunerModeStatusLabel"
                           Text="Metronome"
                           FontSize="16"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Start"
                           Margin="0,0,0,0"
                           TextColor="#000000"
                           IsVisible="True" />

                    <!-- Note chooser: ◀  WrittenPicker  ▶ -->
                    <VerticalStackLayout Spacing="{StaticResource TunerVerticalSpacing}"
                                         HorizontalOptions="Fill"
                                         Margin="0,0,0,0">
                      <Label x:Name="TunerNoteChooserHint"
                             Text="Note to play – tap list or use ◀ ▶"
                             FontSize="10"
                             HorizontalOptions="Fill"
                             HorizontalTextAlignment="Center"
                             LineBreakMode="NoWrap"
                             MaxLines="1"
                             TextColor="#444444"
                             Margin="0" />
                      <Grid ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="{StaticResource TunerControlSpacing}"
                            HeightRequest="{StaticResource TunerControlHeight}"
                            HorizontalOptions="Fill">
                        <Button x:Name="TunerLowerNoteButton"
                                Grid.Column="0"
                                Style="{StaticResource TunerControlButton}"
                                Text="◀"
                                FontSize="14"
                                FontAttributes="Bold"
                                WidthRequest="36"
                                Padding="0"
                                Clicked="OnTunerLowerNoteClicked"
                                SemanticProperties.Description="Lower the note to play by one semitone" />
                        <Border x:Name="TunerNoteChooserChip"
                                Grid.Column="1"
                                Style="{StaticResource TunerPickerChrome}">
                          <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTunerNoteChooserTapped" />
                          </Border.GestureRecognizers>
                          <Grid ColumnDefinitions="*,Auto" InputTransparent="True">
                            <Label x:Name="TunerReferenceNoteDisplayLabel"
                                   Grid.Column="0"
                                   Text="Written —"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#000000"
                                   VerticalOptions="Fill"
                                   HorizontalOptions="Fill"
                                   VerticalTextAlignment="Center"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1" />
                            <Label x:Name="TunerNoteChooserChevron"
                                   Grid.Column="1"
                                   Text="▾"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   TextColor="#8B4513"
                                   VerticalOptions="Center"
                                   Margin="4,0,0,0"
                                   SemanticProperties.Description="Opens the note list" />
                          </Grid>
                        </Border>
                        <Button x:Name="TunerHigherNoteButton"
                                Grid.Column="2"
                                Style="{StaticResource TunerControlButton}"
                                Text="▶"
                                FontSize="14"
                                FontAttributes="Bold"
                                WidthRequest="36"
                                Padding="0"
                                Clicked="OnTunerHigherNoteClicked"
                                SemanticProperties.Description="Raise the note to play by one semitone" />
                      </Grid>
                      <!-- Code-built rows with StyleId=midi (CollectionView BindingContext is unreliable on WinUI). -->
                      <Border x:Name="TunerNoteListBorder"
                              IsVisible="False"
                              Style="{StaticResource TunerPickerChrome}"
                              BackgroundColor="White"
                              Padding="0"
                              HeightRequest="288"
                              MinimumHeightRequest="72"
                              HorizontalOptions="Fill">
                        <ScrollView x:Name="TunerNoteListScroll"
                                    VerticalOptions="Fill"
                                    HorizontalOptions="Fill">
                          <VerticalStackLayout x:Name="TunerNoteListStack"
                                               Spacing="0"
                                               Padding="0" />
                        </ScrollView>
                      </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="{StaticResource TunerVerticalSpacing}"
                                         HorizontalOptions="Fill"
                                         Margin="0">
                      <Grid ColumnDefinitions="*,*"
                            ColumnSpacing="{StaticResource TunerControlSpacing}"
                            HorizontalOptions="Fill"
                            Margin="0">
                        <Label Grid.Column="0"
                               Text="{Binding TunerLastDetectedFreq, StringFormat='Heard: {0:F1} Hz'}"
                               FontSize="10"
                               HorizontalOptions="Start"
                               HorizontalTextAlignment="Start"
                               LineBreakMode="TailTruncation"
                               MaxLines="1"
                               TextColor="#000000" />
                        <Label Grid.Column="1"
                               Text="{Binding TunerLastNearestFreq, StringFormat='Nearest: {0:F1} Hz'}"
                               FontSize="10"
                               HorizontalOptions="End"
                               HorizontalTextAlignment="End"
                               LineBreakMode="TailTruncation"
                               MaxLines="1"
                               TextColor="#000000" />
                      </Grid>
                      <!-- Tempo | Start | From Settings — taller row so picker text is not clipped -->
                      <Grid ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="{StaticResource TunerControlSpacing}"
                            HeightRequest="{StaticResource TunerActionRowHeight}"
                            MinimumHeightRequest="{StaticResource TunerActionRowHeight}"
                            HorizontalOptions="Fill">
                        <Border Grid.Column="0"
                                Style="{StaticResource TunerPickerChrome}"
                                HeightRequest="{StaticResource TunerActionRowHeight}"
                                MinimumHeightRequest="{StaticResource TunerActionRowHeight}"
                                WidthRequest="56"
                                Padding="4,0"
                                HorizontalOptions="Start">
                          <Picker x:Name="TunerTempoPicker"
                                  Title="BPM"
                                  FontSize="12"
                                  FontAttributes="Bold"
                                  VerticalOptions="Center"
                                  HorizontalOptions="Fill"
                                  HeightRequest="{StaticResource TunerActionRowHeight}"
                                  MinimumHeightRequest="{StaticResource TunerActionRowHeight}"
                                  BackgroundColor="Transparent"
                                  TextColor="{DynamicResource ThemeContrastingText}"
                                  SelectedIndexChanged="OnTunerTempoPickerChanged"
                                  SemanticProperties.Description="Tempo for repeated reference note playback" />
                        </Border>
                        <Button x:Name="TunerPlayNoteButton"
                                Grid.Column="1"
                                Style="{StaticResource TunerControlButton}"
                                HeightRequest="{StaticResource TunerActionRowHeight}"
                                MinimumHeightRequest="{StaticResource TunerActionRowHeight}"
                                Text="Start"
                                FontSize="12"
                                FontAttributes="Bold"
                                Clicked="OnTunerPlayNoteClicked"
                                SemanticProperties.Description="Start or stop repeated reference note playback" />
                        <Button x:Name="TunerUseSettingsTempoButton"
                                Grid.Column="2"
                                Style="{StaticResource TunerControlButton}"
                                HeightRequest="{StaticResource TunerActionRowHeight}"
                                MinimumHeightRequest="{StaticResource TunerActionRowHeight}"
                                Text="From Settings"
                                FontSize="10"
                                FontAttributes="Bold"
                                WidthRequest="150"
                                HorizontalOptions="End"
                                Clicked="OnTunerUseSettingsTempoClicked"
                                SemanticProperties.Description="Copy tempo from Settings into the Tuner tempo picker" />
                      </Grid>
                      <Grid Padding="0,14">
                        <Border Style="{StaticResource TunerPickerChrome}"
                              HeightRequest="{StaticResource TunerActionRowHeight}"
                              MinimumHeightRequest="{StaticResource TunerActionRowHeight}"
                              HorizontalOptions="Center"
                              WidthRequest="220"
                              Margin="0,0,0,4">
                        <Picker x:Name="TunerInstrumentPicker"
                                Title="Instrument"
                                FontSize="10"
                                FontAttributes="Bold"
                                HorizontalTextAlignment="Center"
                                VerticalOptions="Center"
                                HorizontalOptions="Fill"
                                HeightRequest="{StaticResource TunerActionRowHeight}"
                                MinimumHeightRequest="{StaticResource TunerActionRowHeight}"
                                BackgroundColor="Transparent"
                                TextColor="{DynamicResource ThemeContrastingText}"
                                SelectedIndexChanged="TunerInstrumentPicker_SelectedIndexChanged" />
                        </Border>
                      </Grid>
                    </VerticalStackLayout>
                  </VerticalStackLayout>
                </Border>
              </Grid>
          </Grid>
        </VerticalStackLayout>

          <!-- Child level step buttons (below staff, above bottom pickers/buttons) -->
          <Border x:Name="ChildLevelSliderRow"
                  Margin="12,4,12,0"
                  Padding="8,6"
                  BackgroundColor="#EDE8E0"
                  Stroke="#8B4513"
                  StrokeThickness="1"
                  StrokeShape="RoundRectangle 8"
                  HorizontalOptions="Fill"
                  IsVisible="{Binding Source={x:Reference musicPage}, Path=IsChildLevelSliderVisible, x:DataType=pages:MusicPage}">
            <Grid ColumnDefinitions="*,*,*,Auto,*,*,*"
                  ColumnSpacing="4"
                  HeightRequest="40"
                  VerticalOptions="Center"
                  HorizontalOptions="Fill">
              <Button Grid.Column="0"
                      Text="−10"
                      FontSize="12"
                      FontAttributes="Bold"
                      TextColor="{DynamicResource ThemeContrastingText}"
                      BackgroundColor="{DynamicResource ThemeButtonBackground}"                      
                      CornerRadius="12"
                      Padding="0"
                      HeightRequest="36"
                      VerticalOptions="Center"
                      HorizontalOptions="Fill"
                      CommandParameter="-10"
                      Clicked="OnChildLevelDeltaClicked" />
              <!--BackgroundColor="#8B4513"-->
              <Button Grid.Column="1"
                      Text="−5"
                      FontSize="12"
                      FontAttributes="Bold"
                      TextColor="{DynamicResource ThemeContrastingText}"
                      BackgroundColor="{DynamicResource ThemeButtonBackground}"
                      CornerRadius="12"
                      Padding="0"
                      HeightRequest="36"
                      VerticalOptions="Center"
                      HorizontalOptions="Fill"
                      CommandParameter="-5"
                      Clicked="OnChildLevelDeltaClicked" />
              <Button Grid.Column="2"
                      Text="−1"
                      FontSize="12"
                      FontAttributes="Bold"
                      TextColor="{DynamicResource ThemeContrastingText}"
                      BackgroundColor="{DynamicResource ThemeButtonBackground}"
                      CornerRadius="12"
                      Padding="0"
                      HeightRequest="36"
                      VerticalOptions="Center"
                      HorizontalOptions="Fill"
                      CommandParameter="-1"
                      Clicked="OnChildLevelDeltaClicked" />
              <HorizontalStackLayout Grid.Column="3"
                                     Spacing="4"
                                     Margin="6,0"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Center">
                <Label Text="Level"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="#1A1A1A"
                       VerticalOptions="Center" />
                <Label x:Name="ChildLevelSliderValueLabel"
                       Text="1"
                       FontSize="13"
                       FontAttributes="Bold"                       
                       BackgroundColor="{DynamicResource ThemeButtonBackground}"
                       TextColor="#1A1A1A"
                       VerticalOptions="Center"
                       MinimumWidthRequest="24"
                       HorizontalTextAlignment="Center" />
              </HorizontalStackLayout>
              <Button Grid.Column="4"
                      Text="+1"
                      FontSize="12"
                      FontAttributes="Bold"
                      TextColor="{DynamicResource ThemeContrastingText}"                       
                       BackgroundColor="{DynamicResource ThemeButtonBackground}"
                      CornerRadius="12"
                      Padding="0"
                      HeightRequest="36"
                      VerticalOptions="Center"
                      HorizontalOptions="Fill"
                      CommandParameter="1"
                      Clicked="OnChildLevelDeltaClicked" />
              <Button Grid.Column="5"
                      Text="+5"
                      FontSize="12"
                      FontAttributes="Bold"                       
                      BackgroundColor="{DynamicResource ThemeButtonBackground}"
                      TextColor="{DynamicResource ThemeContrastingText}"
                      CornerRadius="12"
                      Padding="0"
                      HeightRequest="36"
                      VerticalOptions="Center"
                      HorizontalOptions="Fill"
                      CommandParameter="5"
                      Clicked="OnChildLevelDeltaClicked" />
              <Button Grid.Column="6"
                      Text="+10"
                      FontSize="12"
                      FontAttributes="Bold"
                      TextColor="{DynamicResource ThemeContrastingText}"
                      BackgroundColor="{DynamicResource ThemeButtonBackground}"
                      CornerRadius="12"
                      Padding="0"
                      HeightRequest="36"
                      VerticalOptions="Center"
                      HorizontalOptions="Fill"
                      CommandParameter="10"
                      Clicked="OnChildLevelDeltaClicked" />
            </Grid>
          </Border>

          <!-- Save / delete user practice tunes -->
          <Grid x:Name="SavedTuneButtonRow"
                Margin="8,4,8,0"
                ColumnDefinitions="*,*"
                ColumnSpacing="8"
                HorizontalOptions="Fill"
                IsVisible="{Binding Source={x:Reference musicPage}, Path=IsBottomButtonRowVisible, x:DataType=pages:MusicPage}">
            <Button Grid.Column="0"
                    Text="Save Tune As"
                    Style="{StaticResource CompactBrownButton}"
                    HorizontalOptions="Fill"
                    Clicked="OnSaveTuneAsClicked" />
            <Button Grid.Column="1"
                    Text="Delete Saved Tune"
                    Style="{StaticResource CompactBrownButton}"
                    HorizontalOptions="Fill"
                    Clicked="OnDeleteSavedTuneClicked" />
          </Grid>

          <!-- Bottom row: practice pickers -->
          <Grid x:Name="BottomButtonRow"
                Margin="8,8,8,8"
                ColumnSpacing="0"
                HorizontalOptions="Fill"
                IsVisible="{Binding Source={x:Reference musicPage}, Path=IsBottomButtonRowVisible, x:DataType=pages:MusicPage}">

            <Grid x:Name="BottomPickersLayout"
                  ColumnDefinitions="Auto,180,Auto,55,Auto,*"
                  ColumnSpacing="4"
                  VerticalOptions="Center"
                  HorizontalOptions="Fill"
                  IsVisible="{Binding Source={x:Reference musicPage}, Path=IsBottomPickersVisible, x:DataType=pages:MusicPage}">
              <Label Grid.Column="0"
                     Text="Inst."
                     FontSize="10"
                     TextColor="#333333"
                     VerticalOptions="Center"
                     Margin="0,0,2,0"
                     LineBreakMode="TailTruncation"
                     MaxLines="1" />
              <Border Grid.Column="1" Style="{StaticResource CompactBrownBoxFill}">
                <Grid BackgroundColor="White">
                  <Picker x:Name="PracticeInstrumentPicker"
                          Style="{StaticResource PracticeBottomPicker}" />
                </Grid>
              </Border>
              <Label x:Name="PracticeKeyLabel"
                     Grid.Column="2"
                     Text="Key"
                     FontSize="10"
                     TextColor="#333333"
                     VerticalOptions="Center"
                     Margin="2,0,2,0" />
              <Border x:Name="PracticeKeyBorder" Grid.Column="3" Style="{StaticResource CompactBrownBoxFill}">
                <Grid BackgroundColor="White">
                  <Picker x:Name="PracticeKeyPicker"
                          Style="{StaticResource PracticeBottomPicker}" />
                </Grid>
              </Border>
              <Label x:Name="PracticeConcertKeyLabel"
                     Grid.Column="4"
                     FontSize="9"
                     TextColor="#333333"
                     VerticalOptions="Center"
                     Margin="2,0,4,0"
                     LineBreakMode="TailTruncation"
                     MaxLines="1"
                     MaximumWidthRequest="88" />
              <Border Grid.Column="5"
                      Style="{StaticResource CompactBrownBoxFill}"
                      HorizontalOptions="Fill">
                <Grid BackgroundColor="White">
                  <Label FontSize="10"
                         TextColor="#000000"
                         BackgroundColor="Transparent"
                         VerticalOptions="Center"
                         HorizontalOptions="Fill"
                         VerticalTextAlignment="Center"
                         LineBreakMode="TailTruncation"
                         MaxLines="1"
                         Padding="6,0"
                         Text="{Binding Source={x:Reference musicPage}, Path=PracticePlayItemLabelText, x:DataType=pages:MusicPage}" />
                </Grid>
              </Border>
            </Grid>

          </Grid>

      </VerticalStackLayout>
    </ScrollView>

    <!-- Play overlay under marquee start/stop; label content sized in code -->
    <Border x:Name="TitlePlayButton"
            BackgroundColor="#2E8B57"
            Stroke="#1F5C3A"
            StrokeThickness="1"
            Padding="0"
            HorizontalOptions="Start"
            VerticalOptions="Start"
            ZIndex="10"
            IsVisible="{Binding Source={x:Reference musicPage}, Path=IsTitlePlayButtonVisible, x:DataType=pages:MusicPage}">
      <Border.StrokeShape>
        <RoundRectangle CornerRadius="2" />
      </Border.StrokeShape>
      <Border.GestureRecognizers>
        <TapGestureRecognizer Tapped="OnPlayEvaluateClicked" />
      </Border.GestureRecognizers>
    </Border>

    <!-- Color picker dialog overlay (full-page, above everything) -->
    <controls:ColorPickerDialog x:Name="ColorPickerDialog"
                                IsVisible="False" />
  </Grid>
</ContentPage>
