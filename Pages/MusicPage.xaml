<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:musicmate.Services"
             xmlns:controls="clr-namespace:musicmate.Controls"
             x:Class="musicmate.Pages.MusicPage"
             x:DataType="services:NoteSessionService"
             x:Name="musicPage"
             Shell.NavBarIsVisible="True"
             Padding="0"
             BackgroundColor="#F7F7F7">

  <Shell.TitleView>
    <Grid x:Name="TitleMarqueeGrid"
          ColumnDefinitions="Auto,Auto,*,Auto" HeightRequest="32" VerticalOptions="Fill"
          BackgroundColor="#8B0000">
      <!-- 38dp slot preserves horizontal center for the play overlay below. -->
      <Grid Grid.Column="0"
            WidthRequest="38"
            HeightRequest="32"
            VerticalOptions="Center">
        <Border x:Name="TitleStartStopButton"
                StrokeThickness="0"
                BackgroundColor="#008000"
                HeightRequest="32"
                WidthRequest="32"
                HorizontalOptions="Center"
                VerticalOptions="Center">
          <Border.StrokeShape>
            <RoundRectangle CornerRadius="16" />
          </Border.StrokeShape>
          <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnStartStopToggleClicked" />
          </Border.GestureRecognizers>
        </Border>
      </Grid>
      <Label Text="  Music "
             TextColor="White"
             FontAttributes="Bold"
             FontSize="18"
             VerticalOptions="Center"
             HorizontalOptions="Start"
             Grid.Column="1" />
      <Label x:Name="StatusLabelShell"
             Text="{Binding Source={x:Static services:StatusService.Instance}, Path=StatusMessage}"
             TextColor="Yellow"
             FontAttributes="Bold"
             FontSize="10"
             VerticalOptions="Center"
             HorizontalOptions="Start"
             Grid.Column="2"/>
      <Border Style="{StaticResource TitleLogoBorder}"
              VerticalOptions="Center"
              HorizontalOptions="End"
              Grid.Column="3">
        <Image Source="logo.png" Aspect="AspectFill" />
      </Border>
    </Grid>
  </Shell.TitleView>

  <ContentPage.Resources>
    <Style x:Key="CompactBrownBox" TargetType="Border">
      <Setter Property="Background" Value="#8B4513" />
      <Setter Property="Stroke" Value="Black" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="StrokeShape">
        <Setter.Value>
          <RoundRectangle CornerRadius="8" />
        </Setter.Value>
      </Setter>
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="HeightRequest" Value="28" />
      <Setter Property="VerticalOptions" Value="Center" />
      <Setter Property="HorizontalOptions" Value="Center" />
    </Style>
    <Style x:Key="CompactBrownBoxFill" TargetType="Border" BasedOn="{StaticResource CompactBrownBox}">
      <Setter Property="HorizontalOptions" Value="Fill" />
      <Setter Property="Padding" Value="4,2" />
    </Style>
    <Style x:Key="PracticeBottomPicker" TargetType="Picker">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="TextColor" Value="#000000" />
      <Setter Property="BackgroundColor" Value="Transparent" />
      <Setter Property="VerticalOptions" Value="Fill" />
      <Setter Property="HorizontalOptions" Value="Fill" />
      <Setter Property="HeightRequest" Value="28" />
    </Style>
    <Style x:Key="CompactBrownButton" TargetType="Button">
      <Setter Property="BackgroundColor" Value="#8B4513" />
      <Setter Property="TextColor" Value="White" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HeightRequest" Value="44" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="BorderColor" Value="Black" />
      <Setter Property="BorderWidth" Value="2" />
      <Setter Property="VerticalOptions" Value="Center" />
      <Setter Property="HorizontalOptions" Value="Center" />
    </Style>
  </ContentPage.Resources>

  <Grid x:Name="MainPageRootGrid">
    <ScrollView x:Name="MainScrollView" HorizontalScrollBarVisibility="Never" Padding="0,0
                ,0,0
                
                " Margin="0" HorizontalOptions="Fill">
      <VerticalStackLayout x:Name="MainPageMainLayout" Spacing="16" Padding="0" Margin="0" HorizontalOptions="Fill">

        <!-- Pickers row: Instrument | Key | (Concert E) | Scale+Tune picker -->
        <VerticalStackLayout x:Name="PickersContainer" Padding="0">
          <VerticalStackLayout.Margin>
            <OnPlatform x:TypeArguments="Thickness">
              <On Platform="WinUI"   Value="0,20,0,0" />
              <On Platform="Android" Value="0,0,0,0" />
            </OnPlatform>
          </VerticalStackLayout.Margin>
          <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*"
                ColumnSpacing="6"
                VerticalOptions="Center"
                Margin="0,4,0,4"
                HorizontalOptions="Fill">

            <!-- Instrument -->
            <Label Grid.Column="0"
                   Text="Instrument"
                   FontSize="11"
                   TextColor="#333333"
                   Margin="8,0,0,0"
                   VerticalOptions="Center" />
            <Border Grid.Column="1" Style="{StaticResource CompactBrownBox}">
              <Grid WidthRequest="160">
                <Picker x:Name="InstrumentPicker"
                        SelectedIndexChanged="InstrumentPicker_SelectedIndexChanged"
                        Unfocused="InstrumentPicker_Unfocused"
                        HeightRequest="28"
                        FontSize="11"
                        TextColor="White"
                        BackgroundColor="#2C2C2C"
                        VerticalOptions="Fill"
                        HorizontalOptions="Fill"
                        IsEnabled="True"
                        InputTransparent="False"
                        IsVisible="{Binding Source={x:Reference musicPage}, Path=IsInstrumentPickerVisible}" />
                <Border BackgroundColor="White" Stroke="#8B4513" StrokeThickness="2"
                        StrokeShape="RoundRectangle 8"
                        Padding="8,2" HeightRequest="28"
                        VerticalOptions="Center" HorizontalOptions="Fill"
                        IsVisible="{Binding Source={x:Reference musicPage}, Path=IsInstrumentLabelVisible}">
                  <Label x:Name="InstrumentPickerOverlay"
                         Text="{Binding SelectedInstrumentShort, Source={x:Reference musicPage}}"
                         VerticalOptions="Center"
                         HorizontalOptions="Fill"
                         Padding="10,0"
                         FontSize="11"
                         TextColor="Black">
                    <Label.GestureRecognizers>
                      <TapGestureRecognizer Tapped="OnInstrumentLabelTapped" />
                    </Label.GestureRecognizers>
                  </Label>
                </Border>
              </Grid>
            </Border>

            <!-- Key (hidden in Tuner mode) -->
            <Label x:Name="KeyLabel"
                   Grid.Column="2"
                   Text="Key"
                   FontSize="11"
                   TextColor="#333333"
                   VerticalOptions="Center" />
            <Border x:Name="KeyBorder" Grid.Column="3" Style="{StaticResource CompactBrownBox}">
              <Picker x:Name="KeyPicker"
                      WidthRequest="50"
                      HeightRequest="28"
                      FontSize="11"
                      TextColor="#000000"
                      BackgroundColor="White"
                      VerticalOptions="Fill"
                      HorizontalOptions="Fill" />
            </Border>

            <!-- Concert key e.g. "(Concert E)" (hidden in Tuner mode) -->
            <Label x:Name="ConcertKeyLabel"
                   Grid.Column="4"
                   FontSize="11"
                   TextColor="#333333"
                   VerticalOptions="Center" />

            <!-- Combined Scale / Tune picker -->
            <Border Grid.Column="5"
                    Style="{StaticResource CompactBrownBox}"
                    HorizontalOptions="Fill"
                    Margin="0,0,8,0">
              <Picker x:Name="ScaleTunePicker"
                      HeightRequest="28"
                      FontSize="11"
                      TextColor="#000000"
                      BackgroundColor="White"
                      VerticalOptions="Fill"
                      HorizontalOptions="Fill" />
            </Border>

          </Grid>

          <Label x:Name="EffectiveScaleLabel"
                 Text="{Binding Source={x:Reference musicPage}, Path=EffectiveScaleLabelText}"
                 IsVisible="{Binding Source={x:Reference musicPage}, Path=IsEffectiveScaleLabelVisible}"
                 FontSize="13"
                 FontAttributes="Bold"
                 TextColor="#8B4513"
                 Margin="8,2,8,0"
                 HorizontalOptions="Start" />

          </VerticalStackLayout>

          <!-- Session result banner: shown after a session completes, hidden while playing -->
          <Border x:Name="SessionResultBanner"
                  IsVisible="False"
                  BackgroundColor="#1A5C1A"
                  Stroke="#2E8B2E"
                  StrokeShape="RoundRectangle 8"
                  StrokeThickness="1"
                  Padding="10,6"
                  Margin="8,0,8,4">
            <Label x:Name="SessionResultLabel"
                   Text=""
                   FontSize="15"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />
          </Border>

          <!-- Staff area: control buttons + staff/tuner panel + color button -->
        <VerticalStackLayout x:Name="StaffAreaStack" Spacing="0" HorizontalOptions="Fill" VerticalOptions="Fill">
          <Grid ColumnDefinitions="*" HorizontalOptions="Fill" VerticalOptions="Fill">

            <!-- Staff panel and Tuner panel fill the full column -->
            <Grid Grid.Column="0" VerticalOptions="Fill">
              <Border x:Name="StaffBorder"
                      Stroke="MediumPurple"
                      StrokeThickness="2"
                      StrokeShape="RoundRectangle 8"
                      BackgroundColor="{Binding PanelBackgroundColor}"
                      Padding="0"
                      IsVisible="True"
                      HorizontalOptions="Fill"
                      VerticalOptions="Start">
                <GraphicsView x:Name="StaffGraphicsView"
                              HeightRequest="240"
                              BackgroundColor="{Binding PanelBackgroundColor}"
                              HorizontalOptions="Fill"
                              Margin="0" />
              </Border>

              <!-- Tuner mode: staff canvas on left, note/cents readout on right (no staff on right) -->
              <Grid x:Name="TunerGrid" ColumnDefinitions="3*,2*" IsVisible="False" VerticalOptions="Fill">
                <Border x:Name="TunerBorder"
                        Grid.Column="0"
                        Stroke="Green"
                        StrokeShape="RoundRectangle 8"
                        Padding="0"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill">
                  <GraphicsView x:Name="TunerGraphicsView"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill" />
                </Border>
                <Border x:Name="TunerInfoBorder"
                        Grid.Column="1"
                        Stroke="Green"
                        StrokeShape="RoundRectangle 8"
                        Padding="8"
                        VerticalOptions="Fill">
                  <VerticalStackLayout Spacing="6"
                                       HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="Tuner" FontSize="20" FontAttributes="Bold"
                           HorizontalOptions="Center" TextColor="#000000" />
                    <Label Text="{Binding TunerDisplay}" FontSize="40" FontAttributes="Bold"
                           HorizontalOptions="Center" TextColor="#000000" />
                    <Label Text="{Binding TunerLastDetectedFreq, StringFormat='Heard: {0:F2} Hz'}"
                           FontSize="13" HorizontalOptions="Center" TextColor="#000000" />
                    <Label Text="{Binding TunerLastNearestFreq, StringFormat='Nearest: {0:F2} Hz'}"
                           FontSize="13" HorizontalOptions="Center" TextColor="#000000" />
                  </VerticalStackLayout>
                </Border>
              </Grid>
            </Grid>
          </Grid>

          <!-- Child level step buttons (below staff, above bottom pickers/buttons) -->
          <Border x:Name="ChildLevelSliderRow"
                  Margin="12,4,12,0"
                  Padding="8,6"
                  BackgroundColor="#EDE8E0"
                  Stroke="#8B4513"
                  StrokeThickness="1"
                  StrokeShape="RoundRectangle 8"
                  HorizontalOptions="Fill"
                  IsVisible="{Binding Source={x:Reference musicPage}, Path=IsChildLevelSliderVisible}">
            <Grid ColumnDefinitions="*,*,*,Auto,*,*,*"
                  ColumnSpacing="4"
                  HeightRequest="40"
                  VerticalOptions="Center"
                  HorizontalOptions="Fill">
              <Button Grid.Column="0"
                      Text="−10"
                      FontSize="12"
                      FontAttributes="Bold"
                      TextColor="White"
                      BackgroundColor="#8B4513"
                      BorderColor="#5D2F0C"
                      BorderWidth="1"
                      CornerRadius="6"
                      Padding="0"
                      HeightRequest="36"
                      VerticalOptions="Center"
                      HorizontalOptions="Fill"
                      CommandParameter="-10"
                      Clicked="OnChildLevelDeltaClicked" />
              <Button Grid.Column="1"
                      Text="−5"
                      FontSize="12"
                      FontAttributes="Bold"
                      TextColor="White"
                      BackgroundColor="#8B4513"
                      BorderColor="#5D2F0C"
                      BorderWidth="1"
                      CornerRadius="6"
                      Padding="0"
                      HeightRequest="36"
                      VerticalOptions="Center"
                      HorizontalOptions="Fill"
                      CommandParameter="-5"
                      Clicked="OnChildLevelDeltaClicked" />
              <Button Grid.Column="2"
                      Text="−1"
                      FontSize="12"
                      FontAttributes="Bold"
                      TextColor="White"
                      BackgroundColor="#8B4513"
                      BorderColor="#5D2F0C"
                      BorderWidth="1"
                      CornerRadius="6"
                      Padding="0"
                      HeightRequest="36"
                      VerticalOptions="Center"
                      HorizontalOptions="Fill"
                      CommandParameter="-1"
                      Clicked="OnChildLevelDeltaClicked" />
              <HorizontalStackLayout Grid.Column="3"
                                     Spacing="4"
                                     Margin="6,0"
                                     VerticalOptions="Center"
                                     HorizontalOptions="Center">
                <Label Text="Level"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="#1A1A1A"
                       VerticalOptions="Center" />
                <Label x:Name="ChildLevelSliderValueLabel"
                       Text="1"
                       FontSize="13"
                       FontAttributes="Bold"
                       TextColor="#1A1A1A"
                       VerticalOptions="Center"
                       MinimumWidthRequest="24"
                       HorizontalTextAlignment="Center" />
              </HorizontalStackLayout>
              <Button Grid.Column="4"
                      Text="+1"
                      FontSize="12"
                      FontAttributes="Bold"
                      TextColor="White"
                      BackgroundColor="#2E8B57"
                      BorderColor="#1F5C3A"
                      BorderWidth="1"
                      CornerRadius="6"
                      Padding="0"
                      HeightRequest="36"
                      VerticalOptions="Center"
                      HorizontalOptions="Fill"
                      CommandParameter="1"
                      Clicked="OnChildLevelDeltaClicked" />
              <Button Grid.Column="5"
                      Text="+5"
                      FontSize="12"
                      FontAttributes="Bold"
                      TextColor="White"
                      BackgroundColor="#2E8B57"
                      BorderColor="#1F5C3A"
                      BorderWidth="1"
                      CornerRadius="6"
                      Padding="0"
                      HeightRequest="36"
                      VerticalOptions="Center"
                      HorizontalOptions="Fill"
                      CommandParameter="5"
                      Clicked="OnChildLevelDeltaClicked" />
              <Button Grid.Column="6"
                      Text="+10"
                      FontSize="12"
                      FontAttributes="Bold"
                      TextColor="White"
                      BackgroundColor="#2E8B57"
                      BorderColor="#1F5C3A"
                      BorderWidth="1"
                      CornerRadius="6"
                      Padding="0"
                      HeightRequest="36"
                      VerticalOptions="Center"
                      HorizontalOptions="Fill"
                      CommandParameter="10"
                      Clicked="OnChildLevelDeltaClicked" />
            </Grid>
          </Border>

          <!-- Bottom row: practice pickers -->
          <Grid x:Name="BottomButtonRow"
                Margin="8,8,8,8"
                ColumnSpacing="0"
                HorizontalOptions="Fill"
                IsVisible="{Binding Source={x:Reference musicPage}, Path=IsBottomButtonRowVisible}">

            <Grid x:Name="BottomPickersLayout"
                  ColumnDefinitions="Auto,84,Auto,48,Auto,*"
                  ColumnSpacing="4"
                  VerticalOptions="Center"
                  HorizontalOptions="Fill"
                  IsVisible="{Binding Source={x:Reference musicPage}, Path=IsBottomPickersVisible}">
              <Label Grid.Column="0"
                     Text="Inst."
                     FontSize="10"
                     TextColor="#333333"
                     VerticalOptions="Center"
                     Margin="0,0,2,0"
                     LineBreakMode="TailTruncation"
                     MaxLines="1" />
              <Border Grid.Column="1" Style="{StaticResource CompactBrownBoxFill}">
                <Grid BackgroundColor="White">
                  <Picker x:Name="PracticeInstrumentPicker"
                          Style="{StaticResource PracticeBottomPicker}" />
                </Grid>
              </Border>
              <Label x:Name="PracticeKeyLabel"
                     Grid.Column="2"
                     Text="Key"
                     FontSize="10"
                     TextColor="#333333"
                     VerticalOptions="Center"
                     Margin="2,0,2,0" />
              <Border x:Name="PracticeKeyBorder" Grid.Column="3" Style="{StaticResource CompactBrownBoxFill}">
                <Grid BackgroundColor="White">
                  <Picker x:Name="PracticeKeyPicker"
                          Style="{StaticResource PracticeBottomPicker}" />
                </Grid>
              </Border>
              <Label x:Name="PracticeConcertKeyLabel"
                     Grid.Column="4"
                     FontSize="9"
                     TextColor="#333333"
                     VerticalOptions="Center"
                     Margin="2,0,4,0"
                     LineBreakMode="TailTruncation"
                     MaxLines="1"
                     MaximumWidthRequest="88" />
              <Border Grid.Column="5"
                      Style="{StaticResource CompactBrownBoxFill}"
                      HorizontalOptions="Fill">
                <Grid BackgroundColor="White">
                  <Picker x:Name="PracticeScaleTunePicker"
                          Style="{StaticResource PracticeBottomPicker}"
                          SelectedIndexChanged="PracticeScaleTunePickerChanged" />
                </Grid>
              </Border>
            </Grid>

          </Grid>
        </VerticalStackLayout>

      </VerticalStackLayout>
    </ScrollView>

    <!-- Play overlay under marquee start/stop; label content sized in code -->
    <Border x:Name="TitlePlayButton"
            BackgroundColor="#2E8B57"
            Stroke="#1F5C3A"
            StrokeThickness="1"
            Padding="0"
            HorizontalOptions="Start"
            VerticalOptions="Start"
            ZIndex="10"
            IsVisible="{Binding Source={x:Reference musicPage}, Path=IsTitlePlayButtonVisible}">
      <Border.StrokeShape>
        <RoundRectangle CornerRadius="2" />
      </Border.StrokeShape>
      <Border.GestureRecognizers>
        <TapGestureRecognizer Tapped="OnPlayEvaluateClicked" />
      </Border.GestureRecognizers>
    </Border>

    <!-- Color picker dialog overlay (full-page, above everything) -->
    <controls:ColorPickerDialog x:Name="ColorPickerDialog"
                                IsVisible="False" />
  </Grid>
</ContentPage>
