<!-- TEMPORARY TESTING PAGE: LevelUp Criteria Sliders -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="musicmate.Pages.AdvancePage"
             Title="LevelUp Criteria (TEMP)"
             BackgroundColor="White">
  <ScrollView>
    <VerticalStackLayout Padding="20" Spacing="18">
      <Label Text="TEMPORARY: LevelUp Criteria for Testing" FontAttributes="Bold" FontSize="18" TextColor="Red"/>
      <Label Text="Session Count (sessions to advance)"/>
      <Slider x:Name="SessionCountSlider" Minimum="1" Maximum="10" Value="{Binding SessionCount, Mode=TwoWay}"/>
      <Label Text="{Binding SessionCount, StringFormat='Current: {0}'}"/>

      <Label Text="Minimum Pitch Accuracy (%)"/>
      <Slider x:Name="MinPitchSlider" Minimum="0" Maximum="100" Value="{Binding MinPitchAccuracyPercent, Mode=TwoWay}"/>
      <Label Text="{Binding MinPitchAccuracyPercent, StringFormat='Current: {0:F0}%'}"/>

      <Label Text="Minimum Timing Consistency (%)"/>
      <Slider x:Name="MinTimingSlider" Minimum="0" Maximum="100" Value="{Binding MinTimingAccuracyPercent, Mode=TwoWay}"/>
      <Label Text="{Binding MinTimingAccuracyPercent, StringFormat='Current: {0:F0}%'}"/>

      <Label Text="Minimum Overall Accuracy (%)"/>
      <Slider x:Name="MinOverallSlider" Minimum="0" Maximum="100" Value="{Binding MinOverallAccuracyPercent, Mode=TwoWay}"/>
      <Label Text="{Binding MinOverallAccuracyPercent, StringFormat='Current: {0:F0}%'}"/>

      <Label Text="Minimum Notes Per Session"/>
      <Slider x:Name="MinNotesSlider" Minimum="1" Maximum="20" Value="{Binding MinNotesPerSession, Mode=TwoWay}"/>
      <Label Text="{Binding MinNotesPerSession, StringFormat='Current: {0}'}"/>

      <Button Text="Reset to Defaults" Clicked="OnResetClicked" BackgroundColor="OrangeRed" TextColor="White"/>
      <Label Text="These settings are for developer testing only and will be removed." FontSize="12" TextColor="Gray"/>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
