<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="musicmate.Pages.IntervalSightTrainingPage"
             Title="Interval (in semitones) Sight Training"
             Shell.NavBarIsVisible="True"
             BackgroundColor="{DynamicResource ThemePanelBackground}">

  <ContentPage.Resources>
    <Style x:Key="SightTrainButton" TargetType="Button">
      <Setter Property="BackgroundColor" Value="{DynamicResource ThemeButtonBackground}" />
      <Setter Property="TextColor" Value="{DynamicResource ThemeContrastingText}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderWidth" Value="0" />
      <Setter Property="FontAttributes" Value="Bold" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="MinimumHeightRequest" Value="36" />
      <Setter Property="HeightRequest" Value="36" />
      <Setter Property="Padding" Value="2,1" />
      <Setter Property="HorizontalOptions" Value="Fill" />
      <Setter Property="VerticalOptions" Value="Fill" />
      <Setter Property="HorizontalTextAlignment" Value="Center" />
      <Setter Property="VerticalTextAlignment" Value="Center" />
      <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>
  </ContentPage.Resources>

  <Shell.TitleView>
    <Grid ColumnDefinitions="*,Auto"
          HeightRequest="44"
          Padding="0,0,8,0"
          VerticalOptions="Center">
      <Label Grid.Column="0"
             Text="Interval (in semitones) Sight Training"
             FontAttributes="Bold"
             FontSize="16"
             LineBreakMode="TailTruncation"
             TextColor="{DynamicResource ThemeContrastingText}"
             VerticalOptions="Center" />
      <Border Grid.Column="1"
              Style="{StaticResource TitleLogoBorder}"
              VerticalOptions="Center"
              HorizontalOptions="End">
        <Image Source="logo.png" Aspect="AspectFill" />
      </Border>
    </Grid>
  </Shell.TitleView>

  <!-- No ScrollView: staff + controls stay in one viewport. -->
  <Grid x:Name="MainLayout"
        Padding="4,2,4,4"
        RowDefinitions="*,Auto,Auto"
        RowSpacing="4">

    <GraphicsView x:Name="StaffGraphicsView"
                  Grid.Row="0"
                  VerticalOptions="Fill"
                  HorizontalOptions="Fill" />

    <!-- Level label + slider + value: full content width -->
    <Grid x:Name="ToolbarRow"
          Grid.Row="1"
          ColumnDefinitions="Auto,*,Auto"
          ColumnSpacing="6"
          HeightRequest="32"
          HorizontalOptions="Fill"
          VerticalOptions="Center">
      <Label Grid.Column="0"
             Text="Level"
             FontSize="12"
             FontAttributes="Bold"
             TextColor="{DynamicResource ThemeContrastingText}"
             VerticalOptions="Center" />
      <Slider x:Name="LevelSlider"
              Grid.Column="1"
              Minimum="1"
              Maximum="100"
              Value="1"
              MinimumTrackColor="{DynamicResource ThemeSlider}"
              ThumbColor="{DynamicResource ThemeSlider}"
              VerticalOptions="Center"
              HorizontalOptions="Fill"
              ValueChanged="OnLevelSliderValueChanged"
              SemanticProperties.Description="Child Level for Sight Training, 1 to 100" />
      <Label x:Name="LevelValueLabel"
             Grid.Column="2"
             Text="1"
             FontSize="13"
             FontAttributes="Bold"
             MinimumWidthRequest="28"
             HorizontalTextAlignment="End"
             TextColor="{DynamicResource ThemeContrastingText}"
             VerticalOptions="Center" />
    </Grid>

    <Grid x:Name="IntervalButtonsHost"
          Grid.Row="2"
          ColumnDefinitions="*,*,*,*,*"
          ColumnSpacing="2"
          RowSpacing="2"
          HorizontalOptions="Fill"
          VerticalOptions="End" />

    <Grid x:Name="FeedbackOverlay"
          Grid.RowSpan="3"
          IsVisible="False"
          BackgroundColor="#88000000"
          InputTransparent="False">
      <Border BackgroundColor="{DynamicResource ThemeButtonBackground}"
              StrokeThickness="0"
              StrokeShape="RoundRectangle 16"
              Padding="28,20"
              HorizontalOptions="Center"
              VerticalOptions="Center">
        <Label x:Name="FeedbackTitleLabel"
               Text="Correct!"
               FontSize="28"
               FontAttributes="Bold"
               HorizontalTextAlignment="Center"
               TextColor="{DynamicResource ThemeContrastingText}" />
      </Border>
    </Grid>
  </Grid>
</ContentPage>
