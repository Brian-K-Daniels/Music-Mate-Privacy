<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:musicmate.ViewModels"
             x:Class="musicmate.Pages.NoteAttemptsDebugPage"
             x:DataType="vm:NoteAttemptsDebugPageViewModel"
             Title="Note Attempts"
             Shell.NavBarIsVisible="True"
             BackgroundColor="{DynamicResource ThemePanelBackground}">

  <ContentPage.Resources>
    <Style TargetType="Label">
      <Setter Property="TextColor" Value="{DynamicResource ThemeContrastingText}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="TextColor" Value="{DynamicResource ThemeButtonText}" />
      <Setter Property="BackgroundColor" Value="{DynamicResource ThemeButtonBackground}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="FontSize" Value="13" />
    </Style>
  </ContentPage.Resources>

  <Shell.TitleView>
    <Grid ColumnDefinitions="*,Auto" HeightRequest="44" VerticalOptions="Center" BackgroundColor="Transparent">
      <HorizontalStackLayout Spacing="10" VerticalOptions="Center" Grid.Column="0">
        <Button Text="←"
                Clicked="OnNavigatePracticeClicked"
                BackgroundColor="{DynamicResource ThemeButtonBackground}"
                TextColor="{DynamicResource ThemeContrastingText}"
                FontSize="18"
                Padding="12,0"
                WidthRequest="56" />
        <Label Text="Note Attempts"
               TextColor="{DynamicResource ThemeContrastingText}"
               FontAttributes="Bold"
               FontSize="18"
               VerticalOptions="Center" />
      </HorizontalStackLayout>
      <Border Style="{StaticResource TitleLogoBorder}"
              VerticalOptions="Center"
              HorizontalOptions="End"
              Grid.Column="1">
        <Image Source="logo.png" Aspect="AspectFill" />
      </Border>
    </Grid>
  </Shell.TitleView>

  <!-- One ScrollView so status/controls scroll away with the rows and bindings stay on the page VM. -->
  <ScrollView>
    <VerticalStackLayout Padding="12,8" Spacing="6">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <Label Grid.Column="0"
               Text="{Binding StatusText}"
               FontAttributes="Bold"
               FontSize="14"
               VerticalOptions="Center"
               LineBreakMode="WordWrap" />
        <Button Grid.Column="1"
                Text="Refresh"
                Command="{Binding RefreshCommand}"
                WidthRequest="100" />
        <Button Grid.Column="2"
                Text="Clear DB"
                Clicked="OnClearDatabaseClicked"
                WidthRequest="100" />
      </Grid>
      <Label Text="{Binding HistogramText}"
             FontSize="11"
             LineBreakMode="WordWrap" />
      <Label Text="{Binding DatabasePathText}"
             FontSize="10"
             LineBreakMode="CharacterWrap"
             Opacity="0.8" />
      <Label Text="No note attempts yet. Complete a practice session (not autoplay), then Refresh."
             FontSize="11"
             Margin="0,4,0,0"
             LineBreakMode="WordWrap"
             IsVisible="{Binding HasNoRows}" />

      <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}" Spacing="0">
        <BindableLayout.ItemTemplate>
          <DataTemplate x:DataType="vm:NoteAttemptRowViewModel">
            <Border Stroke="{DynamicResource ThemePickerBorder}"
                    BackgroundColor="{DynamicResource ThemeSecondPanelBackground}"
                    Padding="8,6"
                    Margin="0,0,0,6">
              <Border.StrokeShape>
                <RoundRectangle CornerRadius="6" />
              </Border.StrokeShape>
              <VerticalStackLayout Spacing="2">
                <Label Text="{Binding Header}"
                       FontAttributes="Bold"
                       FontSize="11" />
                <Label Text="{Binding Detail}"
                       FontSize="11"
                       LineBreakMode="WordWrap" />
              </VerticalStackLayout>
            </Border>
          </DataTemplate>
        </BindableLayout.ItemTemplate>
      </VerticalStackLayout>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
