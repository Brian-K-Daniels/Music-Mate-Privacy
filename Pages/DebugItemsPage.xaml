<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="musicmate.Pages.DebugItemsPage"
             Title="Debug Items"
             Shell.NavBarIsVisible="True"
             BackgroundColor="{DynamicResource ThemePanelBackground}">

  <ContentPage.Resources>
    <Style TargetType="Label">
      <Setter Property="TextColor" Value="{DynamicResource ThemeContrastingText}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalOptions" Value="Center" />
    </Style>
  </ContentPage.Resources>

  <Shell.TitleView>
    <Grid ColumnDefinitions="*,Auto" HeightRequest="30" VerticalOptions="Center" BackgroundColor="Transparent">
      <HorizontalStackLayout Spacing="10" VerticalOptions="Center" Grid.Column="0">
        <Button Text="←"
                Clicked="OnNavigatePracticeClicked"
                BackgroundColor="Transparent"
                TextColor="{DynamicResource ThemeContrastingText}"
                FontSize="18"
                Padding="12,0"
                WidthRequest="56" />
        <Label Text="Debug Items"
               TextColor="{DynamicResource ThemeContrastingText}"
               FontAttributes="Bold"
               FontSize="18"
               VerticalOptions="Center" />
      </HorizontalStackLayout>
      <Border Style="{StaticResource TitleLogoBorder}"
              VerticalOptions="Center"
              HorizontalOptions="End"
              Grid.Column="1">
        <Image Source="logo.png" Aspect="AspectFill" />
      </Border>
    </Grid>
  </Shell.TitleView>

  <ScrollView>
    <VerticalStackLayout Padding="12,8" Spacing="8">
      <Label Text="Debug Items"
             FontAttributes="Bold"
             FontSize="18"
             TextColor="{Binding ContrastingTextColor}" />
      <Label Text="Turn categories off to suppress matching debug output. All categories default to on."
             FontSize="12"
             LineBreakMode="WordWrap"
             TextColor="{Binding ContrastingTextColor}" />

      <VerticalStackLayout BindableLayout.ItemsSource="{Binding Categories}" Spacing="6">
        <BindableLayout.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,4">
              <VerticalStackLayout Grid.Column="0" Spacing="2">
                <Label Text="{Binding DisplayName}"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource ThemeContrastingText}" />
                <Label Text="{Binding Description}"
                       FontSize="11"
                       LineBreakMode="WordWrap"
                       TextColor="{DynamicResource ThemeContrastingText}" />
              </VerticalStackLayout>
              <Switch Grid.Column="1"
                      IsToggled="{Binding IsEnabled, Mode=TwoWay}"
                      OnColor="{DynamicResource ThemeSlider}"
                      VerticalOptions="Center" />
            </Grid>
          </DataTemplate>
        </BindableLayout.ItemTemplate>
      </VerticalStackLayout>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
