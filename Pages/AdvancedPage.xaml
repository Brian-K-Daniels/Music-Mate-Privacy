<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="musicmate.Pages.AdvancedPage"
             Title="Advanced"
             Shell.NavBarIsVisible="True"
             BackgroundColor="{DynamicResource ThemePanelBackground}">

  <ContentPage.Resources>
    <Style TargetType="Label">
      <Setter Property="TextColor" Value="{DynamicResource ThemeContrastingText}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="TextColor" Value="{DynamicResource ThemeButtonText}" />
      <Setter Property="BackgroundColor" Value="{DynamicResource ThemeButtonBackground}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontAttributes" Value="Bold" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style TargetType="Border">
      <Setter Property="Stroke" Value="{DynamicResource ThemePickerBorder}" />
    </Style>
    <Style TargetType="Slider">
      <Setter Property="ThumbColor" Value="{DynamicResource ThemeSlider}" />
      <Setter Property="MinimumTrackColor" Value="{DynamicResource ThemeSlider}" />
      <Setter Property="MaximumTrackColor" Value="#CCCCCC" />
    </Style>
    <Style x:Key="AdvancedPanelTitle" TargetType="Label">
      <Setter Property="FontAttributes" Value="Bold" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="TextColor" Value="{DynamicResource ThemeHeadingText}" />
    </Style>
  </ContentPage.Resources>

  <Shell.TitleView>
    <Grid ColumnDefinitions="*,Auto" HeightRequest="30" VerticalOptions="Center">
      <HorizontalStackLayout Spacing="10" VerticalOptions="Center" Grid.Column="0">
        <Button Text="←"
                Clicked="OnNavigatePracticeClicked"
                BackgroundColor="Transparent"
                TextColor="{DynamicResource ThemeContrastingText}"
                FontSize="18"
                Padding="12,0"
                WidthRequest="56" />
        <Label Text="Advanced"
               TextColor="{DynamicResource ThemeContrastingText}"
               FontAttributes="Bold"
               FontSize="18"
               VerticalOptions="Center" />
      </HorizontalStackLayout>
      <Border Style="{StaticResource TitleLogoBorder}"
              VerticalOptions="Center"
              HorizontalOptions="End"
              Grid.Column="1">
        <Image Source="logo.png" Aspect="AspectFill" />
      </Border>
    </Grid>
  </Shell.TitleView>

  <ScrollView>
    <VerticalStackLayout x:Name="AdvancedMainLayout" Spacing="16" HorizontalOptions="Fill" Padding="16, 8">
      <!-- Practice composition % -->
      <Border Stroke="{DynamicResource ThemePickerBorder}" Padding="12" Margin="0,0,0,0" BackgroundColor="{DynamicResource ThemeSecondPanelBackground}">
        <Border.StrokeShape>
          <RoundRectangle CornerRadius="10"/>
        </Border.StrokeShape>
        <VerticalStackLayout Spacing="10">
          <Label Text="Practice composition %" Style="{StaticResource AdvancedPanelTitle}"/>

          <Grid ColumnDefinitions="160,*,60" RowSpacing="8">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Text="Tunes" VerticalOptions="Center"/>
            <Slider x:Name="PcTunesSlider" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="100"
                    Value="{Binding PcTunesDraft, Mode=TwoWay}"
                    DragCompleted="OnPcTunesDragCompleted"/>
            <Label Grid.Row="0" Grid.Column="2" Text="{Binding PcTunesDraft}" HorizontalTextAlignment="End" VerticalOptions="Center"/>

            <Label Grid.Row="1" Grid.Column="0" Text="Random" VerticalOptions="Center"/>
            <Slider x:Name="PcRandomSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100"
                    Value="{Binding PcRandomDraft, Mode=TwoWay}"
                    DragCompleted="OnPcRandomDragCompleted"/>
            <Label Grid.Row="1" Grid.Column="2" Text="{Binding PcRandomDraft}" HorizontalTextAlignment="End" VerticalOptions="Center"/>

            <Label Grid.Row="2" Grid.Column="0" Text="Scales" VerticalOptions="Center"/>
            <Slider x:Name="PcScalesSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100"
                    Value="{Binding PcScalesDraft, Mode=TwoWay}"
                    DragCompleted="OnPcScalesDragCompleted"/>
            <Label Grid.Row="2" Grid.Column="2" Text="{Binding PcScalesDraft}" HorizontalTextAlignment="End" VerticalOptions="Center"/>

            <Label Grid.Row="3" Grid.Column="0" Text="Arpeggios" VerticalOptions="Center"/>
            <Slider x:Name="PcArpeggiosSlider" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100"
                    Value="{Binding PcArpeggiosDraft, Mode=TwoWay}"
                    DragCompleted="OnPcArpeggiosDragCompleted"/>
            <Label Grid.Row="3" Grid.Column="2" Text="{Binding PcArpeggiosDraft}" HorizontalTextAlignment="End" VerticalOptions="Center"/>
          </Grid>
        </VerticalStackLayout>
      </Border>

      <!-- Level Advancement Criteria Section -->
      <Border Stroke="{DynamicResource ThemePickerBorder}" Padding="12" Margin="0,16,0,0" BackgroundColor="{DynamicResource ThemeSecondPanelBackground}">
          <Border.StrokeShape>
            <RoundRectangle CornerRadius="10"/>
          </Border.StrokeShape>
          <VerticalStackLayout Spacing="10">
          <Label Text="Level Advancement Criteria" Style="{StaticResource AdvancedPanelTitle}"/>

          <Grid ColumnDefinitions="160,*,60,80" RowSpacing="8" >
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Grid.Column="0" Text="Sessions Required to Advance" VerticalOptions="Center"/>
            <Slider Grid.Row="0" Grid.Column="1" Minimum="1" Maximum="10" Value="{Binding SessionCount, Mode=TwoWay}"/>
            <Label Grid.Row="0" Grid.Column="2" Text="{Binding SessionCount}" HorizontalTextAlignment="End" VerticalOptions="Center"/>
            <Label Grid.Row="0" Grid.Column="3" Text="{Binding CurrentSessionNotesCount}" HorizontalTextAlignment="End" VerticalOptions="Center"/>

            <Label Grid.Row="1" Grid.Column="0" Text="Minimum Pitch Accuracy (%)" VerticalOptions="Center"/>
            <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding MinPitchAccuracyPercent, Mode=TwoWay}"/>
            <Label Grid.Row="1" Grid.Column="2" Text="{Binding MinPitchAccuracyPercent, StringFormat='{0:F0}%'}" HorizontalTextAlignment="End" VerticalOptions="Center"/>
            <Label Grid.Row="1" Grid.Column="3" Text="{Binding CurrentSessionPitchAccuracyPercent, StringFormat='{0:F0}%'}" HorizontalTextAlignment="End" VerticalOptions="Center"/>

            <Label Grid.Row="2" Grid.Column="0" Text="Minimum Timing Consistency (%)" VerticalOptions="Center"/>
            <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding MinTimingAccuracyPercent, Mode=TwoWay}"/>
            <Label Grid.Row="2" Grid.Column="2" Text="{Binding MinTimingAccuracyPercent, StringFormat='{0:F0}%'}" HorizontalTextAlignment="End" VerticalOptions="Center"/>
            <Label Grid.Row="2" Grid.Column="3"
                   Text="{Binding CurrentSessionTimingAccuracyPercent, StringFormat='{0:F0}%', TargetNullValue='N/A'}"
                   HorizontalTextAlignment="End" VerticalOptions="Center"/>

            <Label Grid.Row="3" Grid.Column="0" Text="Minimum Overall Accuracy (%)" VerticalOptions="Center"/>
            <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding MinOverallAccuracyPercent, Mode=TwoWay}"/>
            <Label Grid.Row="3" Grid.Column="2" Text="{Binding MinOverallAccuracyPercent, StringFormat='{0:F0}%'}" HorizontalTextAlignment="End" VerticalOptions="Center"/>
            <Label Grid.Row="3" Grid.Column="3" Text="{Binding CurrentSessionOverallAccuracyPercent, StringFormat='{0:F0}%'}" HorizontalTextAlignment="End" VerticalOptions="Center"/>

            <Label Grid.Row="4" Grid.Column="0" Text="Minimum Notes Per Session" VerticalOptions="Center"/>
            <Slider Grid.Row="4" Grid.Column="1" Minimum="1" Maximum="20" Value="{Binding MinNotesPerSession, Mode=TwoWay}"/>
            <Label Grid.Row="4" Grid.Column="2" Text="{Binding MinNotesPerSession}" HorizontalTextAlignment="End" VerticalOptions="Center"/>
            <Label Grid.Row="4" Grid.Column="3" Text="{Binding CurrentSessionNotesCount}" HorizontalTextAlignment="End" VerticalOptions="Center"/>
          </Grid>
        </VerticalStackLayout>
      </Border>
      <!-- Advanced Settings Section -->
      <Border Stroke="{DynamicResource ThemePickerBorder}" Padding="12" Margin="0,16,0,0" BackgroundColor="{DynamicResource ThemeSecondPanelBackground}">
        <Border.StrokeShape> <RoundRectangle CornerRadius="10"/></Border.StrokeShape>
        <VerticalStackLayout Spacing="10">
          <Label Text="Advanced Audio &amp; Pitch Settings" Style="{StaticResource AdvancedPanelTitle}"/>

          <Grid ColumnDefinitions="160,*,60" RowSpacing="8" >
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Grid.Column="0" Text="Pitch Tolerance (cents)" VerticalOptions="Center"/>
            <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Tolerance, Mode=TwoWay}"/>
            <Label Grid.Row="0" Grid.Column="2" Text="{Binding Tolerance}" HorizontalTextAlignment="End" VerticalOptions="Center"/>

            <Label Grid.Row="1" Grid.Column="0" Text="RMS Threshold" VerticalOptions="Center"/>
            <Slider Grid.Row="1" Grid.Column="1" Minimum="0.0" Maximum="0.1" Value="{Binding RmsThreshold, Mode=TwoWay}"/>
            <Label Grid.Row="1" Grid.Column="2" Text="{Binding RmsThreshold, StringFormat='{0:F3}'}" HorizontalTextAlignment="End" VerticalOptions="Center"/>

            <Label Grid.Row="2" Grid.Column="0" Text="Cooldown (ms)" VerticalOptions="Center"/>
            <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="300" Value="{Binding CooldownMs, Mode=TwoWay}"/>
            <Label Grid.Row="2" Grid.Column="2" Text="{Binding CooldownMs}" HorizontalTextAlignment="End" VerticalOptions="Center"/>

            <Label Grid.Row="3" Grid.Column="0" Text="Pitch Offset (cents)" VerticalOptions="Center"/>
            <Slider Grid.Row="3" Grid.Column="1" Minimum="-50" Maximum="50" Value="{Binding PitchOffsetCents, Mode=TwoWay}"/>
            <Label Grid.Row="3" Grid.Column="2" Text="{Binding PitchOffsetCents, StringFormat='{0:F1}'}" HorizontalTextAlignment="End" VerticalOptions="Center"/>
          </Grid>
        </VerticalStackLayout>
      </Border>

      <!-- Storage -->
      <Border Stroke="{DynamicResource ThemePickerBorder}" Padding="12" Margin="0,16,0,0" BackgroundColor="{DynamicResource ThemeSecondPanelBackground}">
        <Border.StrokeShape>
          <RoundRectangle CornerRadius="10"/>
        </Border.StrokeShape>
        <VerticalStackLayout Spacing="10">
          <Label Text="Storage" Style="{StaticResource AdvancedPanelTitle}"/>
          <Label Text="{Binding MemoryUsageDisplay}" FontSize="12" FontAttributes="Bold" />
          <Grid ColumnDefinitions="200,*,60" ColumnSpacing="4" VerticalOptions="Center">
            <Label Grid.Column="0" Text="Max Session DB (MB)" />
            <Slider Grid.Column="1" Minimum="10"
                    Maximum="{Binding AvailableStorageMb}"
                    Value="{Binding MaxSessionDbSizeMb, Mode=TwoWay}" />
            <Label Grid.Column="2" Text="{Binding MaxSessionDbSizeMb, StringFormat='{0:F0}'}"
                   HorizontalTextAlignment="End" />
          </Grid>
        </VerticalStackLayout>
      </Border>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
