<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="musicmate.Pages.AdvancedPage"
             Title="Advanced"
             Shell.NavBarIsVisible="True"
             BackgroundColor="{Binding PanelBackgroundColor}">

  <ContentPage.Resources>
    <Style TargetType="Label">
      <Setter Property="TextColor" Value="{Binding ContrastingTextColor}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="TextColor" Value="{Binding ContrastingTextColor}" />
      <Setter Property="BackgroundColor" Value="#8B4513" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontAttributes" Value="Bold" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style TargetType="Border">
      <Setter Property="Stroke" Value="#8B4513" />
    </Style>
    <Style TargetType="Slider">
      <Setter Property="ThumbColor" Value="#8B4513" />
      <Setter Property="MinimumTrackColor" Value="#8B4513" />
      <Setter Property="MaximumTrackColor" Value="White" />
    </Style>
  </ContentPage.Resources>

  <Shell.TitleView>
    <Grid ColumnDefinitions="*,Auto" HeightRequest="30" VerticalOptions="Center">
      <HorizontalStackLayout Spacing="10" VerticalOptions="Center" Grid.Column="0">
        <Button Text="←"
                Clicked="OnNavigateHomeClicked"
                BackgroundColor="Transparent"
                TextColor="White"
                FontSize="18"
                Padding="0"
                WidthRequest="32" />
        <Label Text="Advanced"
               TextColor="White"
               FontAttributes="Bold"
               FontSize="18"
               VerticalOptions="Center" />
      </HorizontalStackLayout>
      <Image Source="logo.png"
             HeightRequest="32"
             WidthRequest="32"
             VerticalOptions="Center"
             HorizontalOptions="End"
             Grid.Column="1" />
    </Grid>
  </Shell.TitleView>

  <ScrollView>
    <VerticalStackLayout x:Name="AdvancedMainLayount" Spacing="16">
        <VerticalStackLayout Spacing="10">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
            <!-- Pitch Tolerance -->
            <Label Grid.Row="0" Grid.Column="0" Text="Pitch Tolerance (cents)" FontSize="12" VerticalOptions="Center"/>
            <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Tolerance, Mode=TwoWay}"/>
            <Label Grid.Row="0" Grid.Column="2" Text="{Binding Tolerance}" FontSize="12" VerticalOptions="Center" TextColor="{Binding ContrastingTextColor}"/>

            <!-- RMS Threshold -->
            <Label Grid.Row="1" Grid.Column="0" Text="RMS Threshold" FontSize="12" VerticalOptions="Center"/>
            <Slider Grid.Row="1" Grid.Column="1" Minimum="0.0" Maximum="0.1" Value="{Binding RmsThreshold, Mode=TwoWay}"/>
            <Label Grid.Row="1" Grid.Column="2" Text="{Binding RmsThreshold, StringFormat='{0:F3}'}" FontSize="12" VerticalOptions="Center" TextColor="{Binding ContrastingTextColor}"/>

            <!-- Cooldown -->
            <Label Grid.Row="2" Grid.Column="0" Text="Cooldown (ms)" FontSize="12" VerticalOptions="Center"/>
            <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="300" Value="{Binding CooldownMs, Mode=TwoWay}"/>
            <Label Grid.Row="2" Grid.Column="2" Text="{Binding CooldownMs}" FontSize="12" VerticalOptions="Center" TextColor="{Binding ContrastingTextColor}"/>

            <!-- Pitch Offset -->
            <Label Grid.Row="3" Grid.Column="0" Text="Pitch Offset (cents)" FontSize="12" VerticalOptions="Center"/>
            <Slider Grid.Row="3" Grid.Column="1" Minimum="-50" Maximum="50" Value="{Binding PitchOffsetCents, Mode=TwoWay}"/>
            <Label Grid.Row="3" Grid.Column="2" Text="{Binding PitchOffsetCents, StringFormat='{0:F1} cents'}" FontSize="12" VerticalOptions="Center" TextColor="{Binding ContrastingTextColor}"/>

            <!-- Delay Between Repeats -->
            <Label Grid.Row="4" Grid.Column="0" Text="Delay Between Repeats (secs)" FontSize="12" VerticalOptions="Center"/>
            <Slider Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="20" Value="{Binding RepeatDelaySeconds, Mode=TwoWay}"/>
            <Label Grid.Row="4" Grid.Column="2" Text="{Binding RepeatDelaySeconds, StringFormat='Delay: {0:F1} sec'}" FontSize="12" VerticalOptions="Center" TextColor="{Binding ContrastingTextColor}"/>

            <!-- Wrong debounce for wrong-counts -->
            <Label Grid.Row="5" Grid.Column="0" Text="Wrong Debounce (ms)" FontSize="12" VerticalOptions="Center"/>
            <Slider Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="2000" Value="{Binding WrongDebounceMs, Mode=TwoWay}"/>
            <Label Grid.Row="5" Grid.Column="2" Text="{Binding WrongDebounceMs}" FontSize="12" VerticalOptions="Center" TextColor="{Binding ContrastingTextColor}"/>

            <!-- Pitch window size for detection -->
            <Label Grid.Row="6" Grid.Column="0" Text="Pitch Window Size" FontSize="12" VerticalOptions="Center"/>
            <Slider Grid.Row="6" Grid.Column="1" Minimum="512" Maximum="16384" Value="{Binding PitchWindowSize, Mode=TwoWay}"/>
            <Label Grid.Row="6" Grid.Column="2" Text="{Binding PitchWindowSize}" FontSize="12" VerticalOptions="Center" TextColor="{Binding ContrastingTextColor}"/>

            <!-- Smoothing window size (median smoothing) -->
            <Label Grid.Row="7" Grid.Column="0" Text="Smoothing Window" FontSize="12" VerticalOptions="Center"/>
            <Slider Grid.Row="7" Grid.Column="1" Minimum="1" Maximum="11" Value="{Binding SmoothingWindowSize, Mode=TwoWay}"/>
            <Label Grid.Row="7" Grid.Column="2" Text="{Binding SmoothingWindowSize}" FontSize="12" VerticalOptions="Center" TextColor="{Binding ContrastingTextColor}"/>

            <!-- Pitch confidence threshold -->
            <Label Grid.Row="8" Grid.Column="0" Text="Pitch Confidence" FontSize="12" VerticalOptions="Center"/>
            <Slider Grid.Row="8" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding PitchConfidenceThreshold, Mode=TwoWay}"/>
            <Label Grid.Row="8" Grid.Column="2" Text="{Binding PitchConfidenceThreshold, StringFormat='{0:F2}'}" FontSize="12" VerticalOptions="Center" TextColor="{Binding ContrastingTextColor}"/>
          </Grid>
        </VerticalStackLayout>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
