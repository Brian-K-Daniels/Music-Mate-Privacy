<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="musicmate.Pages.StatisticsPages"
             x:Name="StatisticsPageRoot"
             Title="Statistics"
             Shell.NavBarIsVisible="True"
             BackgroundColor="{Binding PanelBackgroundColor}">

  <ContentPage.Resources>
    <Style x:Key="StatsLabelStyle" TargetType="Label">
      <Setter Property="TextColor" Value="{Binding ContrastingTextColor}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="TextColor" Value="white" />
      <Setter Property="BackgroundColor" Value="#8B4513" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="Margin" Value="4,2,4,2" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style TargetType="Border">
      <Setter Property="Stroke" Value="#8B4513" />
    </Style>
    <Style TargetType="Picker">
      <Setter Property="TextColor" Value="{Binding ContrastingTextColor}" />
      <Setter Property="BackgroundColor" Value="{Binding PanelBackgroundColor}" />
      <Setter Property="FontSize" Value="20" />
    </Style>
  </ContentPage.Resources>

  <Shell.TitleView>
    <Grid ColumnDefinitions="*,Auto" HeightRequest="30" VerticalOptions="Center" BackgroundColor="Transparent">
      <HorizontalStackLayout Spacing="10" VerticalOptions="Center" Grid.Column="0">
        <Button Text="←"
                Clicked="OnNavigateHomeClicked"
                BackgroundColor="Transparent"
                TextColor="white"
                FontSize="18"
                Padding="0"
                WidthRequest="32" />
        <Label Text="Statistics"
               TextColor="white"
               FontAttributes="Bold"
               FontSize="18"
               VerticalOptions="Center" />
      </HorizontalStackLayout>
      <Image Source="logo.png"
             HeightRequest="32"
             WidthRequest="32"
             VerticalOptions="Center"
             HorizontalOptions="End"
             Grid.Column="1" />
    </Grid>
  </Shell.TitleView>

  <!-- Main content -->
  <Grid>
    <VerticalStackLayout x:Name="StatisticsMainLayout" Spacing="4">

      <!-- Database Picker and Actions -->
      <ScrollView Orientation="Horizontal">
        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
          <Label Text="Database:" FontSize="14" VerticalOptions="Center" TextColor="{Binding ContrastingTextColor}" />
          <Border StrokeThickness="2" StrokeShape="RoundRectangle 4" Padding="2,2,2,2" BackgroundColor="WhiteSmoke" WidthRequest="160">
            <Picker x:Name="DatabasePicker"
                    ItemsSource="{Binding DatabaseOptions}"
                    SelectedItem="{Binding SelectedDatabase, Mode=TwoWay}"
                    WidthRequest="150"
                    HeightRequest="40"
                    FontSize="12"
                    TextColor="{Binding ContrastingTextColor}" />
          </Border>
          <Button x:Name="ClearAllButton" Text="Clear All" Clicked="OnDeleteDataInSelectedDatabase" WidthRequest="120" />
          <Button x:Name="DeleteAllButton" Text="Delete Selected Database" Clicked="OnDeleteAllDataInSelectedDatabase" WidthRequest="250" IsVisible="True" />
        </HorizontalStackLayout>
      </ScrollView>

      <!-- Note Stats Table with fixed header (unchanged) -->
      <ScrollView Orientation="Horizontal">
        <VerticalStackLayout MinimumWidthRequest="480" Spacing="0">
          <Grid ColumnDefinitions="*,Auto" Padding="0" Margin="0" IsVisible="{Binding IsNoteDatabase}">
            <Grid Grid.Column="0" ColumnDefinitions="120,80,80,100,100" HeightRequest="28">
              <Label Text="Note" Grid.Column="0" FontSize="10" FontAttributes="Bold" TextColor="{Binding ContrastingTextColor}" />
              <Label Text="Correct" Grid.Column="1" FontSize="10" FontAttributes="Bold" TextColor="{Binding ContrastingTextColor}" />
              <Label Text="Wrong" Grid.Column="2" FontSize="10" FontAttributes="Bold" TextColor="{Binding ContrastingTextColor}" />
              <Label Text="% Correct" Grid.Column="3" FontSize="10" FontAttributes="Bold" TextColor="{Binding ContrastingTextColor}" />
              <Label Text="MsAvg" Grid.Column="4" FontSize="10" FontAttributes="Bold" TextColor="{Binding ContrastingTextColor}" />
            </Grid>
            <Label Grid.Column="1" Text="{Binding AverageWrong, StringFormat='Avg Wrong: {0:F1}'}" VerticalOptions="Center" HorizontalOptions="End" Margin="8,0,8,0" TextColor="{Binding ContrastingTextColor}" />
          </Grid>

          <ScrollView Orientation="Vertical" HeightRequest="240" IsVisible="{Binding IsNoteDatabase}">
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding NoteStats}">
              <BindableLayout.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="120,80,80,100,100" Padding="0,0,0,0" HeightRequest="24">
                    <Label Text="{Binding WrittenName}" Grid.Column="0" FontSize="10" TextColor="{Binding ContrastingTextColor}" />
                    <Label Text="{Binding Correct}" Grid.Column="1" FontSize="10" TextColor="{Binding ContrastingTextColor}" />
                    <Label Text="{Binding Wrong}" Grid.Column="2" FontSize="10" TextColor="{Binding ContrastingTextColor}" />
                    <Label Text="{Binding PercentCorrect, StringFormat='{0:F1}'}" Grid.Column="3" FontSize="10" TextColor="{Binding ContrastingTextColor}" />
                    <Label Text="{Binding MsAverage, StringFormat='{0:F0}'}" Grid.Column="4" FontSize="10" TextColor="{Binding ContrastingTextColor}" />
                  </Grid>
                </DataTemplate>
              </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
          </ScrollView>
        </VerticalStackLayout>
      </ScrollView>

      <!-- Session Stats Table -->
      <!-- Column widths chosen to accommodate headings and data; header and data use identical definitions -->
      <ScrollView Orientation="Horizontal">
        <VerticalStackLayout MinimumWidthRequest="760" Spacing="0">
          <!-- Header row -->
          <Grid Padding="0" Margin="0" IsVisible="{Binding IsSessionDatabase}" HeightRequest="28">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="32" />   <!-- delete icon -->
              <ColumnDefinition Width="120" />  <!-- Date -->
              <ColumnDefinition Width="106" />  <!-- Scale -->
              <ColumnDefinition Width="36" />   <!-- Key -->
              <ColumnDefinition Width="80" />   <!-- Correct % -->
              <ColumnDefinition Width="64" />   <!-- Tempo -->
              <ColumnDefinition Width="96" />   <!-- Tempo CV (wider to show percent) -->
              <ColumnDefinition Width="110" />  <!-- Instrument -->
              <ColumnDefinition Width="44" />   <!-- Hi -->
              <ColumnDefinition Width="44" />   <!-- Lo -->
              <ColumnDefinition Width="96" />   <!-- Tempo SD (wider) -->
            </Grid.ColumnDefinitions>

            <Label Text="" Grid.Column="0" FontAttributes="Bold" FontSize="10" TextColor="{Binding ContrastingTextColor}"
                   HorizontalTextAlignment="Center" HorizontalOptions="Center" />
            <Label Text="Date" Grid.Column="1" FontAttributes="Bold" FontSize="10" TextColor="{Binding ContrastingTextColor}"
                   Padding="4,0" LineBreakMode="NoWrap" HorizontalTextAlignment="Center" HorizontalOptions="Center" />
            <Label Text="Scale" Grid.Column="2" FontAttributes="Bold" FontSize="10" TextColor="{Binding ContrastingTextColor}"
                   Padding="4,0" LineBreakMode="NoWrap" HorizontalTextAlignment="Center" HorizontalOptions="Center" />
            <Label Text="Key" Grid.Column="3" FontAttributes="Bold" FontSize="10" TextColor="{Binding ContrastingTextColor}"
                   Padding="4,0" LineBreakMode="NoWrap" HorizontalTextAlignment="Center" HorizontalOptions="Center" />
            <Label Text="Correct %" Grid.Column="4" FontAttributes="Bold" FontSize="10" TextColor="{Binding ContrastingTextColor}"
                   Padding="4,0" LineBreakMode="NoWrap" HorizontalTextAlignment="Center" HorizontalOptions="Center" />
            <Label Text="Tempo" Grid.Column="5" FontAttributes="Bold" FontSize="10" TextColor="{Binding ContrastingTextColor}"
                   Padding="4,0" LineBreakMode="NoWrap" HorizontalTextAlignment="Center" HorizontalOptions="Center" />
            <Label Text="Tempo CV" Grid.Column="6" FontAttributes="Bold" FontSize="10" TextColor="{Binding ContrastingTextColor}"
                   Padding="4,0" LineBreakMode="NoWrap" HorizontalTextAlignment="Center" HorizontalOptions="Center" />
            <Label Text="Instrument" Grid.Column="7" FontAttributes="Bold" FontSize="10" TextColor="{Binding ContrastingTextColor}"
                   Padding="4,0" LineBreakMode="NoWrap" HorizontalTextAlignment="Center" HorizontalOptions="Center" />
            <Label Text="Hi" Grid.Column="8" FontAttributes="Bold" FontSize="10" TextColor="{Binding ContrastingTextColor}"
                   Padding="4,0" LineBreakMode="NoWrap" HorizontalTextAlignment="Center" HorizontalOptions="Center" />
            <Label Text="Lo" Grid.Column="9" FontAttributes="Bold" FontSize="10" TextColor="{Binding ContrastingTextColor}"
                   Padding="4,0" LineBreakMode="NoWrap" HorizontalTextAlignment="Center" HorizontalOptions="Center" />
            <Label Text="Tempo SD" Grid.Column="10" FontAttributes="Bold" FontSize="10" TextColor="{Binding ContrastingTextColor}"
                   Padding="4,0" LineBreakMode="NoWrap" HorizontalTextAlignment="Center" HorizontalOptions="Center" />
          </Grid>

          <!-- Data rows (matching column widths) -->
          <ScrollView Orientation="Vertical" HeightRequest="240" IsVisible="{Binding IsSessionDatabase}">
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding SessionStats}">
              <BindableLayout.ItemTemplate>
                <DataTemplate>
                  <Grid Padding="0,0,0,0" HeightRequest="24">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="32" />
                      <ColumnDefinition Width="120" />
                      <ColumnDefinition Width="106" />
                      <ColumnDefinition Width="36" />
                      <ColumnDefinition Width="80" />
                      <ColumnDefinition Width="64" />
                      <ColumnDefinition Width="96" />
                      <ColumnDefinition Width="110" />
                      <ColumnDefinition Width="44" />
                      <ColumnDefinition Width="44" />
                      <ColumnDefinition Width="96" />
                    </Grid.ColumnDefinitions>

                    <Button Text="🗑" Grid.Column="0" WidthRequest="24" HeightRequest="24" Clicked="OnDeleteSessionStatClicked"
                            CommandParameter="{Binding Id}" BackgroundColor="#CC3333" TextColor="White" FontSize="10" Padding="0" CornerRadius="4" />
                    <Label Text="{Binding Dt, StringFormat='{0:yyyy-MM-dd HH:mm}'}" Grid.Column="1" FontSize="10" TextColor="{Binding ContrastingTextColor}"
                           LineBreakMode="NoWrap" Padding="2,0,0,0" HorizontalTextAlignment="Center" HorizontalOptions="Center" />
                    <Label Text="{Binding Sc}" Grid.Column="2" FontSize="10" TextColor="{Binding ContrastingTextColor}"
                           LineBreakMode="TailTruncation" Padding="2,0,0,0" HorizontalTextAlignment="Center" HorizontalOptions="Center" />
                    <Label Text="{Binding DisplayKey}" Grid.Column="3" FontSize="10" TextColor="{Binding ContrastingTextColor}"
                           Padding="2,0,0,0" HorizontalTextAlignment="Center" HorizontalOptions="Center" />
                    <Label Text="{Binding Pc, StringFormat='{0:F1}'}" Grid.Column="4" FontSize="10" TextColor="{Binding ContrastingTextColor}"
                           Padding="2,0,0,0" HorizontalTextAlignment="Center" HorizontalOptions="Center" />
                    <Label Text="{Binding Tp, StringFormat='{0:F1}'}" Grid.Column="5" FontSize="10" TextColor="{Binding ContrastingTextColor}"
                           Padding="2,0,0,0" HorizontalTextAlignment="Center" HorizontalOptions="Center" />
                    <Label Text="{Binding Cf, StringFormat='{}{0:F1}%'}" Grid.Column="6" FontSize="10" TextColor="{Binding ContrastingTextColor}"
                           Padding="2,0,0,0" HorizontalTextAlignment="Center" HorizontalOptions="Center" />
                    <Label Text="{Binding Instrument}" Grid.Column="7" FontSize="10" TextColor="{Binding ContrastingTextColor}"
                           LineBreakMode="TailTruncation" Padding="2,0,0,0" HorizontalTextAlignment="Center" HorizontalOptions="Center" />
                    <Label Text="{Binding Hi}" Grid.Column="8" FontSize="10" TextColor="{Binding ContrastingTextColor}"
                           Padding="2,0,0,0" HorizontalTextAlignment="Center" HorizontalOptions="Center" />
                    <Label Text="{Binding Lo}" Grid.Column="9" FontSize="10" TextColor="{Binding ContrastingTextColor}"
                           Padding="2,0,0,0" HorizontalTextAlignment="Center" HorizontalOptions="Center" />
                    <Label Text="{Binding Ts, StringFormat='{0:F1}'}" Grid.Column="10" FontSize="10" TextColor="{Binding ContrastingTextColor}"
                           Padding="2,0,0,0" HorizontalTextAlignment="Center" HorizontalOptions="Center" />
                  </Grid>
                </DataTemplate>
              </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
          </ScrollView>
        </VerticalStackLayout>
      </ScrollView>

    </VerticalStackLayout>

    <!-- Loading overlay: shown while data is being fetched -->
    <Grid IsVisible="{Binding IsLoading}"
          BackgroundColor="#99000000"
          VerticalOptions="Fill"
          HorizontalOptions="Fill">
      <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
        <ActivityIndicator IsRunning="{Binding IsLoading}"
                           Color="#8B4513"
                           WidthRequest="52"
                           HeightRequest="52" />
        <Label Text="Loading…"
               TextColor="White"
               HorizontalOptions="Center"
               FontSize="14"
               FontAttributes="Bold" />
      </VerticalStackLayout>
    </Grid>
  </Grid>
</ContentPage>
