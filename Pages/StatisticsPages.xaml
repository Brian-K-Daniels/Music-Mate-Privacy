<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="musicmate.Pages.StatisticsPages"
             x:Name="StatisticsPageRoot"
             Title="Statistics"
             Shell.NavBarIsVisible="True"
             BackgroundColor="{Binding PanelBackgroundColor}">
  <ContentPage.Resources>
    <Style x:Key="StatsLabelStyle" TargetType="Label">
      <Setter Property="TextColor" Value="{Binding ContrastingTextColor}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="TextColor" Value="white" />
      <Setter Property="BackgroundColor" Value="#8B4513" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="Margin" Value="4,4,4,4" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style TargetType="Border">
      <Setter Property="Stroke" Value="#8B4513" />
    </Style>
    <Style TargetType="Picker">
      <Setter Property="TextColor" Value="{Binding ContrastingTextColor}" />
      <Setter Property="BackgroundColor" Value="{Binding PanelBackgroundColor}" />
      <Setter Property="FontSize" Value="20" />
    </Style>
  </ContentPage.Resources>

  <Shell.TitleView>
    <Grid ColumnDefinitions="*,Auto" HeightRequest="30" VerticalOptions="Center" BackgroundColor="Transparent">
      <HorizontalStackLayout Spacing="10" VerticalOptions="Center" Grid.Column="0">
        <Button Text="←"
                Clicked="OnNavigateHomeClicked"
                BackgroundColor="Transparent"
                TextColor="white"
                FontSize="18"
                Padding="0"
                WidthRequest="32" />
        <Label Text="Statistics"
               TextColor="white"
               FontAttributes="Bold"
               FontSize="18"
               VerticalOptions="Center" />
      </HorizontalStackLayout>
      <Image Source="logo.png"
             HeightRequest="32"
             WidthRequest="32"
             VerticalOptions="Center"
             HorizontalOptions="End"
             Grid.Column="1" />
    </Grid>
  </Shell.TitleView>

  <VerticalStackLayout x:Name="StatisticsMainLayout" Spacing="16">
    <!-- Database Picker and Actions -->
    <ScrollView Orientation="Horizontal">
      <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
        <Label Text="Database:" FontSize="14" VerticalOptions="Center" TextColor="{Binding ContrastingTextColor}" />
        <Border StrokeThickness="2" StrokeShape="RoundRectangle 4" Padding="2,2,2,2" BackgroundColor="WhiteSmoke" WidthRequest="160">
          <Picker x:Name="DatabasePicker"
                  ItemsSource="{Binding DatabaseOptions}"
                  SelectedItem="{Binding SelectedDatabase, Mode=TwoWay}"
                  WidthRequest="150"
                  HeightRequest="40"
                  FontSize="12"
                  TextColor="{Binding ContrastingTextColor}" />
        </Border>
        <Button x:Name="ClearAllButton" Text="Clear All" Clicked="OnDeleteDataInSelectedDatabase" WidthRequest="120" />
        <Button x:Name="DeleteAllButton" Text="Delete Selected Database" Clicked="OnDeleteAllDataInSelectedDatabase" WidthRequest="200" IsVisible="True" />
      </HorizontalStackLayout>
    </ScrollView>

    <!-- Note Stats Table with fixed header -->
    <ScrollView Orientation="Horizontal">
      <VerticalStackLayout MinimumWidthRequest="480" Spacing="0">
        <Grid ColumnDefinitions="*,Auto" Padding="0" Margin="0,0,0,0" IsVisible="{Binding IsNoteDatabase}">
          <Grid Grid.Column="0" ColumnDefinitions="120,80,80,100,100" HeightRequest="28">
            <Label Text="Note" Grid.Column="0" FontSize="10" FontAttributes="Bold" TextColor="{Binding ContrastingTextColor}" />
            <Label Text="Correct" Grid.Column="1" FontSize="10" FontAttributes="Bold" TextColor="{Binding ContrastingTextColor}" />
            <Label Text="Wrong" Grid.Column="2" FontSize="10" FontAttributes="Bold" TextColor="{Binding ContrastingTextColor}" />
            <Label Text="% Correct" Grid.Column="3" FontSize="10" FontAttributes="Bold" TextColor="{Binding ContrastingTextColor}" />
            <Label Text="MsAvg" Grid.Column="4" FontSize="10" FontAttributes="Bold" TextColor="{Binding ContrastingTextColor}" />
          </Grid>
          <Label Grid.Column="1" Text="{Binding AverageWrong, StringFormat='Avg Wrong: {0:F1}'}" VerticalOptions="Center" HorizontalOptions="End" Margin="8,0,8,0" TextColor="{Binding ContrastingTextColor}" />
        </Grid>

        <ScrollView Orientation="Vertical" HeightRequest="240" IsVisible="{Binding IsNoteDatabase}">
          <VerticalStackLayout BindableLayout.ItemsSource="{Binding NoteStats}">
            <BindableLayout.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="120,80,80,100,100" Padding="0,0,0,0" HeightRequest="24">
                  <Label Text="{Binding WrittenName}" Grid.Column="0" FontSize="10" TextColor="{Binding ContrastingTextColor}" />
                  <Label Text="{Binding Correct}" Grid.Column="1" FontSize="10" TextColor="{Binding ContrastingTextColor}" />
                  <Label Text="{Binding Wrong}" Grid.Column="2" FontSize="10" TextColor="{Binding ContrastingTextColor}" />
                  <Label Text="{Binding PercentCorrect, StringFormat='{0:F1}'}" Grid.Column="3" FontSize="10" TextColor="{Binding ContrastingTextColor}" />
                  <Label Text="{Binding MsAverage, StringFormat='{0:F0}'}" Grid.Column="4" FontSize="10" TextColor="{Binding ContrastingTextColor}" />
                </Grid>
              </DataTemplate>
            </BindableLayout.ItemTemplate>
          </VerticalStackLayout>
        </ScrollView>
      </VerticalStackLayout>
    </ScrollView>

    <!-- Session Stats Table with fixed header -->
    <ScrollView Orientation="Horizontal">
      <VerticalStackLayout MinimumWidthRequest="964" Spacing="0">
        <Grid ColumnDefinitions="24,140,100,80,80,80,100,100,100,100,80,80" Padding="0" Margin="0" IsVisible="{Binding IsSessionDatabase}" >
          <Label Text="" Grid.Column="0" FontAttributes="Bold" FontSize="10" TextColor="{Binding ContrastingTextColor}" />
          <Label Text="Date" FontAttributes="Bold" Grid.Column="1" FontSize="10" TextColor="{Binding ContrastingTextColor}" />
          <Label Text="Tune" FontAttributes="Bold" Grid.Column="2" FontSize="10" TextColor="{Binding ContrastingTextColor}" />
          <Label Text="Key" FontAttributes="Bold" Grid.Column="3" FontSize="10" TextColor="{Binding ContrastingTextColor}" />
          <Label Text="Correct %" FontAttributes="Bold" Grid.Column="4" FontSize="10" TextColor="{Binding ContrastingTextColor}" />
          <Label Text="Tempo CV" FontAttributes="Bold" Grid.Column="5" FontSize="10" TextColor="{Binding ContrastingTextColor}" />
          <Label Text="Instrument" FontAttributes="Bold" Grid.Column="6" FontSize="10" TextColor="{Binding ContrastingTextColor}" />
          <Label Text="Scale" FontAttributes="Bold" Grid.Column="7" FontSize="10" TextColor="{Binding ContrastingTextColor}" />
          <Label Text="Hi" FontAttributes="Bold" Grid.Column="8" FontSize="10" TextColor="{Binding ContrastingTextColor}" />
          <Label Text="Lo" FontAttributes="Bold" Grid.Column="9" FontSize="10" TextColor="{Binding ContrastingTextColor}" />
          <Label Text="Tempo" FontAttributes="Bold" Grid.Column="10" FontSize="10" TextColor="{Binding ContrastingTextColor}" />
          <Label Text="Tempo SD" FontAttributes="Bold" Grid.Column="11" FontSize="10" TextColor="{Binding ContrastingTextColor}" />
        </Grid>

        <ScrollView Orientation="Vertical" HeightRequest="240" IsVisible="{Binding IsSessionDatabase}">
          <VerticalStackLayout BindableLayout.ItemsSource="{Binding SessionStats}">
            <BindableLayout.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="32,140,100,80,80,80,100,100,100,100,80,80" Padding="0,0,0,0" HeightRequest="24">
                  <Button Text="🗑" Grid.Column="0" WidthRequest="24" HeightRequest="24" Clicked="OnDeleteSessionStatClicked" CommandParameter="{Binding Id}" BackgroundColor="#CC3333" TextColor="White" FontSize="10" Padding="0" CornerRadius="4" />
                  <Label Text="{Binding Dt, StringFormat='{0:yyyy-MM-dd HH:mm}'}" Grid.Column="1" FontSize="10" TextColor="{Binding ContrastingTextColor}" />
                  <Label Text="{Binding Tune}" Grid.Column="2" FontSize="10" TextColor="{Binding ContrastingTextColor}" />
                  <Label Text="{Binding Key}" Grid.Column="3" FontSize="10" TextColor="{Binding ContrastingTextColor}" />
                  <Label Text="{Binding Pc, StringFormat='{0:F1}'}" Grid.Column="4" FontSize="10" TextColor="{Binding ContrastingTextColor}" />
                  <Label Text="{Binding Cf, StringFormat='{}{0:F1}%'}" Grid.Column="5" FontSize="10" TextColor="{Binding ContrastingTextColor}" />
                  <Label Text="{Binding Instrument}" Grid.Column="6" FontSize="10" TextColor="{Binding ContrastingTextColor}" />
                  <Label Text="{Binding Sc}" Grid.Column="7" FontSize="10" TextColor="{Binding ContrastingTextColor}" />
                  <Label Text="{Binding Hi}" Grid.Column="8" FontSize="10" TextColor="{Binding ContrastingTextColor}" />
                  <Label Text="{Binding Lo}" Grid.Column="9" FontSize="10" TextColor="{Binding ContrastingTextColor}" />
                  <Label Text="{Binding Tp, StringFormat='{0:F1}'}" Grid.Column="10" FontSize="10" TextColor="{Binding ContrastingTextColor}" />
                  <Label Text="{Binding Ts, StringFormat='{0:F1}'}" Grid.Column="11" FontSize="10" TextColor="{Binding ContrastingTextColor}" />
                </Grid>
              </DataTemplate>
            </BindableLayout.ItemTemplate>
          </VerticalStackLayout>
        </ScrollView>
      </VerticalStackLayout>
    </ScrollView>
  </VerticalStackLayout>
</ContentPage>
