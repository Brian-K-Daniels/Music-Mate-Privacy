<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:musicmate.Services"
             xmlns:controls="clr-namespace:musicmate.Controls"
             xmlns:converters="clr-namespace:musicmate.Converters"
             x:Class="musicmate.Pages.MainPage"
             x:DataType="services:NoteSessionService"
             x:Name="mainPage"
             Shell.NavBarIsVisible="True"
             Padding="0"
             BackgroundColor="#F7F7F7">

  <Shell.TitleView>
    <Grid ColumnDefinitions="Auto,*,Auto" HeightRequest="30" VerticalOptions="Center"
          BackgroundColor="#8B0000">
      <Label Text="Home  "
             TextColor="White"
             FontAttributes="Bold"
             FontSize="18"
             VerticalOptions="End"
             HorizontalOptions="Start"
             Grid.Column="0" />
      <Label x:Name="StatusLabelShell"
             Text="{Binding Source={x:Static services:StatusService.Instance}, Path=StatusMessage}"
             TextColor="Yellow"
             FontAttributes="Bold"
             FontSize="10"
             Margin="0,8,0,0"
             HorizontalOptions="Start"
             VerticalOptions="End"
             Grid.Column="1"/>
      <Image Source="logo.png"
             HeightRequest="32"
             WidthRequest="32"
             VerticalOptions="Center"
             HorizontalOptions="End"
             Grid.Column="2" />
    </Grid>
  </Shell.TitleView>

  <ContentPage.Resources>
    <Style x:Key="CompactBrownBox" TargetType="Border">
      <Setter Property="Background" Value="#8B4513" />
      <Setter Property="Stroke" Value="Black" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="StrokeShape">
        <Setter.Value>
          <RoundRectangle CornerRadius="8" />
        </Setter.Value>
      </Setter>
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="HeightRequest" Value="28" />
      <Setter Property="VerticalOptions" Value="Center" />
      <Setter Property="HorizontalOptions" Value="Center" />
    </Style>
    <Style x:Key="CompactBrownButton" TargetType="Button">
      <Setter Property="BackgroundColor" Value="#8B4513" />
      <Setter Property="TextColor" Value="White" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HeightRequest" Value="44" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="BorderColor" Value="Black" />
      <Setter Property="BorderWidth" Value="2" />
      <Setter Property="VerticalOptions" Value="Center" />
      <Setter Property="HorizontalOptions" Value="Center" />
    </Style>
    <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
  </ContentPage.Resources>

  <Grid>
    <ScrollView x:Name="MainScrollView" HorizontalScrollBarVisibility="Never" Padding="0,0
                ,0,0
                
                " Margin="0" HorizontalOptions="Fill">
      <VerticalStackLayout x:Name="MainPageMainLayout" Spacing="16" Padding="0" Margin="0" HorizontalOptions="Fill">

        <!-- Pickers row: Instrument | Key | (Concert E) | Scale+Tune picker -->
        <VerticalStackLayout x:Name="PickersContainer" Padding="0">
          <VerticalStackLayout.Margin>
            <OnPlatform x:TypeArguments="Thickness">
              <On Platform="WinUI"   Value="0,20,0,0" />
              <On Platform="Android" Value="0,0,0,0" />
            </OnPlatform>
          </VerticalStackLayout.Margin>
          <HorizontalStackLayout Spacing="6" VerticalOptions="Center" Margin="0,4,0,4">

            <!-- Instrument -->
            <Label Text="Instrument"
                   FontSize="11"
                   TextColor="#333333"
                   Margin="8,0,0,0"
                   VerticalOptions="Center" />
            <Border Style="{StaticResource CompactBrownBox}">
              <Grid WidthRequest="160">
                <Picker x:Name="InstrumentPicker"
                        SelectedIndexChanged="InstrumentPicker_SelectedIndexChanged"
                        Unfocused="InstrumentPicker_Unfocused"
                        HeightRequest="28"
                        FontSize="11"
                        TextColor="White"
                        BackgroundColor="#2C2C2C"
                        VerticalOptions="Fill"
                        HorizontalOptions="Fill"
                        IsEnabled="True"
                        InputTransparent="False"
                        IsVisible="{Binding Source={x:Reference mainPage}, Path=IsInstrumentPickerVisible}" />
                <Border BackgroundColor="White" Stroke="#8B4513" StrokeThickness="2"
                        StrokeShape="RoundRectangle 8"
                        Padding="8,2" HeightRequest="28"
                        VerticalOptions="Center" HorizontalOptions="Fill"
                        IsVisible="{Binding Source={x:Reference mainPage}, Path=IsInstrumentLabelVisible}">
                  <Label x:Name="InstrumentPickerOverlay"
                         Text="{Binding SelectedInstrumentShort, Source={x:Reference mainPage}}"
                         VerticalOptions="Center"
                         HorizontalOptions="Fill"
                         Padding="10,0"
                         FontSize="11"
                         TextColor="Black">
                    <Label.GestureRecognizers>
                      <TapGestureRecognizer Tapped="OnInstrumentLabelTapped" />
                    </Label.GestureRecognizers>
                  </Label>
                </Border>
              </Grid>
            </Border>

            <!-- Key (hidden in Tuner mode) -->
            <Label x:Name="KeyLabel"
                   Text="Key"
                   FontSize="11"
                   TextColor="#333333"
                   VerticalOptions="Center" />
            <Border x:Name="KeyBorder" Style="{StaticResource CompactBrownBox}">
              <Picker x:Name="KeyPicker"
                      WidthRequest="50"
                      HeightRequest="28"
                      FontSize="11"
                      TextColor="#000000"
                      BackgroundColor="White"
                      VerticalOptions="Fill"
                      HorizontalOptions="Fill" />
            </Border>

            <!-- Concert key e.g. "(Concert E)" (hidden in Tuner mode) -->
            <Label x:Name="ConcertKeyLabel"
                   FontSize="11"
                   TextColor="#333333"
                   VerticalOptions="Center" />

            <!-- Combined Scale / Tune picker -->
            <Border Style="{StaticResource CompactBrownBox}">
              <Picker x:Name="ScaleTunePicker"
                      WidthRequest="180"
                      HeightRequest="28"
                      FontSize="11"
                      TextColor="#000000"
                      BackgroundColor="White"
                      VerticalOptions="Fill"
                      HorizontalOptions="Fill" />
            </Border>

          </HorizontalStackLayout>
        </VerticalStackLayout>

        <!-- Staff area: control buttons + staff/tuner panel + color button -->
        <VerticalStackLayout Spacing="0" HorizontalOptions="Fill">
          <Grid ColumnDefinitions="*" HorizontalOptions="Fill">

            <!-- Staff panel and Tuner panel fill the full column -->
            <Grid Grid.Column="0">
              <!-- Selected Scale / Random mode (v1) -->
              <Border x:Name="StaffBorder"
                      Stroke="Green"
                      StrokeShape="RoundRectangle 8"
                      BackgroundColor="{Binding PanelBackgroundColor}"
                      Padding="0"
                      IsVisible="True"
                      VerticalOptions="Start">
                <GraphicsView x:Name="StaffGraphicsView"
                              BackgroundColor="{Binding PanelBackgroundColor}"
                              Margin="0"
                              VerticalOptions="Start"/>
              </Border>

              <!-- V2 measure display (shown when V2StaffMode is enabled) -->
              <Border x:Name="V2StaffBorder"
                      Stroke="DodgerBlue"
                      StrokeThickness="2"
                      StrokeShape="RoundRectangle 8"
                      BackgroundColor="{Binding PanelBackgroundColor}"
                      Padding="0"
                      IsVisible="False"
                      VerticalOptions="Start">
                <GraphicsView x:Name="V2StaffGraphicsView"
                              HeightRequest="120"
                              BackgroundColor="{Binding PanelBackgroundColor}"
                              Margin="0" />
              </Border>
              <!-- V2 mode label overlay (outside the border so it doesn't affect height) -->
              <Label x:Name="V2ModeBanner"
                     Text="V2 Staff Mode"
                     FontSize="10"
                     TextColor="DodgerBlue"
                     HorizontalOptions="End"
                     VerticalOptions="Start"
                     Margin="0,4,10,0"
                     IsVisible="False"
                     InputTransparent="True" />

              <!-- V3 two-staff display (shown when StaffDisplayMode is V3) -->
              <Border x:Name="V3StaffBorder"
                      Stroke="MediumPurple"
                      StrokeThickness="2"
                      StrokeShape="RoundRectangle 8"
                      BackgroundColor="{Binding PanelBackgroundColor}"
                      Padding="0"
                      IsVisible="False"
                      VerticalOptions="Start">
                <GraphicsView x:Name="V3StaffGraphicsView"
                              HeightRequest="240"
                              BackgroundColor="{Binding PanelBackgroundColor}"
                              Margin="0" />
              </Border>

              <!-- Tuner mode: staff canvas on left (wider), note/freq info on right -->
              <Grid x:Name="TunerGrid" ColumnDefinitions="3*,2*" IsVisible="False">
                <Border x:Name="TunerBorder"
                        Grid.Column="0"
                        Stroke="Green"
                        StrokeShape="RoundRectangle 8"
                        Padding="0"
                        VerticalOptions="Center">
                  <GraphicsView x:Name="TunerGraphicsView" HeightRequest="200" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Padding="8" Spacing="6"
                                     HorizontalOptions="Center" VerticalOptions="Center">
                  <Label Text="Tuner" FontSize="20" FontAttributes="Bold"
                         HorizontalOptions="Center" TextColor="#000000" />
                  <Label Text="{Binding TunerDisplay}" FontSize="40" FontAttributes="Bold"
                         HorizontalOptions="Center" TextColor="#000000" />
                  <Label Text="{Binding TunerLastDetectedFreq, StringFormat='Heard: {0:F2} Hz'}"
                         FontSize="13" HorizontalOptions="Center" TextColor="#000000" />
                  <Label Text="{Binding TunerLastNearestFreq, StringFormat='Nearest: {0:F2} Hz'}"
                         FontSize="13" HorizontalOptions="Center" TextColor="#000000" />
                </VerticalStackLayout>
              </Grid>
            </Grid>
          </Grid>

          <!-- Bottom row: Play | Stop/Start | Repeat/RepeatNew/RepeatSame | Background Color
               Equal column widths fill the full page width with matching end margins. -->
          <Grid x:Name="BottomButtonRow"
                Margin="12,8,12,8"
                ColumnSpacing="8"
                HorizontalOptions="Fill">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="64" />   <!-- Play -->
              <ColumnDefinition Width="64" />   <!-- Start/Stop -->
              <ColumnDefinition Width="*" />    <!-- Repeat / Repeat New -->
              <ColumnDefinition Width="*" />    <!-- (Repeat Same — hidden in Scale mode) -->
              <ColumnDefinition Width="Auto" /> <!-- Background Color — sizes to text -->
            </Grid.ColumnDefinitions>

            <!-- Play -->
            <Button x:Name="PlayEvaluateButton"
                    Grid.Column="0"
                    Text="▶"
                    FontSize="26"
                    TextColor="#00CC00"
                    BackgroundColor="#F7F7F7"
                    BorderColor="#F7F7F7"
                    BorderWidth="1"
                    CornerRadius="8"
                    HeightRequest="44"
                    MinimumHeightRequest="44"
                    Padding="0"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    Clicked="OnPlayEvaluateClicked" />

            <!-- Start/Stop -->
            <Button x:Name="StartStopButton"
                    Grid.Column="1"
                    Text="⏹"
                    FontSize="26"
                    TextColor="Green"
                    BackgroundColor="#F7F7F7"
                    BorderColor="#F7F7F7"
                    BorderWidth="1"
                    CornerRadius="8"
                    HeightRequest="44"
                    MinimumHeightRequest="44"
                    Padding="0"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    Clicked="OnStartStopToggleClicked" />

            <!-- Scale mode: single "Repeat" spans cols 2-3 -->
            <Button x:Name="AutoRepeatScaleButton"
                    Grid.Column="2"
                    Grid.ColumnSpan="2"
                    Text="Repeat"
                    Style="{StaticResource CompactBrownButton}"
                    HeightRequest="44"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    Clicked="OnAutoRepeatScaleClicked"
                    IsVisible="{Binding Source={x:Reference mainPage}, Path=IsScaleRepeatButtonVisible}" />

            <!-- Random mode: Repeat New (col 2) -->
            <Button x:Name="AutoRepeatNewButton"
                    Grid.Column="2"
                    Text="Repeat New"
                    Style="{StaticResource CompactBrownButton}"
                    HeightRequest="44"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    Clicked="OnAutoRepeatNewClicked"
                    IsVisible="{Binding Source={x:Reference mainPage}, Path=IsRandomRepeatButtonsVisible}" />

            <!-- Random mode: Repeat Same (col 3) -->
            <Button x:Name="AutoRepeatSameButton"
                    Grid.Column="3"
                    Text="Repeat Same"
                    Style="{StaticResource CompactBrownButton}"
                    HeightRequest="44"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    Clicked="OnAutoRepeatSameClicked"
                    IsVisible="{Binding Source={x:Reference mainPage}, Path=IsRandomRepeatButtonsVisible}" />

            <!-- Background Color (col 4) -->
            <Button Grid.Column="4"
                    Text="Background Color"
                    Style="{StaticResource CompactBrownButton}"
                    HeightRequest="44"
                    MinimumWidthRequest="140"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    IsVisible="{Binding Source={x:Reference mainPage}, Path=IsNotV3Mode}"
                    Clicked="OnColorButtonClicked" />

            <!-- V3 mode: compact pickers inline with Play/Stop buttons -->
            <HorizontalStackLayout x:Name="V3BottomPickersLayout"
                                   Grid.Column="2" Grid.ColumnSpan="3"
                                   Spacing="4" VerticalOptions="Center"
                                   IsVisible="{Binding Source={x:Reference mainPage}, Path=IsV3Mode}">
              <Label Text="Instrument " FontSize="10" TextColor="#333333" VerticalOptions="Center" Margin="2,0,0,0"/>
              <Border Style="{StaticResource CompactBrownBox}">
                <Picker x:Name="V3HomeInstrumentPicker"
                        WidthRequest="90" HeightRequest="28" FontSize="10"
                        TextColor="#000000" BackgroundColor="White"
                        VerticalOptions="Fill" HorizontalOptions="Fill"
                        SelectedIndexChanged="V3HomeInstrumentPicker_SelectedIndexChanged" />
              </Border>
              <Label Text="Key" FontSize="10" TextColor="#333333" VerticalOptions="Center"/>
              <Border Style="{StaticResource CompactBrownBox}">
                <Picker x:Name="V3HomeKeyPicker"
                        WidthRequest="50" HeightRequest="28" FontSize="10"
                        TextColor="#000000" BackgroundColor="White"
                        VerticalOptions="Fill" HorizontalOptions="Fill"
                        SelectedIndexChanged="V3HomeKeyPicker_SelectedIndexChanged" />
              </Border>
              <Label x:Name="V3HomeConcertKeyLabel" FontSize="10" TextColor="#333333" VerticalOptions="Center"/>
              <Border Style="{StaticResource CompactBrownBox}">
                <Picker x:Name="V3HomeScaleTunePicker"
                        WidthRequest="140" HeightRequest="28" FontSize="10"
                        TextColor="#000000" BackgroundColor="White"
                        VerticalOptions="Fill" HorizontalOptions="Fill"
                        SelectedIndexChanged="V3HomeScaleTunePickerChanged" />
              </Border>
            </HorizontalStackLayout>

          </Grid>
        </VerticalStackLayout>

      </VerticalStackLayout>
    </ScrollView>

    <!-- Color picker dialog overlay (full-page, above everything) -->
    <controls:ColorPickerDialog x:Name="ColorPickerDialog"
                                IsVisible="False" />
  </Grid>
</ContentPage>
