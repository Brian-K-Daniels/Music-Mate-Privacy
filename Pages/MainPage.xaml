<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:musicmate.Services"
             xmlns:controls="clr-namespace:musicmate.Controls"
             xmlns:converters="clr-namespace:musicmate.Converters"
             x:Class="musicmate.Pages.MainPage"
             x:DataType="services:NoteSessionService"
             x:Name="mainPage"
             Shell.NavBarIsVisible="True"
             Padding="0"
             BackgroundColor="#F7F7F7">

  <Shell.TitleView>
    <Grid ColumnDefinitions="Auto,*,Auto" HeightRequest="30" VerticalOptions="Center"
          BackgroundColor="#8B0000">
      <Label Text="Home  "
             TextColor="White"
             FontAttributes="Bold"
             FontSize="18"
             VerticalOptions="End"
             HorizontalOptions="Start"
             Grid.Column="0" />
      <Label x:Name="StatusLabelShell"
             Text="{Binding Source={x:Static services:StatusService.Instance}, Path=StatusMessage}"
             TextColor="Yellow"
             FontAttributes="Bold"
             FontSize="10"
             Margin="0,8,0,0"
             HorizontalOptions="Start"
             VerticalOptions="End"
             Grid.Column="1"/>
      <Image Source="logo.png"
             HeightRequest="32"
             WidthRequest="32"
             VerticalOptions="Center"
             HorizontalOptions="End"
             Grid.Column="2" />
    </Grid>
  </Shell.TitleView>

  <ContentPage.Resources>
    <Style x:Key="CompactBrownBox" TargetType="Border">
      <Setter Property="Background" Value="#8B4513" />
      <Setter Property="Stroke" Value="Black" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="StrokeShape">
        <Setter.Value>
          <RoundRectangle CornerRadius="8" />
        </Setter.Value>
      </Setter>
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="HeightRequest" Value="28" />
      <Setter Property="VerticalOptions" Value="Center" />
      <Setter Property="HorizontalOptions" Value="Center" />
    </Style>
    <Style x:Key="CompactBrownButton" TargetType="Button">
      <Setter Property="BackgroundColor" Value="#8B4513" />
      <Setter Property="TextColor" Value="White" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HeightRequest" Value="28" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="BorderColor" Value="Black" />
      <Setter Property="BorderWidth" Value="2" />
      <Setter Property="VerticalOptions" Value="Center" />
      <Setter Property="HorizontalOptions" Value="Center" />
    </Style>
    <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
  </ContentPage.Resources>

  <Grid>
    <ScrollView x:Name="MainScrollView" HorizontalScrollBarVisibility="Never" Padding="0" Margin="0" HorizontalOptions="Fill">
      <VerticalStackLayout x:Name="MainPageMainLayout" Spacing="16" Padding="0" Margin="0" HorizontalOptions="Fill">

        <!-- Pickers row: Instrument | Key | (Concert E) | Scale+Tune picker -->
        <VerticalStackLayout x:Name="PickersContainer" Padding="0" Margin="0">
          <HorizontalStackLayout Spacing="6" VerticalOptions="Center" Margin="0,4,0,4">

            <!-- Instrument -->
            <Label Text="Instrument"
                   FontSize="11"
                   TextColor="#333333"
                   VerticalOptions="Center" />
            <Border Style="{StaticResource CompactBrownBox}">
              <Grid WidthRequest="160">
                <Picker x:Name="InstrumentPicker"
                        SelectedIndexChanged="InstrumentPicker_SelectedIndexChanged"
                        Unfocused="InstrumentPicker_Unfocused"
                        HeightRequest="28"
                        FontSize="11"
                        TextColor="White"
                        BackgroundColor="#2C2C2C"
                        VerticalOptions="Fill"
                        HorizontalOptions="Fill"
                        IsEnabled="True"
                        InputTransparent="False"
                        IsVisible="{Binding Source={x:Reference mainPage}, Path=IsInstrumentPickerVisible}" />
                <Border BackgroundColor="White" Stroke="#8B4513" StrokeThickness="2"
                        StrokeShape="RoundRectangle 8"
                        Padding="8,2" HeightRequest="28"
                        VerticalOptions="Center" HorizontalOptions="Fill"
                        IsVisible="{Binding Source={x:Reference mainPage}, Path=IsInstrumentLabelVisible}">
                  <Label x:Name="InstrumentPickerOverlay"
                         Text="{Binding SelectedInstrumentShort, Source={x:Reference mainPage}}"
                         VerticalOptions="Center"
                         HorizontalOptions="Fill"
                         Padding="10,0"
                         FontSize="11"
                         TextColor="Black">
                    <Label.GestureRecognizers>
                      <TapGestureRecognizer Tapped="OnInstrumentLabelTapped" />
                    </Label.GestureRecognizers>
                  </Label>
                </Border>
              </Grid>
            </Border>

            <!-- Key (hidden in Tuner mode) -->
            <Label x:Name="KeyLabel"
                   Text="Key"
                   FontSize="11"
                   TextColor="#333333"
                   VerticalOptions="Center" />
            <Border x:Name="KeyBorder" Style="{StaticResource CompactBrownBox}">
              <Picker x:Name="KeyPicker"
                      WidthRequest="30"
                      HeightRequest="28"
                      FontSize="11"
                      TextColor="#000000"
                      BackgroundColor="White"
                      VerticalOptions="Fill"
                      HorizontalOptions="Fill" />
            </Border>

            <!-- Concert key e.g. "(Concert E)" (hidden in Tuner mode) -->
            <Label x:Name="ConcertKeyLabel"
                   FontSize="11"
                   TextColor="#333333"
                   VerticalOptions="Center" />

            <!-- Combined Scale / Tune picker -->
            <Border Style="{StaticResource CompactBrownBox}">
              <Picker x:Name="ScaleTunePicker"
                      WidthRequest="140"
                      HeightRequest="28"
                      FontSize="11"
                      TextColor="#000000"
                      BackgroundColor="White"
                      VerticalOptions="Fill"
                      HorizontalOptions="Fill" />
            </Border>

          </HorizontalStackLayout>
        </VerticalStackLayout>

        <!-- Staff area: control buttons + staff/tuner panel + color button -->
        <VerticalStackLayout Spacing="0" HorizontalOptions="Fill">
          <Grid ColumnDefinitions="*" HorizontalOptions="Fill">

            <!-- Staff panel and Tuner panel fill the full column -->
            <Grid Grid.Column="0">
              <!-- Selected Scale / Random mode -->
              <Border x:Name="StaffBorder"
                      Stroke="Green"
                      StrokeShape="RoundRectangle 8"
                      BackgroundColor="{Binding PanelBackgroundColor}"
                      Padding="0"
                      IsVisible="True"
                      VerticalOptions="Start">
                <GraphicsView x:Name="StaffGraphicsView"
                              BackgroundColor="{Binding PanelBackgroundColor}"
                              Margin="0"
                              VerticalOptions="Start"/>
              </Border>

              <!-- Tuner mode: staff canvas centred on left, note/freq info on right -->
              <Grid x:Name="TunerGrid" ColumnDefinitions="*,*" IsVisible="False">
                <Border x:Name="TunerBorder"
                        Grid.Column="0"
                        Stroke="Green"
                        StrokeShape="RoundRectangle 8"
                        Padding="0"
                        VerticalOptions="Center">
                  <GraphicsView x:Name="TunerGraphicsView" HeightRequest="200" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Padding="12" Spacing="8"
                                     HorizontalOptions="Center" VerticalOptions="Center">
                  <Label Text="Tuner" FontSize="24" FontAttributes="Bold"
                         HorizontalOptions="Center" TextColor="#000000" />
                  <Label Text="{Binding TunerDisplay}" FontSize="48" FontAttributes="Bold"
                         HorizontalOptions="Center" TextColor="#000000" />
                  <Label Text="{Binding TunerLastDetectedFreq, StringFormat='Heard: {0:F2} Hz'}"
                         FontSize="14" HorizontalOptions="Center" TextColor="#000000" />
                  <Label Text="{Binding TunerLastNearestFreq, StringFormat='Nearest: {0:F2} Hz'}"
                         FontSize="14" HorizontalOptions="Center" TextColor="#000000" />
                </VerticalStackLayout>
              </Grid>
            </Grid>
          </Grid>

          <!-- Bottom row: Play | Stop/Start | Repeat | Repeat New | Background Color -->
          <HorizontalStackLayout Spacing="6" HorizontalOptions="Start" Margin="16,8,0,0">

            <!-- Play (leftmost, 16px from screen edge via Margin on parent) -->
            <Label x:Name="PlayEvaluateButton"
                   Text="▶"
                   FontSize="24"
                   TextColor="#008000"
                   VerticalOptions="Center"
                   HorizontalOptions="Start"
                   Margin="0">
              <Label.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnPlayEvaluateClicked" />
              </Label.GestureRecognizers>
            </Label>

            <!-- Start/Stop -->
            <Label x:Name="StartStopButton"
                   Text="●"
                   FontSize="32"
                   TextColor="Green"
                   WidthRequest="36"
                   HeightRequest="36"
                   VerticalOptions="Center"
                   HorizontalOptions="Start"
                   Margin="0">
              <Label.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnStartStopToggleClicked" />
              </Label.GestureRecognizers>
            </Label>

            <!-- Scale mode: single "Repeat" button -->
            <Button x:Name="AutoRepeatScaleButton"
                    Text="Repeat"
                    Style="{StaticResource CompactBrownButton}"
                    WidthRequest="110"
                    MinimumWidthRequest="110"
                    MinimumHeightRequest="36"
                    Margin="4,0,4,0"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"
                    Clicked="OnAutoRepeatScaleClicked"
                    IsVisible="{Binding Source={x:Reference mainPage}, Path=IsScaleRepeatButtonVisible}" />

            <!-- Random mode: two buttons for "Repeat New" and "Repeat Same" -->
            <Button x:Name="AutoRepeatNewButton"
                    Text="Repeat New"
                    Style="{StaticResource CompactBrownButton}"
                    WidthRequest="110"
                    MinimumWidthRequest="110"
                    MinimumHeightRequest="36"
                    Margin="4,0,4,0"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"
                    Clicked="OnAutoRepeatNewClicked"
                    IsVisible="{Binding Source={x:Reference mainPage}, Path=IsRandomRepeatButtonsVisible}" />

            <Button x:Name="AutoRepeatSameButton"
                    Text="Repeat Same"
                    Style="{StaticResource CompactBrownButton}"
                    WidthRequest="110"
                    MinimumWidthRequest="110"
                    MinimumHeightRequest="36"
                    Margin="4,0,4,0"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"
                    Clicked="OnAutoRepeatSameClicked"
                    IsVisible="{Binding Source={x:Reference mainPage}, Path=IsRandomRepeatButtonsVisible}" />

            <Button Text="Background Color"
                    FontSize="10"
                    WidthRequest="200"
                    Style="{StaticResource CompactBrownButton}"
                    VerticalOptions="Center"
                    HorizontalOptions="Start"
                    Clicked="OnColorButtonClicked" />

          </HorizontalStackLayout>
        </VerticalStackLayout>

      </VerticalStackLayout>
    </ScrollView>

    <!-- Color picker dialog overlay (full-page, above everything) -->
    <controls:ColorPickerDialog x:Name="ColorPickerDialog"
                                IsVisible="False" />
  </Grid>
</ContentPage>
