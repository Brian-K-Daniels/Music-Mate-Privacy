<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:musicmate.Converters"
             x:Class="musicmate.Pages.AboutPage"
             x:Name="AboutPageRoot"
             Title="About"
             Shell.NavBarIsVisible="True"
             BackgroundColor="{Binding PanelBackgroundColor}">

  <ContentPage.Resources>
    <conv:BoolToYesNoConverter x:Key="BoolToYesNoConverter" />
    <Style TargetType="Label">
      <Setter Property="TextColor" Value="{Binding ContrastingTextColor}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="TextColor" Value="{Binding ContrastingTextColor}" />
      <Setter Property="BackgroundColor" Value="#8B4513" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontAttributes" Value="Bold" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style TargetType="Picker">
      <Setter Property="TextColor" Value="Black" />
      <Setter Property="BackgroundColor" Value="White" />
      <Setter Property="FontSize" Value="13" />
    </Style>
  </ContentPage.Resources>

  <Shell.TitleView>
    <Grid ColumnDefinitions="*,Auto" HeightRequest="30" VerticalOptions="Center">
      <HorizontalStackLayout Spacing="10" VerticalOptions="Center" Grid.Column="0">
        <Button Text="&#x2190;"
                Clicked="OnNavigateHomeClicked"
                BackgroundColor="Transparent"
                TextColor="White"
                FontSize="18"
                Padding="0"
                WidthRequest="32" />
        <Label Text="About"
               FontAttributes="Bold"
               FontSize="18"
               TextColor="White"
               VerticalOptions="Center" />
      </HorizontalStackLayout>
      <Image Source="logo.png"
             HeightRequest="32"
             WidthRequest="32"
             VerticalOptions="Center"
             HorizontalOptions="End"
             Grid.Column="1" />
    </Grid>
  </Shell.TitleView>

  <!-- Root: pinned toolbar at top, scrollable content fills the rest -->
  <Grid RowDefinitions="Auto,*">

    <!-- ── Pinned toolbar (never scrolls) ─────────────────────────────── -->
    <Grid Grid.Row="0"
          ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto"
          ColumnSpacing="6"
          Padding="8,4,8,4"
          VerticalOptions="Center"
          BackgroundColor="{Binding PanelBackgroundColor}">

      <!-- Font label -->
      <Label Grid.Column="0"
             Text="Font"
             FontSize="{Binding SelectedFontSize}"
             VerticalOptions="Center" />

      <!-- Font picker -->
      <Border Grid.Column="1"
              Stroke="#8B4513" StrokeThickness="2"
              BackgroundColor="Transparent" Padding="4,2"
              VerticalOptions="Center">
        <Picker x:Name="FontSizePicker"
                FontSize="{Binding SelectedFontSize}"
                ItemsSource="{Binding FontSizeOptions}"
                SelectedItem="{Binding SelectedFontSize, Mode=TwoWay}"
                VerticalOptions="Center" />
      </Border>

      <!-- Search icon -->
      <Label Grid.Column="2"
             Text="🔍"
             FontSize="{Binding SelectedFontSize}"
             TextColor="#8B4513"
             VerticalOptions="Center"
             Margin="4,0,2,0" />

      <!-- Search bar: fills remaining space -->
      <Border Grid.Column="3"
              Stroke="#8B4513" StrokeThickness="1"
              StrokeShape="RoundRectangle 8"
              Padding="4,0"
              VerticalOptions="Center">
        <SearchBar x:Name="AboutSearchBar"
                   Placeholder="Search About…"
                   TextColor="Black"
                   PlaceholderColor="#888888"
                   BackgroundColor="White"
                   HorizontalOptions="Fill"
                   FontSize="{Binding SelectedFontSize}"
                   TextChanged="OnAboutSearchTextChanged"
                   SearchButtonPressed="OnAboutSearchButtonPressed" />
      </Border>

      <!-- Next button -->
      <Button Grid.Column="4"
              x:Name="AboutFindNextButton"
              Text="Next"
              IsEnabled="False"
              Clicked="OnAboutFindNextClicked"
              FontSize="{Binding SelectedFontSize}"
              Padding="8,4"
              VerticalOptions="Center" />

      <!-- Match position label -->
      <Label Grid.Column="5"
             x:Name="AboutFindPositionLabel"
             Text=""
             FontSize="{Binding SelectedFontSize}"
             VerticalOptions="Center"
             HorizontalOptions="Center" />

    </Grid>

    <!-- ── Scrollable content ──────────────────────────────────────────── -->
    <ScrollView x:Name="AboutScrollView" Grid.Row="1">
      <VerticalStackLayout x:Name="AboutMainLayout">

        <!-- Premium purchase controls -->
        <Grid ColumnDefinitions="Auto,Auto,*"
              ColumnSpacing="10"
              VerticalOptions="Center"
              Padding="8,6,8,4">
          <Button Grid.Column="0"
                  Text="Get Premium"
                  Command="{Binding BuyPremiumCommand}"
                  TextColor="White"
                  FontSize="{Binding SelectedFontSize}"
                  Padding="8,4" />
          <Button Grid.Column="1"
                  Text="Restore"
                  Command="{Binding RestorePurchasesCommand}"
                  IsVisible="{Binding IsPremium}"
                  TextColor="White"
                  FontSize="{Binding SelectedFontSize}"
                  Padding="8,4" />
          <Label Grid.Column="2"
                 Text="Premium"
                 IsVisible="{Binding IsPremium}"
                 FontSize="{Binding SelectedFontSize}"
                 VerticalOptions="Center"
                 HorizontalOptions="End" />
        </Grid>

        <WebView x:Name="AboutWebView" Margin="0,4,0,0" />

      </VerticalStackLayout>
    </ScrollView>

  </Grid>

</ContentPage>
