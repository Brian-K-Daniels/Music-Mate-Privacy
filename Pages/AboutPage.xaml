<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:conv="clr-namespace:musicmate.Converters"
             x:Class="musicmate.Pages.AboutPage"
             x:Name="AboutPageRoot"
             Title="About"
             Shell.NavBarIsVisible="True"
             BackgroundColor="{Binding PanelBackgroundColor}">

  <ContentPage.Resources>
    <conv:BoolToYesNoConverter x:Key="BoolToYesNoConverter" />
    <Style TargetType="Label">
      <Setter Property="TextColor" Value="{Binding ContrastingTextColor}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="TextColor" Value="{Binding ContrastingTextColor}" />
      <Setter Property="BackgroundColor" Value="#8B4513" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontAttributes" Value="Bold" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style TargetType="Picker">
      <Setter Property="TextColor" Value="Black" />
      <Setter Property="BackgroundColor" Value="White" />
      <Setter Property="FontSize" Value="13" />
    </Style>
  </ContentPage.Resources>

  <Shell.TitleView>
    <Grid ColumnDefinitions="*,Auto" HeightRequest="30" VerticalOptions="Center">
      <HorizontalStackLayout Spacing="10" VerticalOptions="Center" Grid.Column="0">
        <Button Text="&#x2190;"
                Clicked="OnNavigateHomeClicked"
                BackgroundColor="Transparent"
                TextColor="White"
                FontSize="18"
                Padding="0"
                WidthRequest="32" />
        <Label Text="About"
               FontAttributes="Bold"
               FontSize="18"
               TextColor="White"
               VerticalOptions="Center" />
      </HorizontalStackLayout>
      <Image Source="logo.png"
             HeightRequest="32"
             WidthRequest="32"
             VerticalOptions="Center"
             HorizontalOptions="End"
             Grid.Column="1" />
    </Grid>
  </Shell.TitleView>

   <ScrollView x:Name="AboutScrollView">
     <VerticalStackLayout x:Name="AboutMainLayout">

      <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
        <Label Text="Font Size" FontSize="16" VerticalOptions="Center" />
        <Border Stroke="#8B4513" StrokeThickness="2" BackgroundColor="Transparent"
                Padding="8,4" MinimumHeightRequest="44" MinimumWidthRequest="80">
          <Picker x:Name="FontSizePicker"
                  FontSize="16"
                  ItemsSource="{Binding FontSizeOptions}"
                  SelectedItem="{Binding SelectedFontSize, Mode=TwoWay}"
                  VerticalOptions="Center" />
        </Border>
      </HorizontalStackLayout>

      <!-- Search field: type text to find and scroll to matching content in the About WebView -->
      <HorizontalStackLayout Spacing="8" Margin="0,6,0,6" VerticalOptions="Center">
        <!-- brown magnifier glyph -->
        <Label Text="🔍"
               FontSize="18"
               TextColor="#8B4513"
               VerticalOptions="Center"
               Margin="4,0" />

        <!-- thin brown outline around search box -->
        <Border Stroke="#8B4513" StrokeThickness="1" StrokeShape="RoundRectangle 6" Padding="2" VerticalOptions="Center" HorizontalOptions="FillAndExpand">
          <SearchBar x:Name="AboutSearchBar"
                     Placeholder="Search About..."
                     TextColor="{Binding ContrastingTextColor}"
                     PlaceholderColor="{Binding ContrastingTextColor}"
                     BackgroundColor="Transparent"
                     HorizontalOptions="FillAndExpand"
                     TextChanged="OnAboutSearchTextChanged"
                     SearchButtonPressed="OnAboutSearchButtonPressed" />
        </Border>

        <Button x:Name="AboutFindNextButton"
                Text="Next"
                IsEnabled="False"
                Clicked="OnAboutFindNextClicked"
                VerticalOptions="Center" />
        <Label x:Name="AboutFindPositionLabel"
               Text=""
               VerticalOptions="Center"
               HorizontalOptions="End" />
      </HorizontalStackLayout>

      <!-- Premium purchase controls -->
      <HorizontalStackLayout Spacing="10" VerticalOptions="Center" Padding="0,8,0,8">
        <Button Text="Get Premium"
                Command="{Binding BuyPremiumCommand}"
                TextColor="White"
                MinimumHeightRequest="44"
                Padding="12,8" />
        <Button Text="Restore"
                Command="{Binding RestorePurchasesCommand}"
                IsVisible="{Binding IsPremium}"
                TextColor="White"
                MinimumHeightRequest="44"
                Padding="12,8" />
        <Label Text="Premium"
               IsVisible="{Binding IsPremium}"
               VerticalOptions="Center" HorizontalOptions="EndAndExpand" />
      </HorizontalStackLayout>

      <WebView x:Name="AboutWebView"
               Margin="0,8,0,0" />

    </VerticalStackLayout>
  </ScrollView>

</ContentPage>
