<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="musicmate.Pages.ResetOptionsPage"
             Title="Settings Reset Options"
             Shell.NavBarIsVisible="True"
             BackgroundColor="{DynamicResource ThemePanelBackground}">

  <ContentPage.Resources>
    <Style TargetType="Label">
      <Setter Property="TextColor" Value="{DynamicResource ThemeContrastingText}" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="TextColor" Value="{DynamicResource ThemeButtonText}" />
      <Setter Property="BackgroundColor" Value="{DynamicResource ThemeButtonBackground}" />
      <Setter Property="BorderColor" Value="Black" />
      <Setter Property="BorderWidth" Value="2" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontAttributes" Value="Bold" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Margin" Value="0,6" />
    </Style>
  </ContentPage.Resources>

  <Shell.TitleView>
    <Grid ColumnDefinitions="*,Auto" HeightRequest="44" VerticalOptions="Center">
      <HorizontalStackLayout Spacing="10" VerticalOptions="Center" Grid.Column="0">
        <Button Text="←"
                Clicked="OnNavigatePracticeClicked"
                BackgroundColor="{DynamicResource ThemeButtonBackground}"
                TextColor="{DynamicResource ThemeButtonText}"
                FontSize="18"
                Padding="12,0"
                WidthRequest="56" />
        <!--TextColor="{DynamicResource ThemeContrastingText}"-->
        
        <Label Text="Settings Reset Options"
               TextColor="{DynamicResource ThemeContrastingText}"
               FontAttributes="Bold"
               FontSize="18"
               VerticalOptions="Center" />
      </HorizontalStackLayout>
      <Border Style="{StaticResource TitleLogoBorder}"
              VerticalOptions="Center"
              HorizontalOptions="End"
              Grid.Column="1">
        <Image Source="logo.png" Aspect="AspectFill" />
      </Border>
    </Grid>
  </Shell.TitleView>

  <ScrollView>
    <VerticalStackLayout Padding="16,8" Spacing="8">      

      <BoxView HeightRequest="1" Color="{DynamicResource ThemePickerBorder}" Margin="0,6,0,6" />

      <Button x:Name="FactoryResetButton"
              Text="Factory Defaults"
              BackgroundColor="White"
              TextColor="Black"
              Clicked="OnFactoryResetClicked" />

      <Button x:Name="SaveCustomDefaultsButton"
              Text="Make Custom Default Settings equal to Current Settings."
              Clicked="OnSaveCustomDefaultsClicked" />

      <Button x:Name="RestoreCustomDefaultsButton"
              Text="Custom Defaults"
              Clicked="OnRestoreCustomDefaultsClicked" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
