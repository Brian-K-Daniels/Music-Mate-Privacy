<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:musicmate.Controls"
             x:Class="musicmate.Pages.SettingsPage"
             Shell.NavBarIsVisible="True"
             BackgroundColor="{DynamicResource ThemePanelBackground}">

  <ContentPage.Resources>
    <Style TargetType="Label">
      <Setter Property="TextColor" Value="{DynamicResource ThemeContrastingText}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalOptions" Value="Center" />
    </Style>
    <Style x:Key="SliderStyle" TargetType="Slider">
      <Setter Property="ThumbColor" Value="{DynamicResource ThemeButtonBackground}" />
      <Setter Property="MinimumTrackColor" Value="{DynamicResource ThemeSlider}" />
      <Setter Property="MaximumTrackColor" Value="#CCCCCC" />
      <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="TextColor" Value="{DynamicResource ThemeButtonText}" />
      <Setter Property="BackgroundColor" Value="{DynamicResource ThemeButtonBackground}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="Margin" Value="4,2" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="SettingsPanelBorder" TargetType="Border">
      <Setter Property="Stroke" Value="{DynamicResource ThemePickerBorder}" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="BackgroundColor" Value="{DynamicResource ThemeSecondPanelBackground}" />
    </Style>
    <Style x:Key="SettingsPanelTitle" TargetType="Label">
      <Setter Property="FontAttributes" Value="Bold" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="TextColor" Value="{DynamicResource ThemeHeadingText}" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="SettingsPickerStyle" TargetType="Picker">
      <Setter Property="BackgroundColor" Value="{DynamicResource ThemePickerBackground}" />
      <Setter Property="TextColor" Value="{DynamicResource ThemePickerText}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="SettingsEntryStyle" TargetType="Entry">
      <Setter Property="BackgroundColor" Value="{DynamicResource ThemeEntryBackground}" />
      <Setter Property="TextColor" Value="{DynamicResource ThemeEntryText}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </ContentPage.Resources>

  <Shell.TitleView>
    <Grid ColumnDefinitions="*,Auto" HeightRequest="44" VerticalOptions="Center" BackgroundColor="Transparent">
      <HorizontalStackLayout Spacing="10" VerticalOptions="Center" Grid.Column="0">
        <Button Text="←"
                Clicked="OnNavigatePracticeClicked"
                BackgroundColor="{DynamicResource ThemeButtonBackground}"
                TextColor="{DynamicResource ThemeContrastingText}"
                FontSize="18"
                Padding="12,0"
                WidthRequest="56" />
        <Label Text="Settings"
               TextColor="{DynamicResource ThemeContrastingText}"
               FontAttributes="Bold"
               FontSize="18"
               VerticalOptions="Center" />
      </HorizontalStackLayout>
      <Border Style="{StaticResource TitleLogoBorder}"
              VerticalOptions="Center"
              HorizontalOptions="End"
              Grid.Column="1">
        <Image Source="logo.png" Aspect="AspectFill" />
      </Border>
    </Grid>
  </Shell.TitleView>

  <Grid>
    <ScrollView>
      <VerticalStackLayout Padding="8,6" Spacing="4">

        <!-- Display -->
        <Border Style="{StaticResource SettingsPanelBorder}">
          <Border.StrokeShape>
            <RoundRectangle CornerRadius="10"/>
          </Border.StrokeShape>
          <VerticalStackLayout Spacing="8">
            <Label Text="Display" Style="{StaticResource SettingsPanelTitle}" />
            <Button Text="Colors selection"
                    Clicked="OnColorsSelectionClicked"
                    HorizontalOptions="Fill" />
            <Grid ColumnDefinitions="170,*" ColumnSpacing="4" VerticalOptions="Center">
              <Label Grid.Column="0" Text="Show note names" />
              <Picker Grid.Column="1"
                      ItemsSource="{Binding NoteNameDisplayOptions}"
                      SelectedItem="{Binding NoteNameDisplay, Mode=TwoWay}"
                      Style="{StaticResource SettingsPickerStyle}" />
            </Grid>
            <Grid ColumnDefinitions="170,*" ColumnSpacing="4" VerticalOptions="Center">
              <Label Grid.Column="0" Text="Font used in About page" />
              <Picker Grid.Column="1"
                      ItemsSource="{Binding AboutFontSizeOptions}"
                      SelectedItem="{Binding AboutFontSize, Mode=TwoWay}"
                      Style="{StaticResource SettingsPickerStyle}" />
            </Grid>
          </VerticalStackLayout>
        </Border>

        <!-- Tempo -->
        <Border Style="{StaticResource SettingsPanelBorder}">
          <Border.StrokeShape>
            <RoundRectangle CornerRadius="10"/>
          </Border.StrokeShape>
          <VerticalStackLayout Spacing="8">
            <Label Text="Tempo" Style="{StaticResource SettingsPanelTitle}" />
            <Grid ColumnDefinitions="170,*,44" ColumnSpacing="4" VerticalOptions="Center">
              <Label Grid.Column="0" Text="BPM" />
              <Slider Grid.Column="1"
                      Minimum="{Binding MinTempo}"
                      Maximum="{Binding MaxTempo}"
                      Value="{Binding Tempo, Mode=TwoWay}"
                      Style="{StaticResource SliderStyle}" />
              <Label Grid.Column="2" Text="{Binding Tempo}"
                     HorizontalTextAlignment="End" />
            </Grid>
          </VerticalStackLayout>
        </Border>

        <!-- Music -->
        <Border Style="{StaticResource SettingsPanelBorder}">
          <Border.StrokeShape>
            <RoundRectangle CornerRadius="10"/>
          </Border.StrokeShape>
          <VerticalStackLayout Spacing="8">
            <Label Text="Music" Style="{StaticResource SettingsPanelTitle}" />
            <Grid ColumnDefinitions="170,*,44" ColumnSpacing="4" VerticalOptions="Center">
              <Label Grid.Column="0" Text="Accidental %" />
              <Slider Grid.Column="1" Minimum="0" Maximum="100"
                      Value="{Binding AccidentalPercent, Mode=TwoWay}"
                      Style="{StaticResource SliderStyle}"
                      DragCompleted="OnAccidentalPercentDragCompleted" />
              <Label Grid.Column="2" Text="{Binding AccidentalPercent}"
                     HorizontalTextAlignment="End" />
            </Grid>
            <Grid ColumnDefinitions="170,*" ColumnSpacing="4" VerticalOptions="Center">
              <Label Grid.Column="0" Text="Lowest note" />
              <Picker x:Name="LowestNotePicker"
                      Grid.Column="1"
                      ItemsSource="{Binding WhiteKeyNoteNames}"
                      SelectedItem="{Binding LowestNote, Mode=TwoWay}"
                      Style="{StaticResource SettingsPickerStyle}" />
            </Grid>
            <Grid ColumnDefinitions="170,*" ColumnSpacing="4" VerticalOptions="Center">
              <Label Grid.Column="0" Text="Highest note" />
              <Picker x:Name="HighestNotePicker"
                      Grid.Column="1"
                      ItemsSource="{Binding WhiteKeyNoteNames}"
                      SelectedItem="{Binding HighestNote, Mode=TwoWay}"
                      Style="{StaticResource SettingsPickerStyle}" />
            </Grid>
            <Grid ColumnDefinitions="170,*" ColumnSpacing="4" VerticalOptions="Center">
              <Label Grid.Column="0" Text="Rhythm mode" />
              <Picker Grid.Column="1"
                      ItemsSource="{Binding RhythmModeOptions}"
                      SelectedItem="{Binding RhythmMode, Mode=TwoWay}"
                      Style="{StaticResource SettingsPickerStyle}" />
            </Grid>
            <Grid ColumnDefinitions="170,*" ColumnSpacing="4" VerticalOptions="Center">
              <Label Grid.Column="0" Text="Smallest note" />
              <Picker Grid.Column="1"
                      ItemsSource="{Binding SmallestRhythmNoteOptions}"
                      SelectedItem="{Binding SmallestRhythmNote, Mode=TwoWay}"
                      Style="{StaticResource SettingsPickerStyle}" />
            </Grid>
            <Grid ColumnDefinitions="170,*" ColumnSpacing="4" VerticalOptions="Center">
              <Label Grid.Column="0" Text="Syncopation" />
              <Picker Grid.Column="1"
                      ItemsSource="{Binding SyncopationSettingOptions}"
                      SelectedItem="{Binding SyncopationSetting, Mode=TwoWay}"
                      Style="{StaticResource SettingsPickerStyle}" />
            </Grid>
            <Grid ColumnDefinitions="170,*" ColumnSpacing="4" VerticalOptions="Center">
              <Label Grid.Column="0" Text="Time signature" />
              <Picker Grid.Column="1"
                      ItemsSource="{Binding MeterTimeSignatureOptions}"
                      SelectedItem="{Binding MeterTimeSignature, Mode=TwoWay}"
                      Style="{StaticResource SettingsPickerStyle}" />
            </Grid>
          </VerticalStackLayout>
        </Border>

        <!-- Action switches -->
        <Border Style="{StaticResource SettingsPanelBorder}">
          <Border.StrokeShape>
            <RoundRectangle CornerRadius="10"/>
          </Border.StrokeShape>
          <VerticalStackLayout Spacing="8">
            <Label Text="Action switches" Style="{StaticResource SettingsPanelTitle}" />
            
            <Grid ColumnDefinitions="200,*,60" ColumnSpacing="4" VerticalOptions="Center">
              <Label Grid.Column="0" Text="Listening starts when music appears." />
              <Switch Grid.Column="1" IsToggled="{Binding AutoStart, Mode=TwoWay}"
                      OnColor="{DynamicResource ThemeSlider}" HorizontalOptions="End" />
            </Grid>
            
            <Grid ColumnDefinitions="200,*,60" ColumnSpacing="4" VerticalOptions="Center">
              <Label Grid.Column="0" Text="Show Conductor Cues" />
              <Switch Grid.Column="1" IsToggled="{Binding ShowConductorCues, Mode=TwoWay}"
                      OnColor="{DynamicResource ThemeSlider}" HorizontalOptions="End" />
            </Grid>
            
            <Grid ColumnDefinitions="200,*,60" ColumnSpacing="4" VerticalOptions="Center">
              <Label Grid.Column="0" Text="Number of latest attempts per note to keep" LineBreakMode="WordWrap" />
              <Slider Grid.Column="1" Minimum="0" Maximum="1000"
                      Value="{Binding MaxAttemptsPerNote, Mode=TwoWay}"
                      Style="{StaticResource SliderStyle}" />
              <Label Grid.Column="2" Text="{Binding MaxAttemptsPerNote, StringFormat='{0:F0}'}"
                     HorizontalTextAlignment="End" />
            </Grid>
            <Grid ColumnDefinitions="200,*,60" ColumnSpacing="4" VerticalOptions="Center">
              <Label Grid.Column="0" Text="Collect session statistics" />
              <Switch Grid.Column="1" IsToggled="{Binding CollectSessionStats, Mode=TwoWay}"
                      OnColor="{DynamicResource ThemeSlider}" HorizontalOptions="End" />
            </Grid>
          </VerticalStackLayout>
        </Border>

        <!-- Mastery of notes -->
        <Border Style="{StaticResource SettingsPanelBorder}">
          <Border.StrokeShape>
            <RoundRectangle CornerRadius="10"/>
          </Border.StrokeShape>
          <VerticalStackLayout Spacing="8">
            <Label Text="Mastery of notes" Style="{StaticResource SettingsPanelTitle}" />
            <Grid ColumnDefinitions="170,*" ColumnSpacing="4" VerticalOptions="Center">
              <Label Grid.Column="0" Text="Method" />
              <Picker Grid.Column="1"
                      ItemsSource="{Binding MasteredMethodOptions}"
                      SelectedItem="{Binding MasteredMethod, Mode=TwoWay}"
                      Style="{StaticResource SettingsPickerStyle}" />
            </Grid>
            <Grid ColumnDefinitions="170,*,44" ColumnSpacing="4" VerticalOptions="Center"
                  IsVisible="{Binding IsPercentCorrectMethod}">
              <Label Grid.Column="0" Text="Minimum correct count" />
              <Slider Grid.Column="1" Minimum="1" Maximum="20"
                      Value="{Binding MinCorrectCount, Mode=TwoWay}"
                      Style="{StaticResource SliderStyle}" />
              <Label Grid.Column="2" Text="{Binding MinCorrectCount}"
                     HorizontalTextAlignment="End" />
            </Grid>
            <Grid ColumnDefinitions="170,*,44" ColumnSpacing="4" VerticalOptions="Center">
              <Label Grid.Column="0" Text="{Binding OmitSliderLabel}" />
              <Slider x:Name="OmitThresholdSlider"
                      Grid.Column="1"
                      Minimum="{Binding OmitSliderMin}"
                      Maximum="{Binding OmitSliderMax}"
                      Value="{Binding OmitSliderValue, Mode=TwoWay}"
                      Style="{StaticResource SliderStyle}" />
              <Label Grid.Column="2" Text="{Binding OmitSliderValue, StringFormat='{0:F0}'}"
                     HorizontalTextAlignment="End" />
            </Grid>
            <Grid ColumnDefinitions="170,*,44" ColumnSpacing="4" VerticalOptions="Center"
                  IsVisible="{Binding IsPercentCorrectMethod}">
              <Label Grid.Column="0" Text="Omit below MsAvg" />
              <Slider Grid.Column="1" Minimum="0" Maximum="5000"
                      Value="{Binding OmitMsAvgThreshold, Mode=TwoWay}"
                      Style="{StaticResource SliderStyle}" />
              <Label Grid.Column="2" Text="{Binding OmitMsAvgThreshold}"
                     HorizontalTextAlignment="End" LineBreakMode="NoWrap" />
            </Grid>
          </VerticalStackLayout>
        </Border>

      </VerticalStackLayout>
    </ScrollView>

    <controls:ColorPickerDialog x:Name="ColorPickerDialog" IsVisible="False" />
  </Grid>
</ContentPage>
