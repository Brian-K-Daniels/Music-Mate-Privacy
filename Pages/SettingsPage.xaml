<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="musicmate.Pages.SettingsPage"
             Shell.NavBarIsVisible="True"
             BackgroundColor="{Binding PanelBackgroundColor}">

  <ContentPage.Resources>
    <Style TargetType="Label">
      <Setter Property="TextColor" Value="{Binding ContrastingTextColor}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="VerticalOptions" Value="Center" />
    </Style>
    <Style x:Key="SliderStyle" TargetType="Slider">
      <Setter Property="ThumbColor" Value="#8B4513" />
      <Setter Property="MinimumTrackColor" Value="#8B4513" />
      <Setter Property="MaximumTrackColor" Value="#CCCCCC" />
      <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="TextColor" Value="White" />
      <Setter Property="BackgroundColor" Value="#8B4513" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="Margin" Value="4,2" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </ContentPage.Resources>

  <Shell.TitleView>
    <Grid ColumnDefinitions="*,Auto" HeightRequest="30" VerticalOptions="Center" BackgroundColor="Transparent">
      <HorizontalStackLayout Spacing="10" VerticalOptions="Center" Grid.Column="0">
        <Button Text="←"
                Clicked="OnNavigatePracticeClicked"
                BackgroundColor="Transparent"
                TextColor="White"
                FontSize="18"
                Padding="12,0"
                WidthRequest="56" />
        <Label Text="Settings"
               TextColor="White"
               FontAttributes="Bold"
               FontSize="18"
               VerticalOptions="Center" />
      </HorizontalStackLayout>
      <Border Style="{StaticResource TitleLogoBorder}"
              VerticalOptions="Center"
              HorizontalOptions="End"
              Grid.Column="1">
        <Image Source="logo.png" Aspect="AspectFill" />
      </Border>
    </Grid>
  </Shell.TitleView>

  <ScrollView>
    <VerticalStackLayout Padding="8,6" Spacing="6">

      <!-- ── Note Range: automatically generated from Instrument + Level ────────── -->
      <Grid ColumnDefinitions="170,*,Auto,Auto" ColumnSpacing="4" VerticalOptions="Center">
        <Label Grid.Column="0" Text="Note Range" FontAttributes="Bold" FontSize="13" />
        <Label Grid.Column="1"
               Text="{Binding AutomaticNoteRangeDisplay}"
               FontAttributes="Bold"
               HorizontalTextAlignment="Start" />
        <Label Grid.Column="2" Text="Mastered" VerticalOptions="Center" />
        <Picker Grid.Column="3"
                WidthRequest="100"
                ItemsSource="{Binding MasteredMethodOptions}"
                SelectedItem="{Binding MasteredMethod, Mode=TwoWay}"
                TextColor="Black" BackgroundColor="White" FontSize="12" />
      </Grid>

      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto"
            ColumnSpacing="4"
            VerticalOptions="Center"
            IsVisible="False">
        <Label Grid.Column="0" Text="Note Range" FontAttributes="Bold" FontSize="13" />
        <Label Grid.Column="1" Text="Low" HorizontalTextAlignment="End"/>
        <Picker x:Name="LowestNotePicker"
                Grid.Column="2"
                WidthRequest="60"
                ItemsSource="{Binding WhiteKeyNoteNames}"
                SelectedItem="{Binding LowestNote, Mode=TwoWay}"
                TextColor="Black" BackgroundColor="White" FontSize="12" />
        <Label Grid.Column="3" Text="High" />
        <Picker x:Name="HighestNotePicker"
                Grid.Column="4"
                WidthRequest="60"
                ItemsSource="{Binding WhiteKeyNoteNames}"
                SelectedItem="{Binding HighestNote, Mode=TwoWay}"
                TextColor="Black" BackgroundColor="White" FontSize="12" />
        <Label Grid.Column="5" />
        <Label Grid.Column="6" Text="Mastered" VerticalOptions="Center" />
        <Picker Grid.Column="7"
                WidthRequest="100"
                ItemsSource="{Binding MasteredMethodOptions}"
                SelectedItem="{Binding MasteredMethod, Mode=TwoWay}"
                TextColor="Black" BackgroundColor="White" FontSize="12" />
      </Grid>

      <!-- ── Slider rows: label | slider(fills) | value ───────────────── -->

      <Grid ColumnDefinitions="170,*,44" ColumnSpacing="4" VerticalOptions="Center">
        <Label Grid.Column="0" Text="Playback BPM" />
        <Slider Grid.Column="1" Minimum="30" Maximum="200"
                Value="{Binding PlaybackBpm, Mode=TwoWay}"
                Style="{StaticResource SliderStyle}" />
        <Label Grid.Column="2" Text="{Binding PlaybackBpm}"
               HorizontalTextAlignment="End" />
      </Grid>

      <Grid ColumnDefinitions="170,*,44" ColumnSpacing="4" VerticalOptions="Center">
        <Label Grid.Column="0" Text="Music BPM" />
        <Slider Grid.Column="1" Minimum="30" Maximum="200"
                Value="{Binding MusicBpm, Mode=TwoWay}"
                Style="{StaticResource SliderStyle}" />
        <Label Grid.Column="2" Text="{Binding MusicBpm}"
               HorizontalTextAlignment="End" />
      </Grid>

      <!-- Accidental % -->
      <Grid ColumnDefinitions="170,*,44" ColumnSpacing="4" VerticalOptions="Center">
        <Label Grid.Column="0" Text="Accidental %" />
        <Slider Grid.Column="1" Minimum="0" Maximum="100"
                Value="{Binding AccidentalPercent, Mode=TwoWay}"
                Style="{StaticResource SliderStyle}"
                DragCompleted="OnAccidentalPercentDragCompleted" />
        <Label Grid.Column="2" Text="{Binding AccidentalPercent}"
               HorizontalTextAlignment="End" />
      </Grid>

      <!-- Omit threshold (label and range change based on MasteredMethod) -->
      <Grid ColumnDefinitions="170,*,44" ColumnSpacing="4" VerticalOptions="Center">
        <Label Grid.Column="0" Text="{Binding OmitSliderLabel}" />
        <Slider x:Name="OmitThresholdSlider"
                Grid.Column="1"
                Minimum="{Binding OmitSliderMin}"
                Maximum="{Binding OmitSliderMax}"
                Value="{Binding OmitSliderValue, Mode=TwoWay}"
                Style="{StaticResource SliderStyle}" />
        <Label Grid.Column="2" Text="{Binding OmitSliderValue, StringFormat='{0:F0}'}"
               HorizontalTextAlignment="End" />
      </Grid>

      <!-- Min correct count (hidden when MasteredMethod=Streak) -->
      <Grid ColumnDefinitions="170,*,44" ColumnSpacing="4" VerticalOptions="Center"
            IsVisible="{Binding IsPercentCorrectMethod}">
        <Label Grid.Column="0" Text="Min correct count" />
        <Slider Grid.Column="1" Minimum="1" Maximum="20"
                Value="{Binding MinCorrectCount, Mode=TwoWay}"
                Style="{StaticResource SliderStyle}" />
        <Label Grid.Column="2" Text="{Binding MinCorrectCount}"
               HorizontalTextAlignment="End" />
      </Grid>

      <!-- Omit below MsAvg (hidden when MasteredMethod=Streak) -->
      <Grid ColumnDefinitions="170,*,44" ColumnSpacing="4" VerticalOptions="Center"
            IsVisible="{Binding IsPercentCorrectMethod}">
        <Label Grid.Column="0" Text="Omit below MsAvg" />
        <Slider Grid.Column="1" Minimum="0" Maximum="5000"
                Value="{Binding OmitMsAvgThreshold, Mode=TwoWay}"
                Style="{StaticResource SliderStyle}" />
        <Label Grid.Column="2" Text="{Binding OmitMsAvgThreshold}"
               HorizontalTextAlignment="End" LineBreakMode="NoWrap" />
      </Grid>

      <!-- ── Auto Start (toggle row) ──────────────────────────────────── -->
      <Grid ColumnDefinitions="250,Auto" ColumnSpacing="4">
        <Label Grid.Column="0" Text="Auto start on appear" />
        <Switch Grid.Column="1" IsToggled="{Binding AutoStart, Mode=TwoWay}"
                OnColor="#8B4513" HorizontalOptions="End" />
      </Grid>

      <!-- ── Statistics Collection ────────────────────────────────────── -->
      <BoxView HeightRequest="1" Color="#8B4513" Margin="0,4,0,2" />
      <Label Text="Statistics" FontAttributes="Bold" FontSize="13" />

      <Grid ColumnDefinitions="250,Auto" ColumnSpacing="4">
        <Label Grid.Column="0" Text="Collect Note Statistics" />
        <Switch Grid.Column="1" IsToggled="{Binding CollectNoteStats, Mode=TwoWay}"
                OnColor="#8B4513" HorizontalOptions="End" />
      </Grid>

      <Grid ColumnDefinitions="250,Auto" ColumnSpacing="4">
        <Label Grid.Column="0" Text="Collect Session Statistics" />
        <Switch Grid.Column="1" IsToggled="{Binding CollectSessionStats, Mode=TwoWay}"
                OnColor="#8B4513" HorizontalOptions="End" />
      </Grid>

      <!-- Max attempts kept per note (rolling window) -->
      <Grid ColumnDefinitions="200,*,60" ColumnSpacing="4" VerticalOptions="Center">
        <Label Grid.Column="0" Text="Attempts kept per note" />
        <Slider Grid.Column="1" Minimum="10" Maximum="1000"
                Value="{Binding MaxAttemptsPerNote, Mode=TwoWay}"
                Style="{StaticResource SliderStyle}" />
        <Label Grid.Column="2" Text="{Binding MaxAttemptsPerNote, StringFormat='{0:F0}'}"
               HorizontalTextAlignment="End" />
      </Grid>

    

      <!-- Memory usage info -->
      <Label Text="{Binding MemoryUsageDisplay}" FontSize="12" FontAttributes="Bold" Margin="0,2,0,4" />

      <!-- Max Session DB size -->
      <Grid ColumnDefinitions="200,*,60" ColumnSpacing="4" VerticalOptions="Center">
        <Label Grid.Column="0" Text="Max Session DB (MB)" />
        <Slider Grid.Column="1" Minimum="10"
                Maximum="{Binding AvailableStorageMb}"
                Value="{Binding MaxSessionDbSizeMb, Mode=TwoWay}"
                Style="{StaticResource SliderStyle}" />
        <Label Grid.Column="2" Text="{Binding MaxSessionDbSizeMb, StringFormat='{0:F0}'}"
               HorizontalTextAlignment="End" />
      </Grid>

      <!-- ── Rhythm settings ────────────────────────────────────── -->
      <BoxView HeightRequest="1" Color="#8B4513" Margin="0,4,0,2" />
      <Label Text="Rhythm Settings" FontAttributes="Bold" FontSize="13" />

      <Grid ColumnDefinitions="170,*" ColumnSpacing="4" VerticalOptions="Center">
        <Label Grid.Column="0" Text="Time signature" />
        <Picker Grid.Column="1"
                ItemsSource="{Binding MeterTimeSignatureOptions}"
                SelectedItem="{Binding MeterTimeSignature, Mode=TwoWay}"
                TextColor="Black" BackgroundColor="White" FontSize="12" />
      </Grid>

      <Grid ColumnDefinitions="170,*" ColumnSpacing="4" VerticalOptions="Center">
        <Label Grid.Column="0" Text="Smallest note" />
        <Picker Grid.Column="1"
                ItemsSource="{Binding SmallestRhythmNoteOptions}"
                SelectedItem="{Binding SmallestRhythmNote, Mode=TwoWay}"
                TextColor="Black" BackgroundColor="White" FontSize="12" />
      </Grid>

      <Grid ColumnDefinitions="170,*" ColumnSpacing="4" VerticalOptions="Center">
        <Label Grid.Column="0" Text="Rhythm mode" />
        <Picker Grid.Column="1"
                ItemsSource="{Binding RhythmModeOptions}"
                SelectedItem="{Binding RhythmMode, Mode=TwoWay}"
                TextColor="Black" BackgroundColor="White" FontSize="12" />
      </Grid>

      <Grid ColumnDefinitions="170,*" ColumnSpacing="4" VerticalOptions="Center">
        <Label Grid.Column="0" Text="Syncopation" />
        <Picker Grid.Column="1"
                ItemsSource="{Binding SyncopationSettingOptions}"
                SelectedItem="{Binding SyncopationSetting, Mode=TwoWay}"
                TextColor="Black" BackgroundColor="White" FontSize="12" />
      </Grid>

      <Grid ColumnDefinitions="170,*" ColumnSpacing="4" VerticalOptions="Center">
        <Label Grid.Column="0" Text="Show note names" />
        <Picker Grid.Column="1"
                ItemsSource="{Binding NoteNameDisplayOptions}"
                SelectedItem="{Binding NoteNameDisplay, Mode=TwoWay}"
                TextColor="Black" BackgroundColor="White" FontSize="12" />
      </Grid>

    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
