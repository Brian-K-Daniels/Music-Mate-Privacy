<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:musicmate.Services"
             xmlns:controls="clr-namespace:musicmate.Controls"
             xmlns:converters="clr-namespace:musicmate.Converters"
             x:Class="musicmate.Pages.WhatToPlayPage"
             x:Name="whatToPlayPage"
             Shell.NavBarIsVisible="True"
             Padding="0"             
             BackgroundColor="{Binding Source={x:Reference whatToPlayPage}, Path=PanelBackgroundColor}">
  <!--BackgroundColor="#F7F7F7"> -->

  <Shell.TitleView>
    <Grid ColumnDefinitions="*,Auto" HeightRequest="30" VerticalOptions="Center" BackgroundColor="Transparent">
      <HorizontalStackLayout Spacing="10" VerticalOptions="Center" Grid.Column="0">
        <Button Text="←"
                Clicked="OnNavigateHomeClicked"
                BackgroundColor="Transparent"
                TextColor="White"
                FontSize="18"
                Padding="12,0"
                WidthRequest="56" />
        <Label Text="What to Play"
               TextColor="White"
               FontAttributes="Bold"
               FontSize="18"
               VerticalOptions="Center" />
        <Label x:Name="StatusLabel"
               Text="{Binding Source={x:Static services:StatusService.Instance}, Path=StatusMessage}"
               TextColor="Yellow"
               FontAttributes="Bold"
               FontSize="10"
               Margin="8,0,0,0"
               VerticalOptions="Center" />
      </HorizontalStackLayout>
      <Image Source="logo.png"
             HeightRequest="32" WidthRequest="32"
             VerticalOptions="Center" HorizontalOptions="End"
             Grid.Column="1" />
    </Grid>
  </Shell.TitleView>

  <ContentPage.Resources>
    <Style x:Key="WtpBrownBox" TargetType="Border">
      <Setter Property="Background" Value="#8B4513" />
      <Setter Property="Stroke" Value="Black" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="StrokeShape">
        <Setter.Value>
          <RoundRectangle CornerRadius="8" />
        </Setter.Value>
      </Setter>
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="HeightRequest" Value="28" />
      <Setter Property="VerticalOptions" Value="Center" />
      <Setter Property="HorizontalOptions" Value="Center" />
    </Style>
    <Style x:Key="WtpBrownButton" TargetType="Button">
      <Setter Property="BackgroundColor" Value="#8B4513" />
      <Setter Property="TextColor" Value="White" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="HeightRequest" Value="44" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="BorderColor" Value="Black" />
      <Setter Property="BorderWidth" Value="2" />
      <Setter Property="VerticalOptions" Value="Center" />
      <Setter Property="HorizontalOptions" Value="Center" />
    </Style>
    <Style x:Key="WtpPlayModePickerBorder" TargetType="Border">
      <Setter Property="Background" Value="#8B4513" />
      <Setter Property="Stroke" Value="Black" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="Padding" Value="4,6" />
      <Setter Property="MinimumHeightRequest" Value="52" />
      <Setter Property="StrokeShape">
        <Setter.Value>
          <RoundRectangle CornerRadius="8" />
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="WtpPlayModePicker" TargetType="Picker">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="TextColor" Value="#000000" />
      <Setter Property="BackgroundColor" Value="Transparent" />
      <Setter Property="VerticalOptions" Value="Center" />
      <Setter Property="HorizontalOptions" Value="Fill" />
      <Setter Property="HorizontalTextAlignment" Value="Center" />
      <Setter Property="Margin" Value="2,0" />
    </Style>
  </ContentPage.Resources>

  <!-- Root Grid so ColorPickerDialog can overlay everything -->
  <Grid>

    <ScrollView Orientation="Vertical">
      <VerticalStackLayout Spacing="12"
                          Padding="0,4,0,32">

      <!-- Instrument | Key | Concert key -->
      <Grid ColumnDefinitions="*,*,*"
            Margin="8,4,8,0">

        <!-- Instrument -->
        <VerticalStackLayout Grid.Column="0"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Spacing="2">
          <Label Text="Instrument"
                 FontSize="11"
                 TextColor="#333333"
                 HorizontalOptions="Center" />
          <Border Style="{StaticResource WtpBrownBox}">
            <Grid WidthRequest="160">
              <Picker x:Name="InstrumentPicker"
                      SelectedIndexChanged="InstrumentPicker_SelectedIndexChanged"
                      Unfocused="InstrumentPicker_Unfocused"
                      HeightRequest="28"
                      FontSize="11"
                      TextColor="White"
                      BackgroundColor="#2C2C2C"
                      VerticalOptions="Fill"
                      HorizontalOptions="Fill"
                      IsEnabled="True"
                      InputTransparent="False"
                      IsVisible="{Binding Source={x:Reference whatToPlayPage}, Path=IsInstrumentPickerVisible}" />
              <Border BackgroundColor="White" Stroke="#8B4513" StrokeThickness="2"
                      StrokeShape="RoundRectangle 8"
                      Padding="8,2" HeightRequest="28"
                      VerticalOptions="Center" HorizontalOptions="Fill"
                      IsVisible="{Binding Source={x:Reference whatToPlayPage}, Path=IsInstrumentLabelVisible}">
                <Label x:Name="InstrumentPickerOverlay"
                       Text="{Binding Source={x:Reference whatToPlayPage}, Path=SelectedInstrumentShort}"
                       VerticalOptions="Center"
                       HorizontalOptions="Fill"
                       Padding="10,0"
                       FontSize="11"
                       TextColor="Black">
                  <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnInstrumentLabelTapped" />
                  </Label.GestureRecognizers>
                </Label>
              </Border>
            </Grid>
          </Border>
        </VerticalStackLayout>

        <!-- Key -->
        <VerticalStackLayout Grid.Column="1"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Spacing="2">
          <Label x:Name="KeyLabel"
                 Text="Key"
                 FontSize="11"
                 TextColor="#333333"
                 HorizontalOptions="Center" />
          <Border x:Name="KeyBorder" Style="{StaticResource WtpBrownBox}">
            <Picker x:Name="KeyPicker"
                    WidthRequest="50"
                    HeightRequest="28"
                    FontSize="11"
                    TextColor="#000000"
                    BackgroundColor="White"
                    VerticalOptions="Fill"
                    HorizontalOptions="Fill" />
          </Border>
        </VerticalStackLayout>

        <!-- Concert key label -->
        <Label x:Name="ConcertKeyLabel"
               Grid.Column="2"
               FontSize="11"
               TextColor="#333333"
               HorizontalOptions="Center"
               VerticalOptions="Center" />

      </Grid>

      <!-- Tunes | Scales | Arpeggios | Random/Tuner -->
      <VerticalStackLayout Spacing="8"
                           HorizontalOptions="Center"
                           Margin="8,0">
        <Grid ColumnDefinitions="*,*"
              RowDefinitions="Auto,Auto"
              ColumnSpacing="12"
              RowSpacing="10"
              WidthRequest="380">
          <!-- Tunes -->
          <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4">
            <Label Text="Tunes"
                   FontSize="13"
                   FontAttributes="Bold"
                   TextColor="#333333"
                   HorizontalOptions="Center" />
            <Border Style="{StaticResource WtpPlayModePickerBorder}">
              <Grid BackgroundColor="White">
                <Picker x:Name="TunesPicker"
                        Style="{StaticResource WtpPlayModePicker}"
                        SelectedIndexChanged="OnTunesPickerChanged" />
              </Grid>
            </Border>
          </VerticalStackLayout>

          <!-- Scales -->
          <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
            <Label Text="Scales"
                   FontSize="13"
                   FontAttributes="Bold"
                   TextColor="#333333"
                   HorizontalOptions="Center" />
            <Border Style="{StaticResource WtpPlayModePickerBorder}">
              <Grid BackgroundColor="White">
                <Picker x:Name="ScalesPicker"
                        Style="{StaticResource WtpPlayModePicker}"
                        SelectedIndexChanged="OnScalesPickerChanged" />
              </Grid>
            </Border>
          </VerticalStackLayout>

          <!-- Arpeggios (placeholder — no items yet) -->
          <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4">
            <Label Text="Arpeggios"
                   FontSize="13"
                   FontAttributes="Bold"
                   TextColor="#333333"
                   HorizontalOptions="Center" />
            <Border Style="{StaticResource WtpPlayModePickerBorder}" Opacity="0.55">
              <Grid BackgroundColor="#EEEEEE">
                <Picker x:Name="ArpeggiosPicker"
                        Style="{StaticResource WtpPlayModePicker}"
                        IsEnabled="False" />
              </Grid>
            </Border>
          </VerticalStackLayout>

          <!-- Random / Tuner -->
          <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4">
            <Label Text="Random/Tuner"
                   FontSize="13"
                   FontAttributes="Bold"
                   TextColor="#333333"
                   HorizontalOptions="Center" />
            <Border Style="{StaticResource WtpPlayModePickerBorder}">
              <Grid BackgroundColor="White">
                <Picker x:Name="RandomTunerPicker"
                        Style="{StaticResource WtpPlayModePicker}"
                        SelectedIndexChanged="OnRandomTunerPickerChanged" />
              </Grid>
            </Border>
          </VerticalStackLayout>
        </Grid>

        <Label x:Name="RandomModeWarningLabel"
               Text="⚠ Random mode works best with a scale selected"
               FontSize="12"
               TextColor="DarkRed"
               IsVisible="False"
               HorizontalOptions="Center" />
      </VerticalStackLayout>

      <!-- Repeat / Background Color buttons -->
      <VerticalStackLayout Spacing="8"
                           Margin="12,4,12,0">

        <!-- Scale mode: single Repeat button -->
        <Button x:Name="AutoRepeatScaleButton"
                Text="Repeat"
                Style="{StaticResource WtpBrownButton}"
                HeightRequest="44"
                HorizontalOptions="Fill"
                Clicked="OnAutoRepeatScaleClicked"
                IsVisible="{Binding Source={x:Reference whatToPlayPage}, Path=IsScaleRepeatButtonVisible}" />

        <!-- Random mode: Repeat New + Repeat Same side by side -->
        <Grid ColumnDefinitions="*,*"
              ColumnSpacing="8"
              IsVisible="{Binding Source={x:Reference whatToPlayPage}, Path=IsRandomRepeatButtonsVisible}">
          <Button x:Name="AutoRepeatNewButton"
                  Grid.Column="0"
                  Text="Repeat New"
                  Style="{StaticResource WtpBrownButton}"
                  HeightRequest="44"
                  HorizontalOptions="Fill"
                  Clicked="OnAutoRepeatNewClicked" />
          <Button x:Name="AutoRepeatSameButton"
                  Grid.Column="1"
                  Text="Repeat Same"
                  Style="{StaticResource WtpBrownButton}"
                  HeightRequest="44"
                  HorizontalOptions="Fill"
                  Clicked="OnAutoRepeatSameClicked" />
        </Grid>

        <Button Text="Background Color"
                Style="{StaticResource WtpBrownButton}"
                HeightRequest="44"
                HorizontalOptions="Fill"
                Clicked="OnColorButtonClicked" />

      </VerticalStackLayout>

      </VerticalStackLayout>
    </ScrollView>

    <!-- Color picker dialog overlay (full-page, above everything) -->
    <controls:ColorPickerDialog x:Name="ColorPickerDialog"
                                IsVisible="False" />

  </Grid>

</ContentPage>
