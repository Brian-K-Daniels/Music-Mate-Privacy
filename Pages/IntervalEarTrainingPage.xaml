<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="musicmate.Pages.IntervalEarTrainingPage"
             x:Name="EarTrainingRoot"
             Title="Interval Ear Training"
             Shell.NavBarIsVisible="True"
             BackgroundColor="{DynamicResource ThemePanelBackground}">

  <ContentPage.Resources>
    <Style x:Key="EarTrainButton" TargetType="Button">
      <Setter Property="BackgroundColor" Value="{DynamicResource ThemeButtonBackground}" />
      <Setter Property="TextColor" Value="{DynamicResource ThemeContrastingText}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderWidth" Value="0" />
      <Setter Property="FontAttributes" Value="Bold" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinimumHeightRequest" Value="28" />
      <Setter Property="Padding" Value="3,1" />
      <Setter Property="HorizontalOptions" Value="Fill" />
      <Setter Property="VerticalOptions" Value="Fill" />
      <Setter Property="LineBreakMode" Value="NoWrap" />
    </Style>

    <!-- Interval answers: family BackgroundColor is set in code; VisualStates must not replace it. -->
    <Style x:Key="EarTrainIntervalButton" TargetType="Button">
      <Setter Property="TextColor" Value="#1F2937" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderWidth" Value="0" />
      <Setter Property="FontAttributes" Value="Bold" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="MinimumHeightRequest" Value="28" />
      <Setter Property="Padding" Value="8,0,4,0" />
      <Setter Property="HorizontalOptions" Value="Fill" />
      <Setter Property="VerticalOptions" Value="Fill" />
      <Setter Property="LineBreakMode" Value="NoWrap" />
      <Setter Property="VisualStateManager.VisualStateGroups">
        <VisualStateGroupList>
          <VisualStateGroup x:Name="CommonStates">
            <VisualState x:Name="Normal">
              <VisualState.Setters>
                <Setter Property="Opacity" Value="1" />
                <Setter Property="Scale" Value="1" />
              </VisualState.Setters>
            </VisualState>
            <VisualState x:Name="Disabled">
              <VisualState.Setters>
                <Setter Property="Opacity" Value="0.55" />
                <Setter Property="Scale" Value="1" />
              </VisualState.Setters>
            </VisualState>
            <VisualState x:Name="Pressed">
              <VisualState.Setters>
                <Setter Property="Opacity" Value="0.88" />
                <Setter Property="Scale" Value="0.98" />
              </VisualState.Setters>
            </VisualState>
            <VisualState x:Name="PointerOver">
              <VisualState.Setters>
                <Setter Property="Opacity" Value="0.95" />
                <Setter Property="Scale" Value="1" />
              </VisualState.Setters>
            </VisualState>
          </VisualStateGroup>
        </VisualStateGroupList>
      </Setter>
    </Style>
  </ContentPage.Resources>

  <Shell.TitleView>
    <Grid ColumnDefinitions="Auto,*,Auto"
          ColumnSpacing="8"
          HeightRequest="40"
          Padding="0,0,8,0"
          VerticalOptions="Center">
      <Button Grid.Column="0"
              Style="{StaticResource MusicNavBackButton}"
              Clicked="OnNavigateMusicClicked"
              SemanticProperties.Description="Go to Music page" />
      <Label Grid.Column="1"
             Text="Interval Ear Training"
             FontAttributes="Bold"
             FontSize="17"
             LineBreakMode="TailTruncation"
             MaxLines="1"
             VerticalTextAlignment="Center"
             TextColor="{DynamicResource ThemeContrastingText}"
             VerticalOptions="Center" />
      <Border Grid.Column="2"
              Style="{StaticResource TitleLogoBorder}"
              VerticalOptions="Center"
              HorizontalOptions="End">
        <Image Source="logo.png" Aspect="AspectFill" />
      </Border>
    </Grid>
  </Shell.TitleView>

  <!--
    No ScrollView. Status + Direction + Duration are Auto; remaining height is the
    3×5 Play/interval grid plus staff. Play Random / Play Again live in the grid.
  -->
  <Grid x:Name="PageRoot"
        RowDefinitions="Auto,Auto,Auto,*"
        RowSpacing="1"
        Padding="4,1,4,2"
        HorizontalOptions="Fill"
        VerticalOptions="Fill">

    <Grid x:Name="StatusSection"
          Grid.Row="0"
          ColumnDefinitions="*,Auto"
          ColumnSpacing="8"
          HeightRequest="28"
          Margin="0,0,0,1"
          HorizontalOptions="Fill">
      <Label x:Name="StatusLabel"
             Grid.Column="0"
             Text="Play Random to quiz. Tap any interval to hear it."
             FontSize="12"
             LineBreakMode="TailTruncation"
             MaxLines="1"
             VerticalTextAlignment="Center"
             VerticalOptions="Center"
             HorizontalOptions="Fill"
             TextColor="{DynamicResource ThemeContrastingText}" />
      <Border Grid.Column="1"
              Stroke="{DynamicResource ThemePickerBorder}"
              StrokeThickness="1"
              BackgroundColor="{DynamicResource ThemeButtonBackground}"
              Padding="6,0"
              HeightRequest="28"
              WidthRequest="200"
              MinimumWidthRequest="168"
              VerticalOptions="Center"
              HorizontalOptions="End">
        <Border.StrokeShape>
          <RoundRectangle CornerRadius="6" />
        </Border.StrokeShape>
        <Picker x:Name="InstrumentPicker"
                FontSize="11"
                FontAttributes="Bold"
                HeightRequest="26"
                BackgroundColor="Transparent"
                TextColor="{DynamicResource ThemeContrastingText}"
                VerticalOptions="Center"
                HorizontalOptions="Fill"
                SelectedIndexChanged="OnInstrumentPickerChanged"
                SemanticProperties.Description="Instrument used for playback transposition" />
      </Border>
    </Grid>

    <Grid x:Name="DirectionSection"
          Grid.Row="1"
          ColumnDefinitions="Auto,*,*,*"
          ColumnSpacing="4"
          HeightRequest="30"
          HorizontalOptions="Fill">
      <Label Grid.Column="0"
             Text="Direction"
             FontSize="12"
             FontAttributes="Bold"
             VerticalTextAlignment="Center"
             VerticalOptions="Center"
             TextColor="{DynamicResource ThemeContrastingText}" />
      <Button x:Name="DirectionAscendingButton"
              Grid.Column="1"
              Style="{StaticResource EarTrainButton}"
              Text="Ascending"
              Clicked="OnDirectionAscendingClicked"
              SemanticProperties.Description="Play intervals going up" />
      <Button x:Name="DirectionDescendingButton"
              Grid.Column="2"
              Style="{StaticResource EarTrainButton}"
              Text="Descending"
              Clicked="OnDirectionDescendingClicked"
              SemanticProperties.Description="Play intervals going down" />
      <Button x:Name="DirectionRandomButton"
              Grid.Column="3"
              Style="{StaticResource EarTrainButton}"
              Text="Random"
              Clicked="OnDirectionRandomClicked"
              SemanticProperties.Description="Play intervals going up or down at random" />
    </Grid>

    <!-- Duration  [slider]  [n] ms  [m] bpm -->
    <Grid x:Name="DurationSection"
          Grid.Row="2"
          ColumnDefinitions="Auto,*,Auto,Auto"
          ColumnSpacing="8"
          HeightRequest="32"
          VerticalOptions="Center"
          HorizontalOptions="Fill">
      <Label Grid.Column="0"
             Text="Duration"
             FontSize="12"
             FontAttributes="Bold"
             VerticalTextAlignment="Center"
             VerticalOptions="Center"
             TextColor="{DynamicResource ThemeContrastingText}" />
      <Slider x:Name="DurationSlider"
              Grid.Column="1"
              Minimum="0"
              Maximum="1000"
              Value="500"
              VerticalOptions="Center"
              MinimumTrackColor="{DynamicResource ThemeSlider}"
              MaximumTrackColor="#CCCCCC"
              ThumbColor="{DynamicResource ThemeSlider}"
              ValueChanged="OnDurationChanged"
              SemanticProperties.Description="Duration of each played note in milliseconds" />
      <Label x:Name="DurationMsLabel"
             Grid.Column="2"
             Text="500 ms"
             FontSize="12"
             FontAttributes="Bold"
             VerticalTextAlignment="Center"
             VerticalOptions="Center"
             HorizontalTextAlignment="End"
             MinimumWidthRequest="72"
             TextColor="{DynamicResource ThemeContrastingText}" />
      <Label x:Name="DurationBpmLabel"
             Grid.Column="3"
             Text="120 bpm"
             FontSize="12"
             FontAttributes="Bold"
             VerticalTextAlignment="Center"
             VerticalOptions="Center"
             HorizontalTextAlignment="End"
             MinimumWidthRequest="72"
             TextColor="{DynamicResource ThemeContrastingText}" />
    </Grid>

    <!-- 3×5 grid (Play + intervals) | staff -->
    <Grid x:Name="IntervalsSection"
          Grid.Row="3"
          ColumnDefinitions="*,Auto"
          ColumnSpacing="6"
          HorizontalOptions="Fill"
          VerticalOptions="Fill">
      <Grid x:Name="IntervalButtonsHost"
            Grid.Column="0"
            ColumnDefinitions="*,*,*"
            ColumnSpacing="3"
            RowSpacing="3"
            HorizontalOptions="Fill"
            VerticalOptions="Fill" />

      <Border x:Name="StaffRevealBorder"
              Grid.Column="1"
              WidthRequest="120"
              MinimumWidthRequest="110"
              Stroke="{DynamicResource ThemePickerBorder}"
              StrokeThickness="1"
              BackgroundColor="{DynamicResource ThemePanelBackground}"
              Padding="3"
              HorizontalOptions="Fill"
              VerticalOptions="Fill"
              SemanticProperties.Description="Staff showing the interval that was played">
        <Border.StrokeShape>
          <RoundRectangle CornerRadius="6" />
        </Border.StrokeShape>
        <GraphicsView x:Name="StaffGraphicsView"
                      VerticalOptions="Fill"
                      HorizontalOptions="Fill" />
      </Border>
    </Grid>

    <Grid x:Name="FeedbackOverlay"
          Grid.RowSpan="4"
          IsVisible="False"
          BackgroundColor="#CC000000"
          InputTransparent="False"
          SemanticProperties.Description="Answer feedback">
      <Border x:Name="FeedbackCard"
              BackgroundColor="{DynamicResource ThemeButtonBackground}"
              StrokeThickness="0"
              StrokeShape="RoundRectangle 16"
              Padding="24,20"
              HorizontalOptions="Center"
              VerticalOptions="Center"
              MaximumWidthRequest="320">
        <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
          <Image x:Name="FeedbackImage"
                 WidthRequest="96"
                 HeightRequest="96"
                 Aspect="AspectFit"
                 IsVisible="False"
                 HorizontalOptions="Center" />
          <Label x:Name="FeedbackEmojiLabel"
                 FontSize="56"
                 LineBreakMode="NoWrap"
                 HorizontalTextAlignment="Center"
                 VerticalTextAlignment="Center"
                 HorizontalOptions="Center" />
          <Label x:Name="FeedbackTitleLabel"
                 FontSize="22"
                 FontAttributes="Bold"
                 LineBreakMode="NoWrap"
                 HorizontalTextAlignment="Center"
                 VerticalTextAlignment="Center"
                 TextColor="{DynamicResource ThemeContrastingText}" />
          <Label x:Name="FeedbackDetailLabel"
                 FontSize="15"
                 HorizontalTextAlignment="Center"
                 VerticalTextAlignment="Center"
                 LineBreakMode="WordWrap"
                 TextColor="{DynamicResource ThemeContrastingText}" />
          <ActivityIndicator x:Name="FeedbackWaitIndicator"
                             IsRunning="False"
                             IsVisible="False"
                             Color="{DynamicResource ThemeContrastingText}"
                             WidthRequest="36"
                             HeightRequest="36"
                             HorizontalOptions="Center"
                             SemanticProperties.Description="Waiting" />
          <ProgressBar x:Name="FeedbackWaitProgress"
                       Progress="0"
                       IsVisible="False"
                       ProgressColor="{DynamicResource ThemeSlider}"
                       HeightRequest="8"
                       HorizontalOptions="Fill"
                       SemanticProperties.Description="Waiting for the next view" />
        </VerticalStackLayout>
      </Border>
    </Grid>
  </Grid>
</ContentPage>
