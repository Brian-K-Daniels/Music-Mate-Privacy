<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="musicmate.Pages.IntervalEarTrainingPage"
             x:Name="EarTrainingRoot"
             Title="Interval Ear Training"
             Shell.NavBarIsVisible="True"
             BackgroundColor="{DynamicResource ThemePanelBackground}">

  <ContentPage.Resources>
    <Style x:Key="EarTrainButton" TargetType="Button">
      <Setter Property="BackgroundColor" Value="{DynamicResource ThemeButtonBackground}" />
      <Setter Property="TextColor" Value="{DynamicResource ThemeContrastingText}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderWidth" Value="0" />
      <Setter Property="FontAttributes" Value="Bold" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="MinimumHeightRequest" Value="34" />
      <Setter Property="HeightRequest" Value="34" />
      <Setter Property="Padding" Value="3,1" />
      <Setter Property="HorizontalOptions" Value="Fill" />
      <Setter Property="VerticalOptions" Value="Fill" />
      <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <!-- Interval answers: family BackgroundColor is set in code; VisualStates must not replace it. -->
    <Style x:Key="EarTrainIntervalButton" TargetType="Button">
      <Setter Property="TextColor" Value="#1F2937" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderWidth" Value="1" />
      <Setter Property="BorderColor" Value="#00000028" />
      <Setter Property="FontAttributes" Value="Bold" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="MinimumHeightRequest" Value="48" />
      <Setter Property="HeightRequest" Value="48" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="HorizontalOptions" Value="Fill" />
      <Setter Property="VerticalOptions" Value="Fill" />
      <Setter Property="LineBreakMode" Value="WordWrap" />
      <Setter Property="VisualStateManager.VisualStateGroups">
        <VisualStateGroupList>
          <VisualStateGroup x:Name="CommonStates">
            <VisualState x:Name="Normal">
              <VisualState.Setters>
                <Setter Property="Opacity" Value="1" />
                <Setter Property="Scale" Value="1" />
              </VisualState.Setters>
            </VisualState>
            <VisualState x:Name="Disabled">
              <VisualState.Setters>
                <Setter Property="Opacity" Value="0.55" />
                <Setter Property="Scale" Value="1" />
              </VisualState.Setters>
            </VisualState>
            <VisualState x:Name="Pressed">
              <VisualState.Setters>
                <Setter Property="Opacity" Value="0.88" />
                <Setter Property="Scale" Value="0.98" />
              </VisualState.Setters>
            </VisualState>
            <VisualState x:Name="PointerOver">
              <VisualState.Setters>
                <Setter Property="Opacity" Value="0.95" />
                <Setter Property="Scale" Value="1" />
              </VisualState.Setters>
            </VisualState>
          </VisualStateGroup>
        </VisualStateGroupList>
      </Setter>
    </Style>
  </ContentPage.Resources>

  <Shell.TitleView>
    <Grid ColumnDefinitions="Auto,*,Auto"
          ColumnSpacing="8"
          HeightRequest="44"
          Padding="0,0,8,0"
          VerticalOptions="Center">
      <Button Grid.Column="0"
              Style="{StaticResource MusicNavBackButton}"
              Clicked="OnNavigateMusicClicked"
              SemanticProperties.Description="Go to Music page" />
      <Label Grid.Column="1"
             Text="Interval Ear Training"
             FontAttributes="Bold"
             FontSize="18"
             LineBreakMode="TailTruncation"
             MaxLines="1"
             TextColor="{DynamicResource ThemeContrastingText}"
             VerticalOptions="Center" />
      <Border Grid.Column="2"
              Style="{StaticResource TitleLogoBorder}"
              VerticalOptions="Center"
              HorizontalOptions="End">
        <Image Source="logo.png" Aspect="AspectFill" />
      </Border>
    </Grid>
  </Shell.TitleView>

  <Grid RowDefinitions="Auto,*">
    <!-- Pinned above the scroll area so landscape / interval scrolling cannot hide them. -->
    <Grid x:Name="PlayControlsSection"
          Grid.Row="0"
          ColumnDefinitions="*,*"
          ColumnSpacing="6"
          Margin="8,4,12,4"
          HorizontalOptions="Fill">
      <Button x:Name="PlayRandomButton"
              Grid.Column="0"
              Style="{StaticResource EarTrainButton}"
              Text="Play Random"
              Clicked="OnPlayRandomClicked"
              SemanticProperties.Description="Play a random interval and wait for your answer" />
      <Button x:Name="PlayAgainButton"
              Grid.Column="1"
              Style="{StaticResource EarTrainButton}"
              Text="Play Again"
              IsEnabled="False"
              Clicked="OnPlayAgainClicked"
              SemanticProperties.Description="Replay the last interval with the same pitches" />
    </Grid>

    <ScrollView x:Name="MainScroll"
                Grid.Row="1"
                Padding="8,0,12,8"
                VerticalOptions="Fill"
                HorizontalOptions="Fill">
      <VerticalStackLayout x:Name="MainContent" Spacing="6" HorizontalOptions="Fill">

        <Label x:Name="StatusLabel"
               Text="Tap an interval to hear it, or Play Random to quiz yourself."
               FontSize="12"
               LineBreakMode="WordWrap"
               TextColor="{DynamicResource ThemeContrastingText}" />

        <Grid ColumnDefinitions="Auto,*,*,*"
              ColumnSpacing="4"
              HorizontalOptions="Fill">
          <Label Grid.Column="0"
                 Text="Direction"
                 FontSize="12"
                 FontAttributes="Bold"
                 VerticalOptions="Center"
                 TextColor="{DynamicResource ThemeContrastingText}" />
          <Button x:Name="DirectionAscendingButton"
                  Grid.Column="1"
                  Style="{StaticResource EarTrainButton}"
                  Text="Ascending"
                  Clicked="OnDirectionAscendingClicked"
                  SemanticProperties.Description="Play intervals going up" />
          <Button x:Name="DirectionDescendingButton"
                  Grid.Column="2"
                  Style="{StaticResource EarTrainButton}"
                  Text="Descending"
                  Clicked="OnDirectionDescendingClicked"
                  SemanticProperties.Description="Play intervals going down" />
          <Button x:Name="DirectionRandomButton"
                  Grid.Column="3"
                  Style="{StaticResource EarTrainButton}"
                  Text="Random"
                  Clicked="OnDirectionRandomClicked"
                  SemanticProperties.Description="Play intervals going up or down at random" />
        </Grid>

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" VerticalOptions="Center">
          <VerticalStackLayout Grid.Column="0" Spacing="0">
            <Label x:Name="DurationLabel"
                   Text="Note duration: 500 ms"
                   FontSize="12"
                   TextColor="{DynamicResource ThemeContrastingText}" />
            <Slider x:Name="DurationSlider"
                    Minimum="0"
                    Maximum="1000"
                    Value="500"
                    MinimumTrackColor="{DynamicResource ThemeSlider}"
                    MaximumTrackColor="#CCCCCC"
                    ThumbColor="{DynamicResource ThemeSlider}"
                    ValueChanged="OnDurationChanged"
                    SemanticProperties.Description="Duration of each played note in milliseconds" />
          </VerticalStackLayout>
          <Label Grid.Column="1"
                 x:Name="DurationValueLabel"
                 Text="500"
                 FontSize="13"
                 FontAttributes="Bold"
                 WidthRequest="40"
                 HorizontalTextAlignment="End"
                 VerticalOptions="Center"
                 TextColor="{DynamicResource ThemeContrastingText}" />
        </Grid>

        <!-- Intervals left (flex), compact staff right — staff stays narrow so labels fit. -->
        <Grid x:Name="IntervalsSection"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="8"
              HorizontalOptions="Fill">
          <VerticalStackLayout Grid.Column="0" Spacing="3" HorizontalOptions="Fill">
            <Label Text="Intervals"
                   FontSize="13"
                   FontAttributes="Bold"
                   TextColor="{DynamicResource ThemeContrastingText}" />
            <Grid x:Name="IntervalButtonsHost"
                  ColumnDefinitions="*,*,*"
                  ColumnSpacing="4"
                  RowSpacing="4"
                  HorizontalOptions="Fill" />
          </VerticalStackLayout>

          <!-- Compact side panel; width capped in code so interval columns keep room. -->
          <Border x:Name="StaffRevealBorder"
                  Grid.Column="1"
                  WidthRequest="120"
                  MinimumWidthRequest="110"
                  MaximumWidthRequest="132"
                  Stroke="{DynamicResource ThemePickerBorder}"
                  StrokeThickness="1"
                  BackgroundColor="{DynamicResource ThemePanelBackground}"
                  Padding="6"
                  VerticalOptions="Fill"
                  HorizontalOptions="End"
                  SemanticProperties.Description="Staff showing the interval that was played">
            <Border.StrokeShape>
              <RoundRectangle CornerRadius="6" />
            </Border.StrokeShape>
            <GraphicsView x:Name="StaffGraphicsView"
                          MinimumHeightRequest="96"
                          VerticalOptions="Fill"
                          HorizontalOptions="Fill" />
          </Border>
        </Grid>

      </VerticalStackLayout>
    </ScrollView>

    <Grid x:Name="FeedbackOverlay"
          Grid.RowSpan="2"
          IsVisible="False"
          BackgroundColor="#CC000000"
          InputTransparent="False"
          SemanticProperties.Description="Answer feedback">
      <Border x:Name="FeedbackCard"
              BackgroundColor="{DynamicResource ThemeButtonBackground}"
              StrokeThickness="0"
              StrokeShape="RoundRectangle 16"
              Padding="24"
              HorizontalOptions="Center"
              VerticalOptions="Center"
              MaximumWidthRequest="320">
        <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
          <Image x:Name="FeedbackImage"
                 WidthRequest="96"
                 HeightRequest="96"
                 Aspect="AspectFit"
                 IsVisible="False"
                 HorizontalOptions="Center" />
          <Label x:Name="FeedbackEmojiLabel"
                 FontSize="56"
                 HorizontalTextAlignment="Center"
                 HorizontalOptions="Center" />
          <Label x:Name="FeedbackTitleLabel"
                 FontSize="22"
                 FontAttributes="Bold"
                 HorizontalTextAlignment="Center"
                 TextColor="{DynamicResource ThemeContrastingText}" />
          <Label x:Name="FeedbackDetailLabel"
                 FontSize="15"
                 HorizontalTextAlignment="Center"
                 LineBreakMode="WordWrap"
                 TextColor="{DynamicResource ThemeContrastingText}" />
          <ActivityIndicator x:Name="FeedbackWaitIndicator"
                             IsRunning="False"
                             IsVisible="False"
                             Color="{DynamicResource ThemeContrastingText}"
                             WidthRequest="36"
                             HeightRequest="36"
                             HorizontalOptions="Center"
                             SemanticProperties.Description="Waiting" />
          <ProgressBar x:Name="FeedbackWaitProgress"
                       Progress="0"
                       IsVisible="False"
                       ProgressColor="{DynamicResource ThemeSlider}"
                       HeightRequest="8"
                       HorizontalOptions="Fill"
                       SemanticProperties.Description="Waiting for the next view" />
        </VerticalStackLayout>
      </Border>
    </Grid>
  </Grid>
</ContentPage>
