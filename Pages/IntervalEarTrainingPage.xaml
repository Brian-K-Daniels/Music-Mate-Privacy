<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="musicmate.Pages.IntervalEarTrainingPage"
             x:Name="EarTrainingRoot"
             Title="Interval Ear Training"
             Shell.NavBarIsVisible="True"
             BackgroundColor="{DynamicResource ThemePanelBackground}">

  <ContentPage.Resources>
    <Style x:Key="EarTrainButton" TargetType="Button">
      <Setter Property="BackgroundColor" Value="{DynamicResource ThemeButtonBackground}" />
      <Setter Property="TextColor" Value="{DynamicResource ThemeContrastingText}" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderWidth" Value="0" />
      <Setter Property="FontAttributes" Value="Bold" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinimumHeightRequest" Value="32" />
      <Setter Property="HeightRequest" Value="32" />
      <Setter Property="Padding" Value="4,1" />
      <Setter Property="HorizontalOptions" Value="Fill" />
      <Setter Property="VerticalOptions" Value="Fill" />
      <Setter Property="LineBreakMode" Value="NoWrap" />
    </Style>

    <!-- Interval answers: family BackgroundColor is set in code; VisualStates must not replace it. -->
    <Style x:Key="EarTrainIntervalButton" TargetType="Button">
      <Setter Property="TextColor" Value="#1F2937" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderWidth" Value="1" />
      <Setter Property="BorderColor" Value="#00000028" />
      <Setter Property="FontAttributes" Value="Bold" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinimumHeightRequest" Value="28" />
      <Setter Property="Padding" Value="4,1" />
      <Setter Property="HorizontalOptions" Value="Fill" />
      <Setter Property="VerticalOptions" Value="Fill" />
      <Setter Property="LineBreakMode" Value="NoWrap" />
      <Setter Property="VisualStateManager.VisualStateGroups">
        <VisualStateGroupList>
          <VisualStateGroup x:Name="CommonStates">
            <VisualState x:Name="Normal">
              <VisualState.Setters>
                <Setter Property="Opacity" Value="1" />
                <Setter Property="Scale" Value="1" />
              </VisualState.Setters>
            </VisualState>
            <VisualState x:Name="Disabled">
              <VisualState.Setters>
                <Setter Property="Opacity" Value="0.55" />
                <Setter Property="Scale" Value="1" />
              </VisualState.Setters>
            </VisualState>
            <VisualState x:Name="Pressed">
              <VisualState.Setters>
                <Setter Property="Opacity" Value="0.88" />
                <Setter Property="Scale" Value="0.98" />
              </VisualState.Setters>
            </VisualState>
            <VisualState x:Name="PointerOver">
              <VisualState.Setters>
                <Setter Property="Opacity" Value="0.95" />
                <Setter Property="Scale" Value="1" />
              </VisualState.Setters>
            </VisualState>
          </VisualStateGroup>
        </VisualStateGroupList>
      </Setter>
    </Style>
  </ContentPage.Resources>

  <Shell.TitleView>
    <Grid ColumnDefinitions="Auto,*,Auto"
          ColumnSpacing="8"
          HeightRequest="44"
          Padding="0,0,8,0"
          VerticalOptions="Center">
      <Button Grid.Column="0"
              Style="{StaticResource MusicNavBackButton}"
              Clicked="OnNavigateMusicClicked"
              SemanticProperties.Description="Go to Music page" />
      <Label Grid.Column="1"
             Text="Interval Ear Training"
             FontAttributes="Bold"
             FontSize="18"
             LineBreakMode="TailTruncation"
             MaxLines="1"
             TextColor="{DynamicResource ThemeContrastingText}"
             VerticalOptions="Center" />
      <Border Grid.Column="2"
              Style="{StaticResource TitleLogoBorder}"
              VerticalOptions="Center"
              HorizontalOptions="End">
        <Image Source="logo.png" Aspect="AspectFill" />
      </Border>
    </Grid>
  </Shell.TitleView>

  <!--
    Play + options stay Auto-height; remaining height is the interval grid + staff.
    Buttons use the star column (most of the width); staff is a usable Auto column
    (width set in code, never collapsed). No ScrollView — everything must fit on-screen.
  -->
  <Grid x:Name="PageRoot"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="3"
        Padding="4,2,4,4"
        HorizontalOptions="Fill"
        VerticalOptions="Fill">

    <Grid x:Name="PlayControlsSection"
          Grid.Row="0"
          ColumnDefinitions="*,*"
          ColumnSpacing="6"
          HorizontalOptions="Fill">
      <Button x:Name="PlayRandomButton"
              Grid.Column="0"
              Style="{StaticResource EarTrainButton}"
              Text="Play Random"
              Clicked="OnPlayRandomClicked"
              SemanticProperties.Description="Play a random interval and wait for your answer" />
      <Button x:Name="PlayAgainButton"
              Grid.Column="1"
              Style="{StaticResource EarTrainButton}"
              Text="Play Again"
              IsEnabled="False"
              Clicked="OnPlayAgainClicked"
              SemanticProperties.Description="Replay the last interval with the same pitches" />
    </Grid>

    <VerticalStackLayout x:Name="OptionsSection"
                         Grid.Row="1"
                         Spacing="4"
                         HorizontalOptions="Fill">
      <Label x:Name="StatusLabel"
             Text="Tap an interval to hear it, or Play Random to quiz yourself."
             FontSize="11"
             LineBreakMode="TailTruncation"
             MaxLines="1"
             TextColor="{DynamicResource ThemeContrastingText}" />

      <Grid ColumnDefinitions="Auto,*,*,*,Auto,Auto"
            ColumnSpacing="4"
            HorizontalOptions="Fill">
        <Label Grid.Column="0"
               Text="Direction"
               FontSize="11"
               FontAttributes="Bold"
               VerticalOptions="Center"
               TextColor="{DynamicResource ThemeContrastingText}" />
        <Button x:Name="DirectionAscendingButton"
                Grid.Column="1"
                Style="{StaticResource EarTrainButton}"
                Text="Ascending"
                Clicked="OnDirectionAscendingClicked"
                SemanticProperties.Description="Play intervals going up" />
        <Button x:Name="DirectionDescendingButton"
                Grid.Column="2"
                Style="{StaticResource EarTrainButton}"
                Text="Descending"
                Clicked="OnDirectionDescendingClicked"
                SemanticProperties.Description="Play intervals going down" />
        <Button x:Name="DirectionRandomButton"
                Grid.Column="3"
                Style="{StaticResource EarTrainButton}"
                Text="Random"
                Clicked="OnDirectionRandomClicked"
                SemanticProperties.Description="Play intervals going up or down at random" />
        <Label Grid.Column="4"
               x:Name="DurationLabel"
               Text="ms"
               FontSize="11"
               VerticalOptions="Center"
               TextColor="{DynamicResource ThemeContrastingText}" />
        <Label Grid.Column="5"
               x:Name="DurationValueLabel"
               Text="500"
               FontSize="12"
               FontAttributes="Bold"
               WidthRequest="36"
               HorizontalTextAlignment="End"
               VerticalOptions="Center"
               TextColor="{DynamicResource ThemeContrastingText}" />
      </Grid>

      <Slider x:Name="DurationSlider"
              Minimum="0"
              Maximum="1000"
              Value="500"
              MinimumTrackColor="{DynamicResource ThemeSlider}"
              MaximumTrackColor="#CCCCCC"
              ThumbColor="{DynamicResource ThemeSlider}"
              ValueChanged="OnDurationChanged"
              SemanticProperties.Description="Duration of each played note in milliseconds" />
    </VerticalStackLayout>

    <!-- Star column = interval buttons; Auto staff column keeps a real, usable width. -->
    <Grid x:Name="IntervalsSection"
          Grid.Row="2"
          ColumnDefinitions="*,Auto"
          ColumnSpacing="6"
          HorizontalOptions="Fill"
          VerticalOptions="Fill">
      <Grid x:Name="IntervalButtonsHost"
            Grid.Column="0"
            ColumnDefinitions="*,*,*"
            ColumnSpacing="4"
            RowSpacing="3"
            HorizontalOptions="Fill"
            VerticalOptions="Fill" />

      <Border x:Name="StaffRevealBorder"
              Grid.Column="1"
              WidthRequest="140"
              MinimumWidthRequest="124"
              Stroke="{DynamicResource ThemePickerBorder}"
              StrokeThickness="1"
              BackgroundColor="{DynamicResource ThemePanelBackground}"
              Padding="3"
              HorizontalOptions="Fill"
              VerticalOptions="Fill"
              SemanticProperties.Description="Staff showing the interval that was played">
        <Border.StrokeShape>
          <RoundRectangle CornerRadius="6" />
        </Border.StrokeShape>
        <GraphicsView x:Name="StaffGraphicsView"
                      VerticalOptions="Fill"
                      HorizontalOptions="Fill" />
      </Border>
    </Grid>

    <Grid x:Name="FeedbackOverlay"
          Grid.RowSpan="3"
          IsVisible="False"
          BackgroundColor="#CC000000"
          InputTransparent="False"
          SemanticProperties.Description="Answer feedback">
      <Border x:Name="FeedbackCard"
              BackgroundColor="{DynamicResource ThemeButtonBackground}"
              StrokeThickness="0"
              StrokeShape="RoundRectangle 16"
              Padding="24"
              HorizontalOptions="Center"
              VerticalOptions="Center"
              MaximumWidthRequest="320">
        <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
          <Image x:Name="FeedbackImage"
                 WidthRequest="96"
                 HeightRequest="96"
                 Aspect="AspectFit"
                 IsVisible="False"
                 HorizontalOptions="Center" />
          <Label x:Name="FeedbackEmojiLabel"
                 FontSize="56"
                 HorizontalTextAlignment="Center"
                 HorizontalOptions="Center" />
          <Label x:Name="FeedbackTitleLabel"
                 FontSize="22"
                 FontAttributes="Bold"
                 HorizontalTextAlignment="Center"
                 TextColor="{DynamicResource ThemeContrastingText}" />
          <Label x:Name="FeedbackDetailLabel"
                 FontSize="15"
                 HorizontalTextAlignment="Center"
                 LineBreakMode="WordWrap"
                 TextColor="{DynamicResource ThemeContrastingText}" />
          <ActivityIndicator x:Name="FeedbackWaitIndicator"
                             IsRunning="False"
                             IsVisible="False"
                             Color="{DynamicResource ThemeContrastingText}"
                             WidthRequest="36"
                             HeightRequest="36"
                             HorizontalOptions="Center"
                             SemanticProperties.Description="Waiting" />
          <ProgressBar x:Name="FeedbackWaitProgress"
                       Progress="0"
                       IsVisible="False"
                       ProgressColor="{DynamicResource ThemeSlider}"
                       HeightRequest="8"
                       HorizontalOptions="Fill"
                       SemanticProperties.Description="Waiting for the next view" />
        </VerticalStackLayout>
      </Border>
    </Grid>
  </Grid>
</ContentPage>
