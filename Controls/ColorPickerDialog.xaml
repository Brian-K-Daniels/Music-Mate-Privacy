<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mcp="clr-namespace:Maui.ColorPicker;assembly=Maui.ColorPicker"
    x:Class="musicmate.Controls.ColorPickerDialog"
    x:Name="ColorPickerDialogRoot"
    IsVisible="False"
    BackgroundColor="#80000000"
    HorizontalOptions="Center"
    VerticalOptions="Center">

  <ScrollView HorizontalOptions="Center" VerticalOptions="Center">
    
        <Grid
          HorizontalOptions="Center"
          VerticalOptions="Center"
          Padding="24"
          BackgroundColor="White"
          MinimumWidthRequest="320"
          MaximumWidthRequest="420"
          MinimumHeightRequest="320"
          MaximumHeightRequest="600">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Label Grid.Row="0" Grid.Column="0"
              Text="Pick a color and set whiteness with slider"
              FontSize="10"
              TextColor="#000000"
              HorizontalOptions="Center"
              Margin="0,0,0,12"/>

          <!-- Centered arrow buttons and color picker -->
          <VerticalStackLayout Grid.Row="1" Grid.Column="0" HorizontalOptions="Center" Spacing="8">
            <!-- Color picker square centered -->
            <mcp:ColorPicker x:Name="ColorPicker"
                             HeightRequest="100"
                             WidthRequest="180"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"/>
            
            <!-- Arrow buttons centered underneath -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
              <Button x:Name="UpArrowButton"
                      Text="▲"
                      FontSize="12"
                      TextColor="#000000"
                      WidthRequest="18" HeightRequest="18"
                      Pressed="OnUpArrowPressed"
                      Released="OnArrowReleased"/>
              <Button x:Name="LeftArrowButton"
                      Text="◀"
                      FontSize="12"
                      TextColor="#000000"
                      WidthRequest="18" HeightRequest="18"
                      Pressed="OnLeftArrowPressed"
                      Released="OnArrowReleased"/>
              <Button x:Name="RightArrowButton"
                      Text="▶"
                      FontSize="12"
                      TextColor="#000000"
                      WidthRequest="18" HeightRequest="18"
                      Pressed="OnRightArrowPressed"
                      Released="OnArrowReleased"/>
              <Button x:Name="DownArrowButton"
                      Text="▼"
                      FontSize="12"
                      TextColor="#000000"
                      WidthRequest="18" HeightRequest="18"
                      Pressed="OnDownArrowPressed"
                      Released="OnArrowReleased"/>
            </HorizontalStackLayout>
          </VerticalStackLayout>

          <!-- Whiteness slider labels and slider -->
          <Grid Grid.Row="2" Grid.Column="0" Margin="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Label Text="Color"
             FontSize="8"
             TextColor="#000000"
             VerticalOptions="Center"
             HorizontalOptions="Start"
             Grid.Column="0"/>
            <Slider x:Name="WhitenessSlider"
                Grid.Column="1"
                WidthRequest="180"
                HorizontalOptions="Fill"
                VerticalOptions="Center"
                Minimum="0"
                Maximum="1"
                Value="0.8"
                ThumbColor="DarkGray"
                MinimumTrackColor="#00F000"
                MaximumTrackColor="#8B4513"/>
            <Label Text="White"
             FontSize="8"
             TextColor="#000000"
             VerticalOptions="Center"
             HorizontalOptions="End"
             Grid.Column="2"/>
          </Grid>

      <!-- Centered preview box and OK button -->
          <HorizontalStackLayout Grid.Row="3" Grid.Column="0" HorizontalOptions="Center" Spacing="12">
            <BoxView x:Name="PreviewBox"
               WidthRequest="60"
               HeightRequest="60"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               BackgroundColor="{Binding PreviewColor, Source={x:Reference ColorPickerDialogRoot}}" />
            <Button
                Text="OK"
                TextColor="#000000"
                Clicked="OnOkClicked"
                WidthRequest="80"
                HeightRequest="60"
                HorizontalOptions="Center"
                VerticalOptions="Center"/>
          </HorizontalStackLayout>
        </Grid>
  </ScrollView>
</ContentView>
