<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mcp="clr-namespace:Maui.ColorPicker;assembly=Maui.ColorPicker"
    xmlns:controls="clr-namespace:musicmate.Controls"
    x:Class="musicmate.Controls.ColorPickerDialog"
    x:DataType="controls:ColorPickerDialog"
    x:Name="ColorPickerDialogRoot"
    IsVisible="False"
    BackgroundColor="#80000000"
    HorizontalOptions="Center"
    VerticalOptions="Center">

  <ContentView.Resources>
    <Style TargetType="Picker">
      <Setter Property="TextColor" Value="#000000" />
      <Setter Property="TitleColor" Value="#444444" />
      <Setter Property="BackgroundColor" Value="#FFFFFF" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="BackgroundColor" Value="{DynamicResource ThemeButtonBackground}" />
      <Setter Property="TextColor" Value="{DynamicResource ThemeButtonText}" />
      <!-- Override app Button Padding (14,10) so compact dialog buttons are not clipped -->
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="MinimumHeightRequest" Value="40" />
      <Setter Property="MinimumWidthRequest" Value="40" />
    </Style>
  </ContentView.Resources>

  <ScrollView HorizontalOptions="Center" VerticalOptions="Center">
    
        <Grid x:Name="DialogPanel"
          HorizontalOptions="Center"
          VerticalOptions="Center"
          Padding="24"
          BackgroundColor="White"
          MinimumWidthRequest="1000"
          MaximumWidthRequest="1200"
          MinimumHeightRequest="320"
          MaximumHeightRequest="500">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Label Grid.Row="0" Grid.Column="0"
              Text="Pick a color and set whiteness with slider"
              FontSize="10"
              TextColor="#000000"
              HorizontalOptions="Center"
              Margin="0,0,0,12"/>

          <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,0,0,8">
            <Label Text="Color applies to"
                   FontSize="10"
                   TextColor="#000000"
                   VerticalOptions="Center"
                   Grid.Column="0"/>
            <Picker x:Name="ColorTargetPicker"
                    Title="Item to color"
                    FontSize="12"
                    TextColor="#000000"
                    TitleColor="#444444"
                    BackgroundColor="#FFFFFF"
                    Grid.Column="1"
                    HorizontalOptions="Fill"/>
          </Grid>

          <!-- Row 2: ColorPicker + PreviewBox -->
          <HorizontalStackLayout Grid.Row="2" Grid.Column="0"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="12">
            <mcp:ColorPicker x:Name="ColorPicker"
                             HeightRequest="100"
                             WidthRequest="180"
                             HorizontalOptions="Start"
                             VerticalOptions="Center"/>
            <BoxView x:Name="PreviewBox"
                     WidthRequest="60"
                     HeightRequest="60"
                     HorizontalOptions="Start"
                     VerticalOptions="Center"
                     BackgroundColor="{Binding PreviewColor, Source={x:Reference ColorPickerDialogRoot}, x:DataType=controls:ColorPickerDialog}"/>
          </HorizontalStackLayout>

          <!-- Row 3: Arrow buttons + OK button -->
          <HorizontalStackLayout Grid.Row="3" Grid.Column="0"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 Spacing="8">
            <Button x:Name="UpArrowButton"
                    Text="▲"
                    FontSize="14"
                    Padding="0"
                    WidthRequest="48" HeightRequest="48"
                    Pressed="OnUpArrowPressed"
                    Released="OnArrowReleased"/>
            <Button x:Name="LeftArrowButton"
                    Text="◀"
                    FontSize="14"
                    Padding="0"
                    WidthRequest="48" HeightRequest="48"
                    Pressed="OnLeftArrowPressed"
                    Released="OnArrowReleased"/>
            <Button x:Name="RightArrowButton"
                    Text="▶"
                    FontSize="14"
                    Padding="0"
                    WidthRequest="48" HeightRequest="48"
                    Pressed="OnRightArrowPressed"
                    Released="OnArrowReleased"/>
            <Button x:Name="DownArrowButton"
                    Text="▼"
                    FontSize="14"
                    Padding="0"
                    WidthRequest="48" HeightRequest="48"
                    Pressed="OnDownArrowPressed"
                    Released="OnArrowReleased"/>
            <Button x:Name="OkButton"
                    Text="OK"
                    Clicked="OnOkClicked"
                    MinimumWidthRequest="80"
                    HeightRequest="48"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"/>
            <Button Text="Close"
                    Clicked="OnCloseClicked"
                    MinimumWidthRequest="90"
                    HeightRequest="48"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"/>
          </HorizontalStackLayout>

          <!-- Whiteness slider labels and slider -->
          <Grid Grid.Row="4" Grid.Column="0" Margin="0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Label Text="Color"
             FontSize="8"
             TextColor="#000000"
             VerticalOptions="Center"
             HorizontalOptions="Start"
             Grid.Column="0"/>
            <Slider x:Name="WhitenessSlider"
                Grid.Column="1"
                WidthRequest="180"
                HorizontalOptions="Fill"
                VerticalOptions="Center"
                Minimum="0"
                Maximum="1"
                Value="0.8"
                ThumbColor="DarkGray"
                MinimumTrackColor="#00F000"
                MaximumTrackColor="#8B4513"/>
            <Label Text="White"
             FontSize="8"
             TextColor="#000000"
             VerticalOptions="Center"
             HorizontalOptions="End"
             Grid.Column="2"/>
          </Grid>     
        </Grid>
  </ScrollView>
</ContentView>
