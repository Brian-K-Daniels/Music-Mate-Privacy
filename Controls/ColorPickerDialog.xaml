<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mcp="clr-namespace:Maui.ColorPicker;assembly=Maui.ColorPicker"
    xmlns:controls="clr-namespace:musicmate.Controls"
    x:Class="musicmate.Controls.ColorPickerDialog"
    x:DataType="controls:ColorPickerDialog"
    x:Name="ColorPickerDialogRoot"
    IsVisible="False"
    BackgroundColor="#80000000"
    HorizontalOptions="Fill"
    VerticalOptions="Fill">

  <ContentView.Resources>
    <Style TargetType="Picker">
      <Setter Property="TextColor" Value="#000000" />
      <Setter Property="TitleColor" Value="#444444" />
      <Setter Property="BackgroundColor" Value="#FFFFFF" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="BackgroundColor" Value="{DynamicResource ThemeButtonBackground}" />
      <Setter Property="TextColor" Value="{DynamicResource ThemeButtonText}" />
      <!-- Override app Button Padding (14,10) so dialog buttons are not clipped -->
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="MinimumHeightRequest" Value="48" />
      <Setter Property="MinimumWidthRequest" Value="48" />
      <Setter Property="FontSize" Value="18" />
    </Style>
  </ContentView.Resources>

  <Grid x:Name="DialogHost" HorizontalOptions="Fill" VerticalOptions="Fill">
    <Grid x:Name="DialogPanel"
          HorizontalOptions="Center"
          VerticalOptions="Center"
          Padding="14,10"
          BackgroundColor="White"
          RowDefinitions="Auto,Auto,Auto"
          ColumnDefinitions="*">

      <Label x:Name="TitleLabel"
             Grid.Row="0"
             Text="Pick a color and set whiteness with slider"
             FontSize="22"
             TextColor="#000000"
             HorizontalOptions="Center"
             HorizontalTextAlignment="Center"
             LineBreakMode="NoWrap"
             Margin="0,0,0,8"/>

      <!-- Landscape: the applies-to row and the color-band row sit side by side. -->
      <Grid x:Name="ControlColumns"
            Grid.Row="1"
            ColumnDefinitions="280,*"
            ColumnSpacing="16"
            VerticalOptions="Center">

        <VerticalStackLayout x:Name="AppliesColumn"
                             Grid.Column="0"
                             Spacing="12"
                             VerticalOptions="Center">
          <Label x:Name="AppliesToLabel"
                 Text="Color applies to"
                 FontSize="18"
                 TextColor="#000000"
                 LineBreakMode="NoWrap"
                 HorizontalOptions="Start"/>
          <Picker x:Name="ColorTargetPicker"
                  Title="Item to color"
                  FontSize="18"
                  TextColor="#000000"
                  TitleColor="#444444"
                  BackgroundColor="#FFFFFF"
                  HorizontalOptions="Fill"
                  VerticalOptions="Center"/>
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <Label x:Name="ColorLabel"
                   Text="Color"
                   FontSize="18"
                   TextColor="#000000"
                   VerticalOptions="Center"
                   HorizontalOptions="Start"
                   LineBreakMode="NoWrap"
                   Grid.Column="0"/>
            <Slider x:Name="WhitenessSlider"
                    Grid.Column="1"
                    HorizontalOptions="Fill"
                    VerticalOptions="Center"
                    MinimumHeightRequest="44"
                    Minimum="0"
                    Maximum="1"
                    Value="0.8"
                    ThumbColor="DarkGray"
                    MinimumTrackColor="#00F000"
                    MaximumTrackColor="#8B4513"/>
            <Label x:Name="WhiteLabel"
                   Text="White"
                   FontSize="18"
                   TextColor="#000000"
                   VerticalOptions="Center"
                   HorizontalOptions="End"
                   LineBreakMode="NoWrap"
                   Grid.Column="2"/>
          </Grid>
        </VerticalStackLayout>

        <HorizontalStackLayout x:Name="ColorBandRow"
                               Grid.Column="1"
                               Spacing="12"
                               HorizontalOptions="Fill"
                               VerticalOptions="Center">
          <mcp:ColorPicker x:Name="ColorPicker"
                           HeightRequest="160"
                           WidthRequest="240"
                           HorizontalOptions="Fill"
                           VerticalOptions="Center"/>
          <BoxView x:Name="PreviewBox"
                   WidthRequest="64"
                   HeightRequest="64"
                   HorizontalOptions="End"
                   VerticalOptions="Center"
                   BackgroundColor="{Binding PreviewColor, Source={x:Reference ColorPickerDialogRoot}, x:DataType=controls:ColorPickerDialog}"/>
        </HorizontalStackLayout>
      </Grid>

      <!-- 8dp between arrows. 24dp before OK and before Close (triple the old 8dp gap). -->
      <HorizontalStackLayout x:Name="ButtonRow"
                             Grid.Row="2"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Spacing="0"
                             Margin="0,10,0,0">
        <Button x:Name="UpArrowButton"
                Text="▲"
                FontSize="20"
                Padding="0"
                Margin="0"
                WidthRequest="48" HeightRequest="48"
                Pressed="OnUpArrowPressed"
                Released="OnArrowReleased"/>
        <Button x:Name="LeftArrowButton"
                Text="◀"
                FontSize="20"
                Padding="0"
                Margin="8,0,0,0"
                WidthRequest="48" HeightRequest="48"
                Pressed="OnLeftArrowPressed"
                Released="OnArrowReleased"/>
        <Button x:Name="RightArrowButton"
                Text="▶"
                FontSize="20"
                Padding="0"
                Margin="8,0,0,0"
                WidthRequest="48" HeightRequest="48"
                Pressed="OnRightArrowPressed"
                Released="OnArrowReleased"/>
        <Button x:Name="DownArrowButton"
                Text="▼"
                FontSize="20"
                Padding="0"
                Margin="8,0,0,0"
                WidthRequest="48" HeightRequest="48"
                Pressed="OnDownArrowPressed"
                Released="OnArrowReleased"/>
        <Button x:Name="OkButton"
                Text="OK"
                FontSize="18"
                Clicked="OnOkClicked"
                Margin="24,0,0,0"
                MinimumWidthRequest="88"
                WidthRequest="88"
                HeightRequest="48"
                HorizontalOptions="Center"
                VerticalOptions="Center"/>
        <Button x:Name="CloseButton"
                Text="Close"
                FontSize="18"
                Clicked="OnCloseClicked"
                Margin="24,0,0,0"
                MinimumWidthRequest="108"
                WidthRequest="108"
                HeightRequest="48"
                HorizontalOptions="Center"
                VerticalOptions="Center"/>
      </HorizontalStackLayout>
    </Grid>
  </Grid>
</ContentView>
