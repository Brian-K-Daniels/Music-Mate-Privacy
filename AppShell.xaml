<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="musicmate.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:musicmate.Pages"
    xmlns:pages="clr-namespace:musicmate.Pages"
    x:Name="AppShellInstance"
    Title="MusicMate"
    FlyoutBehavior="Flyout"
    FlyoutWidth="300"
    Shell.BackgroundColor="{DynamicResource ThemePanelBackground}"
    Shell.FlyoutBackgroundColor="{DynamicResource ThemeSecondPanelBackground}"
    Shell.TitleColor="{DynamicResource ThemeContrastingText}"
    Shell.ForegroundColor="{DynamicResource ThemeContrastingText}"
    Shell.UnselectedColor="{DynamicResource ThemeContrastingText}"
    Shell.DisabledColor="{DynamicResource ThemeContrastingText}"
    Shell.NavBarIsVisible="False">

  <Shell.Resources>
    <Style TargetType="Label" Class="FlyoutItemLabelStyle">
      <Setter Property="TextColor" Value="{DynamicResource ThemeContrastingText}" />
    </Style>
    <Style TargetType="Grid" Class="FlyoutItemLayoutStyle" ApplyToDerivedTypes="True">
      <Setter Property="BackgroundColor" Value="{DynamicResource ThemeSecondPanelBackground}" />
    </Style>
  </Shell.Resources>

  <Shell.ItemTemplate>
    <DataTemplate x:DataType="BaseShellItem">
      <Grid
                HeightRequest="48"
                Padding="12,0,0,0"
                ColumnDefinitions="40,*">

        <Image
                    Source="{Binding FlyoutIcon}"
                    HeightRequest="24"
                    WidthRequest="24"
                    VerticalOptions="Center" />

        <Label
                    Grid.Column="1"
                    Text="{Binding Title}"
                    FontSize="16"
                    TextColor="{DynamicResource ThemeContrastingText}"
                    VerticalTextAlignment="Center" />
      </Grid>
    </DataTemplate>
  </Shell.ItemTemplate>

  <!-- Home is first so the app starts here without any navigation flash. -->
  <FlyoutItem Title="Home" Route="Home">
    <ShellContent
        Title="Home"
        Route="HomePage"
        ContentTemplate="{DataTemplate local:HomePage}" />
  </FlyoutItem>

  <FlyoutItem Title="About" Route="About">
    <ShellContent
       Route="AboutPage"
       ContentTemplate="{DataTemplate local:AboutPage}" />
  </FlyoutItem>

  <FlyoutItem Title="What to Play" Route="WhatToPlay">
    <ShellContent
        Route="WhatToPlayPage"
        ContentTemplate="{DataTemplate local:WhatToPlayPage}" />
  </FlyoutItem>

  <FlyoutItem Title="Music" Route="Music">
    <ShellContent
        Route="MusicPage"
        ContentTemplate="{DataTemplate local:MusicPage}" />
  </FlyoutItem>

  <FlyoutItem Title="Interval Ear Training" Route="EarTraining">
    <ShellContent
        Title="Interval Ear Training"
        Route="IntervalEarTrainingPage"
        ContentTemplate="{DataTemplate local:IntervalEarTrainingPage}" />
  </FlyoutItem>

  <FlyoutItem Title="My Progress" Route="Statistics">
    <ShellContent
        Route="StatisticsPages"
        ContentTemplate="{DataTemplate local:StatisticsPages}" />
  </FlyoutItem>

  
  <FlyoutItem Title="Settings" Route="Settings">
    <ShellContent
        Route="SettingsPage"
        ContentTemplate="{DataTemplate local:SettingsPage}" />
  </FlyoutItem>

  <FlyoutItem Title="Settings Advanced" Route="SettingsAdvanced">
    <ShellContent
      Route="AdvancedPage"
      ContentTemplate="{DataTemplate local:AdvancedPage}" />
  </FlyoutItem>


  <FlyoutItem Title="Reset and Options" Route="SettingsReset">
    <ShellContent
      Route="ResetOptionsPage"
      ContentTemplate="{DataTemplate local:ResetOptionsPage}" />
  </FlyoutItem>

  <!-- Same FlyoutItem pattern as other menu rows; page redirects into Music Tuner. -->
  <FlyoutItem Title="Tuner" Route="TunerEntry">
    <ShellContent
        Title="Tuner"
        Route="TunerEntryPage"
        ContentTemplate="{DataTemplate local:TunerMenuPage}" />
  </FlyoutItem>

</Shell>
