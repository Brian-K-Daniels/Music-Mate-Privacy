<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="musicmate.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:musicmate.Pages"
    xmlns:pages="clr-namespace:musicmate.Pages"
    x:Name="AppShellInstance"
    Title="MusicMate"
    FlyoutBehavior="Flyout"
    FlyoutWidth="240"
    Shell.BackgroundColor="Transparent"
    Shell.FlyoutBackgroundColor="#1A1A1A"
    Shell.TitleColor="White"
    Shell.ForegroundColor="White"
    Shell.UnselectedColor="White"
    Shell.DisabledColor="#888888"
    Shell.NavBarIsVisible="False">

  <Shell.Resources>
    <Style TargetType="Label" Class="FlyoutItemLabelStyle">
      <Setter Property="TextColor" Value="White" />
    </Style>
    <Style TargetType="Grid" Class="FlyoutItemLayoutStyle" ApplyToDerivedTypes="True">
      <Setter Property="BackgroundColor" Value="#1A1A1A" />
    </Style>
  </Shell.Resources>

  <!-- Simple child-friendly Home page: instrument, level, and Start button -->
  <FlyoutItem Title="Home"> <!-- This is an item on the flyout menu that appears when you touch the hamburger-->
    <ShellContent
        Route="HomePage"
        ContentTemplate="{DataTemplate local:HomePage}" />
  </FlyoutItem>

  <FlyoutItem Title="What to Play">
    <ShellContent
        Route="WhatToPlayPage"
        ContentTemplate="{DataTemplate local:WhatToPlayPage}" />
  </FlyoutItem>

  <FlyoutItem Title="Music">
    <ShellContent
        Route="MusicPage"
        ContentTemplate="{DataTemplate local:MusicPage}" />
  </FlyoutItem>

  <FlyoutItem Title="Settings" >
    <ShellContent
        Route="SettingsPage"
        ContentTemplate="{DataTemplate local:SettingsPage}" />
  </FlyoutItem>

  <FlyoutItem Title="Statistics" >
    <ShellContent
        Route="StatisticsPages"
        ContentTemplate="{DataTemplate local:StatisticsPages}" />
  </FlyoutItem>

  <FlyoutItem Title="Advanced">
    <ShellContent
        Route="AdvancedPage"
        ContentTemplate="{DataTemplate local:AdvancedPage}" />
  </FlyoutItem>

  <FlyoutItem Title="About" >
    <ShellContent
        Route="AboutPage"
        ContentTemplate="{DataTemplate local:AboutPage}" />
  </FlyoutItem>


</Shell>
