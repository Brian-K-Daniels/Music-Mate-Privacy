<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="musicmate.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:musicmate.Pages"
    xmlns:pages="clr-namespace:musicmate.Pages"
    x:Name="AppShellInstance"
    Title="MusicMate"
    FlyoutBehavior="Flyout"
    FlyoutWidth="300"
    Shell.BackgroundColor="Transparent"
    Shell.FlyoutBackgroundColor="#1A1A1A"
    Shell.TitleColor="White"
    Shell.ForegroundColor="White"
    Shell.UnselectedColor="White"
    Shell.DisabledColor="#888888"
    Shell.NavBarIsVisible="False">

  <Shell.Resources>
    <Style TargetType="Label" Class="FlyoutItemLabelStyle">
      <Setter Property="TextColor" Value="White" />
    </Style>
    <Style TargetType="Grid" Class="FlyoutItemLayoutStyle" ApplyToDerivedTypes="True">
      <Setter Property="BackgroundColor" Value="#1A1A1A" />
    </Style>
  </Shell.Resources>

  <Shell.ItemTemplate>
    <DataTemplate>
      <Grid
                HeightRequest="48"
                Padding="12,0,0,0"
                ColumnDefinitions="40,*">

        <Image
                    Source="{Binding FlyoutIcon}"
                    HeightRequest="24"
                    WidthRequest="24"
                    VerticalOptions="Center" />

        <Label
                    Grid.Column="1"
                    Text="{Binding Title}"
                    FontSize="16"
                    TextColor="BlanchedAlmond"
                    VerticalTextAlignment="Center" />
      </Grid>
    </DataTemplate>
  </Shell.ItemTemplate>

  <!-- Home is first so the app starts here without any navigation flash. -->
  <FlyoutItem Title="Home" Route="Home">
    <ShellContent
        Title="Home"
        Route="HomePage"
        ContentTemplate="{DataTemplate local:HomePage}" />
  </FlyoutItem>

  <FlyoutItem Title="About" Route="About">
    <ShellContent
       Route="AboutPage"
       ContentTemplate="{DataTemplate local:AboutPage}" />
  </FlyoutItem>

  <FlyoutItem Title="Item to Play" Route="WhatToPlay">
    <ShellContent
        Route="WhatToPlayPage"
        ContentTemplate="{DataTemplate local:WhatToPlayPage}" />
  </FlyoutItem>

  <FlyoutItem Title="Music" Route="Music">
    <ShellContent
        Route="MusicPage"
        ContentTemplate="{DataTemplate local:MusicPage}" />
  </FlyoutItem>

  <FlyoutItem Title="Settings" Route="Settings">
    <ShellContent
        Route="SettingsPage"
        ContentTemplate="{DataTemplate local:SettingsPage}" />
  </FlyoutItem>

  <FlyoutItem Title="Settings Advanced" Route="SettingsAdvanced">
    <ShellContent
      Route="AdvancedPage"
      ContentTemplate="{DataTemplate local:AdvancedPage}" />
  </FlyoutItem>

  <FlyoutItem Title="Settings Reset Options" Route="SettingsReset">
    <ShellContent
      Route="ResetOptionsPage"
      ContentTemplate="{DataTemplate local:ResetOptionsPage}" />
  </FlyoutItem>

  <FlyoutItem Title="Statistics" Route="Statistics">
    <ShellContent
        Route="StatisticsPages"
        ContentTemplate="{DataTemplate local:StatisticsPages}" />
  </FlyoutItem>

</Shell>
